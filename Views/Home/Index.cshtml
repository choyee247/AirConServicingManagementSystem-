                        </div>

                        <p class="stat-label">
                            Service Areas
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- =========================================================
     FEATURES
========================================================= -->

<section class="features-section" id="services">

    <div class="container">

        <div class="section-header animate-on-scroll delay-1">

            <h2>
                Our Services
            </h2>

            <div class="divider"></div>

            <p class="text-muted mt-2">

                Comprehensive air conditioning solutions
                for your DIS operations

            </p>

        </div>


        <div class="row g-3 g-md-4">


            <!-- REPAIR -->

            <div class="col-6 col-md-3 animate-on-scroll delay-2">

                <div class="feature-card">

                    <span class="feature-icon">

                        <i class="fas fa-wrench"></i>

                    </span>

                    <h5>
                        Repair
                    </h5>

                    <p>
                        Fast &amp; reliable AC repair
                    </p>

                </div>

            </div>


            <!-- MAINTENANCE -->

            <div class="col-6 col-md-3 animate-on-scroll delay-3">

                <div class="feature-card">

                    <span class="feature-icon">

                        <i class="fas fa-tools"></i>

                    </span>

                    <h5>
                        Maintenance
                    </h5>

                    <p>
                        Preventive &amp; routine care
                    </p>

                </div>

            </div>


            <!-- INSTALLATION -->

            <div class="col-6 col-md-3 animate-on-scroll delay-4">

