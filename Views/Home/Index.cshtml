@{
    ViewData["Title"] = "AirConServ - Dashboard";
    Layout = "_Layout";
}

<!-- Font Awesome & Animate.css -->

@* <link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"> *@

<link rel="stylesheet"
      href="~/fontawesome/css/all.min650.css">

@* <link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" /> *@

<link rel="stylesheet"
      href="~/fontawesome/css/animate.min.css" />

<style>

    :root {
        --primary-color: #2c8c99;
        --secondary-color: #4a6572;
        --accent-color: #ff7e5f;
        --light-color: #f0f7f9;
        --dark-color: #1a535c;
        --success-color: #28a745;
        --warning-color: #ffc107;
        --info-color: #17a2b8;
        --purple: #6f42c1;
        --text-dark: #1a2a3a;
        --text-muted: #6c7a8a;
    }


    /* =========================================================
           GLOBAL
        ========================================================= */

    html {
        scroll-behavior: smooth;
    }

    body {
        overflow-x: hidden;
        margin: 0;
    }

    img {
        max-width: 100%;
    }

    .text-white-75 {
        color: rgba(255, 255, 255, 0.75);
    }


    /* =========================================================
           HERO
        ========================================================= */

    .hero-section {
        position: relative;
        overflow: hidden;
    }

    .bg-gradient-primary {
        background: linear-gradient( 135deg, var(--primary-color) 0%, var(--dark-color) 100% );
        position: relative;
        overflow: hidden;
    }

        .bg-gradient-primary::before {
            content: "";
            position: absolute;
            top: -40%;
            right: -10%;
            width: 500px;
            height: 500px;
            background: rgba(255, 255, 255, 0.04);
            border-radius: 50%;
            animation: floatShape 12s ease-in-out infinite alternate;
        }

        .bg-gradient-primary::after {
            content: "";
            position: absolute;
            bottom: -30%;
            left: -5%;
            width: 400px;
            height: 400px;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 50%;
            animation: floatShape 14s ease-in-out infinite alternate-reverse;
        }

    @@keyframes floatShape {

        0% {
            transform: translate(0, 0) scale(1);
        }

        100% {
            transform: translate(40px, -30px) scale(1.1);
        }
    }

    .min-vh-80 {
        min-height: 80vh;
    }


    /* =========================================================
           HERO CONTENT
        ========================================================= */

    .hero-content {
        position: relative;
        z-index: 2;
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        background: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(5px);
    }

    .hero-title {
        font-size: clamp(2rem, 4vw, 3.5rem);
        line-height: 1.15;
        font-weight: 800;
    }

        .hero-title .highlight {
            color: #58e9f3;
        }

    .hero-description {
        max-width: 620px;
        font-size: 1.05rem;
        line-height: 1.7;
    }


    /* =========================================================
           HERO BUTTONS
        ========================================================= */

    .hero-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
    }

    .btn-primary {
        background-color: var(--primary-color);
        border-color: var(--primary-color);
        color: white;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

        .btn-primary:hover {
            background-color: var(--dark-color);
            border-color: var(--dark-color);
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(44, 140, 153, 0.35);
            color: white;
        }

    .btn-outline-light {
        transition: all 0.3s ease;
    }

        .btn-outline-light:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(255, 255, 255, 0.15);
            background: rgba(255, 255, 255, 0.10);
        }


    /* =========================================================
           HERO IMAGE
        ========================================================= */

    .hero-image-wrapper {
        position: relative;
        perspective: 1000px;
    }

        .hero-image-wrapper img {
            width: 100%;
            height: 420px;
            object-fit: cover;
            display: block;
            border-radius: 20px;
            transition: transform 0.6s ease, box-shadow 0.6s ease;
            transform: rotateY(-2deg) rotateX(2deg);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
        }

            .hero-image-wrapper img:hover {
                transform: rotateY(0deg) rotateX(0deg) scale(1.01);
                box-shadow: 0 30px 60px rgba(0, 0, 0, 0.30);
            }


    /* =========================================================
           FLOATING BADGE
        ========================================================= */

    .floating-badge {
        animation: floatBadge 3s ease-in-out infinite;
        border-radius: 12px 0 12px 12px;
        backdrop-filter: blur(6px);
        background: rgba(44, 140, 153, 0.92);
        border: 1px solid rgba(255, 255, 255, 0.15);
        max-width: calc(100% - 30px);
    }

    @@keyframes floatBadge {

        0%,
        100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-8px);
        }
    }


    /* =========================================================
           CTA GLOW
        ========================================================= */

    .btn-glow {
        animation: glowPulse 2.5s ease-in-out infinite;
    }

    @@keyframes glowPulse {

        0%,
        100% {
            box-shadow: 0 0 0 0 rgba(44, 140, 153, 0.3);
        }

        50% {
            box-shadow: 0 0 30px 6px rgba(44, 140, 153, 0.15);
        }
    }


    /* =========================================================
           STATS
        ========================================================= */

    .stat-card {
        border: none;
        border-radius: 20px;
        background: white;
        transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.4s ease;
        position: relative;
        overflow: hidden;
        cursor: default;
    }

        .stat-card::after {
            content: "";
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: var(--primary-color);
            transform: scaleX(0);
            transition: transform 0.5s ease;
            transform-origin: left;
        }

        .stat-card:hover::after {
            transform: scaleX(1);
        }

        .stat-card:hover {
            transform: translateY(-10px) scale(1.01);
            box-shadow: 0 20px 40px rgba(44, 140, 153, 0.12) !important;
        }

    .stat-icon {
        width: 70px;
        height: 70px;
        transition: all 0.4s ease;
    }

    .stat-card:hover .stat-icon {
        transform: scale(1.08) rotate(2deg);
        box-shadow: 0 8px 20px rgba(44, 140, 153, 0.15);
    }

    .stat-number {
        font-size: 2.4rem;
        font-weight: 800;
        letter-spacing: -0.5px;
        background: linear-gradient( 135deg, var(--dark-color), var(--primary-color) );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .stat-label {
        color: var(--text-muted);
        font-weight: 500;
        font-size: 0.9rem;
        letter-spacing: 0.3px;
        margin-bottom: 0;
    }


    /* =========================================================
           FEATURES
        ========================================================= */

    .features-section {
        padding: 70px 0 60px;
        background: linear-gradient( 180deg, #f8fbfc 0%, #eef5f7 100% );
        position: relative;
    }

    .section-header {
        text-align: center;
        margin-bottom: 40px;
    }

        .section-header h2 {
            font-size: 2rem;
            font-weight: 800;
            color: var(--text-dark);
            letter-spacing: -0.5px;
        }

    .divider {
        width: 56px;
        height: 4px;
        background: linear-gradient( 90deg, var(--primary-color), var(--accent-color) );
        border-radius: 4px;
        margin: 12px auto 0;
    }

    .feature-card {
        background: white;
        border-radius: 20px;
        padding: 30px 16px;
        text-align: center;
        border: 1px solid rgba(44, 140, 153, 0.06);
        transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.4s ease;
        height: 100%;
        box-shadow: 0 4px 16px rgba(44, 140, 153, 0.04);
        position: relative;
        overflow: hidden;
    }

        .feature-card::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient( 135deg, rgba(44, 140, 153, 0.04), rgba(255, 126, 95, 0.02) );
            opacity: 0;
            transition: opacity 0.5s ease;
        }

        .feature-card:hover::before {
            opacity: 1;
        }

        .feature-card:hover {
            transform: translateY(-8px) scale(1.02);
            box-shadow: 0 16px 40px rgba(44, 140, 153, 0.10);
            border-color: rgba(44, 140, 153, 0.12);
        }

    .feature-icon {
        font-size: 2.6rem;
        color: var(--primary-color);
        display: block;
        margin-bottom: 12px;
        transition: all 0.4s ease;
        position: relative;
        z-index: 1;
    }

    .feature-card:hover .feature-icon {
        transform: scale(1.12) rotate(-4deg);
        color: var(--accent-color);
    }

    .feature-card h5 {
        font-size: 1rem;
        font-weight: 700;
        color: var(--text-dark);
        margin-bottom: 5px;
        position: relative;
        z-index: 1;
    }

    .feature-card p {
        font-size: 0.82rem;
        color: var(--text-muted);
        margin-bottom: 0;
        font-weight: 400;
        position: relative;
        z-index: 1;
    }


    /* =========================================================
           SCROLL ANIMATION
        ========================================================= */

    .animate-on-scroll {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.8s ease, transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    }

        .animate-on-scroll.visible {
            opacity: 1;
            transform: translateY(0);
        }

    .delay-1 {
        transition-delay: 0.05s;
    }

    .delay-2 {
        transition-delay: 0.10s;
    }

    .delay-3 {
        transition-delay: 0.15s;
    }

    .delay-4 {
        transition-delay: 0.20s;
    }

    .delay-5 {
        transition-delay: 0.25s;
    }


    /* =========================================================
           TABLET
        ========================================================= */

    @@media (max-width: 991.98px) {

        .min-vh-80 {
            min-height: auto;
            padding-top: 70px;
            padding-bottom: 70px;
        }

        .hero-title {
            font-size: 2.7rem;
        }

        .hero-description {
            font-size: 1rem;
        }

        .hero-image-wrapper img {
            height: 350px;
        }

        .floating-badge {
            margin: 15px !important;
        }

        .stat-number {
            font-size: 2rem;
        }

        .features-section {
            padding: 55px 0 50px;
        }
    }


    /* =========================================================
           MOBILE
        ========================================================= */

    @@media (max-width: 767.98px) {
        /* HERO */

        .min-vh-80 {
            min-height: auto;
            padding-top: 45px;
            padding-bottom: 50px;
        }

        .hero-section .container {
            padding-left: 18px;
            padding-right: 18px;
        }

        .hero-content {
            text-align: center;
        }

        .hero-badge {
            font-size: 0.78rem;
            padding: 8px 13px !important;
            margin-bottom: 18px !important;
        }

        .hero-title {
            font-size: 2.05rem;
            line-height: 1.2;
            margin-bottom: 18px !important;
        }

        .hero-description {
            font-size: 0.92rem;
            line-height: 1.65;
            margin-left: auto;
            margin-right: auto;
            margin-bottom: 25px !important;
        }
        /* BUTTONS */

        .hero-buttons {
            width: 100%;
            flex-direction: column;
            gap: 10px;
        }

            .hero-buttons .btn {
                width: 100%;
                padding: 12px 18px !important;
                font-size: 0.95rem;
            }
        /* IMAGE */

        .hero-image-wrapper {
            margin-top: 25px;
        }

            .hero-image-wrapper img {
                height: 240px;
                border-radius: 16px;
                transform: none;
                box-shadow: 0 15px 30px rgba(0, 0, 0, 0.20);
            }

                .hero-image-wrapper img:hover {
                    transform: none;
                }
        /* BADGE */

        .floating-badge {
            position: absolute !important;
            bottom: 10px !important;
            left: 10px !important;
            margin: 0 !important;
            padding: 9px 12px !important;
            border-radius: 10px !important;
            max-width: calc(100% - 20px);
        }

            .floating-badge i.fa-2x {
                font-size: 1.5rem;
            }

            .floating-badge h5 {
                font-size: 0.85rem;
            }

            .floating-badge small {
                font-size: 0.68rem;
            }
        /* STATS */

        .py-5 {
            padding-top: 35px !important;
            padding-bottom: 35px !important;
        }

        .stat-card {
            border-radius: 15px;
            padding: 10px !important;
        }

            .stat-card .card-body {
                padding: 12px 5px;
            }

        .stat-icon {
            width: 52px !important;
            height: 52px !important;
            margin-bottom: 10px !important;
        }

            .stat-icon i {
                font-size: 1.25rem;
            }

        .stat-number {
            font-size: 1.55rem;
            letter-spacing: -0.3px;
        }

        .stat-label {
            font-size: 0.72rem;
            line-height: 1.3;
            margin-top: 3px;
        }
        /* FEATURES */

        .features-section {
            padding: 45px 0 40px;
        }

        .section-header {
            margin-bottom: 25px;
        }

            .section-header h2 {
                font-size: 1.65rem;
            }

            .section-header p {
                font-size: 0.85rem;
                padding: 0 15px;
                line-height: 1.5;
            }

        .divider {
            width: 45px;
            height: 3px;
        }

        .feature-card {
            border-radius: 15px;
            padding: 22px 10px;
        }

        .feature-icon {
            font-size: 2rem;
            margin-bottom: 9px;
        }

        .feature-card h5 {
            font-size: 0.9rem;
        }

        .feature-card p {
            font-size: 0.72rem;
            line-height: 1.35;
        }
        /* Disable heavy hover effect on touch devices */

        .stat-card:hover,
        .feature-card:hover {
            transform: none;
        }
    }


    /* =========================================================
           SMALL MOBILE
           360px / 375px
        ========================================================= */

    @@media (max-width: 390px) {

        .hero-title {
            font-size: 1.8rem;
        }

        .hero-description {
            font-size: 0.86rem;
        }

        .hero-image-wrapper img {
            height: 210px;
        }

        .floating-badge {
            padding: 7px 9px !important;
        }

            .floating-badge h5 {
                font-size: 0.75rem;
            }

            .floating-badge small {
                font-size: 0.62rem;
            }

        .stat-card {
            padding: 7px !important;
        }

        .stat-icon {
            width: 46px !important;
            height: 46px !important;
        }

        .stat-number {
            font-size: 1.35rem;
        }

        .stat-label {
            font-size: 0.66rem;
        }

        .feature-card {
            padding: 18px 7px;
        }

        .feature-icon {
            font-size: 1.75rem;
        }

        .feature-card h5 {
            font-size: 0.82rem;
        }

        .feature-card p {
            font-size: 0.65rem;
        }
    }


    /* =========================================================
           VERY SMALL DEVICES
        ========================================================= */

    @@media (max-width: 340px) {

        .hero-title {
            font-size: 1.65rem;
        }

        .hero-image-wrapper img {
            height: 190px;
        }

        .stat-number {
            font-size: 1.2rem;
        }

        .stat-label {
            font-size: 0.6rem;
        }
    }


    /* =========================================================
           REDUCE MOTION
        ========================================================= */

    @@media (prefers-reduced-motion: reduce) {

        *,
        *::before,
        *::after {
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: 0.01ms !important;
            scroll-behavior: auto !important;
        }

        .animate-on-scroll {
            opacity: 1;
            transform: none;
        }
    }

</style>

<!-- =========================================================
     HERO
========================================================= -->

<section class="hero-section bg-gradient-primary">

    <div class="container position-relative" style="z-index: 2;">

        <div class="row align-items-center min-vh-80">

            <!-- LEFT -->
