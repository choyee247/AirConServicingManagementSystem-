@{
    ViewData["Title"] = "AirConServ - Dashboard";
    Layout = "_Layout";
}

<!-- Font Awesome & Animate.css -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<style>
    :root {
        --primary-color: #2c8c99;
        --secondary-color: #4a6572;
        --accent-color: #ff7e5f;
        --light-color: #f0f7f9;
        --dark-color: #1a535c;
        --success-color: #28a745;
        --warning-color: #ffc107;
        --info-color: #17a2b8;
        --purple: #6f42c1;
        --text-dark: #1a2a3a;
        --text-muted: #6c7a8a;
    }

    /* ===== GLOBAL ===== */
    body {
        overflow-x: hidden;
    }
    .text-warning{
        color: #07eaff;
    }
    .bg-gradient-primary {
        background: linear-gradient(135deg, var(--primary-color) 0%, var(--dark-color) 100%);
        position: relative;
        overflow: hidden;
    }

        /* Animated background shapes */
        .bg-gradient-primary::before {
            content: '';
            position: absolute;
            top: -40%;
            right: -10%;
            width: 500px;
            height: 500px;
            background: rgba(255, 255, 255, 0.04);
            border-radius: 50%;
            animation: floatShape 12s ease-in-out infinite alternate;
        }

        .bg-gradient-primary::after {
            content: '';
            position: absolute;
            bottom: -30%;
            left: -5%;
            width: 400px;
            height: 400px;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 50%;
            animation: floatShape 14s ease-in-out infinite alternate-reverse;
        }

    @@keyframes floatShape {
        0%

    {
        transform: translate(0, 0) scale(1);
    }

    100% {
        transform: translate(40px, -30px) scale(1.1);
    }

    }

    .min-vh-80 {
        min-height: 80vh;
    }

    /* ===== HERO IMAGE ===== */
    .hero-image-wrapper {
        perspective: 1000px;
    }

        .hero-image-wrapper img {
            transition: transform 0.6s ease, box-shadow 0.6s ease;
            transform: rotateY(-2deg) rotateX(2deg);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
        }

            .hero-image-wrapper img:hover {
                transform: rotateY(0deg) rotateX(0deg) scale(1.01);
                box-shadow: 0 30px 60px rgba(0, 0, 0, 0.30);
            }

    /* Floating badge */
    .floating-badge {
        animation: floatBadge 3s ease-in-out infinite;
        border-radius: 12px 0 12px 12px;
        backdrop-filter: blur(4px);
        background: rgba(44, 140, 153, 0.92);
        border: 1px solid rgba(255, 255, 255, 0.15);
    }

    @@keyframes floatBadge {
        0%, 100%

    {
        transform: translateY(0px);
    }

    50% {
        transform: translateY(-8px);
    }

    }

    /* ===== BUTTONS ===== */
    .btn-primary {
        background-color: var(--primary-color);
        border-color: var(--primary-color);
        color: white;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

        .btn-primary:hover {
            background-color: var(--dark-color);
            border-color: var(--dark-color);
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(44, 140, 153, 0.35);
            color: white;
        }

    .btn-outline-light {
        transition: all 0.3s ease;
    }

        .btn-outline-light:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(255, 255, 255, 0.15);
            background: rgba(255, 255, 255, 0.10);
        }

    /* ===== STATS CARDS ===== */
    .stat-card {
        border: none;
        border-radius: 20px;
        background: white;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        position: relative;
        overflow: hidden;
        cursor: default;
    }

        .stat-card::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: var(--primary-color);
            transform: scaleX(0);
            transition: transform 0.5s ease;
            transform-origin: left;
        }

        .stat-card:hover::after {
            transform: scaleX(1);
        }

        .stat-card:hover {
            transform: translateY(-10px) scale(1.01);
            box-shadow: 0 20px 40px rgba(44, 140, 153, 0.12) !important;
        }

    .stat-icon {
        width: 70px;
        height: 70px;
        transition: all 0.4s ease;
    }

    .stat-card:hover .stat-icon {
        transform: scale(1.08) rotate(2deg);
        box-shadow: 0 8px 20px rgba(44, 140, 153, 0.15);
    }

    .stat-number {
        font-size: 2.4rem;
        font-weight: 800;
        letter-spacing: -0.5px;
        background: linear-gradient(135deg, var(--dark-color), var(--primary-color));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .stat-label {
        color: var(--text-muted);
        font-weight: 500;
        font-size: 0.9rem;
        letter-spacing: 0.3px;
    }

    /* ===== FEATURES ===== */
    .features-section {
        padding: 50px 0 40px;
        background: linear-gradient(180deg, #f8fbfc 0%, #eef5f7 100%);
        position: relative;
    }

    .section-header h2 {
        font-size: 2rem;
        font-weight: 800;
        color: var(--text-dark);
        letter-spacing: -0.5px;
    }

    .divider {
        width: 56px;
        height: 4px;
        background: linear-gradient(90deg, var(--primary-color), var(--accent-color));
        border-radius: 4px;
        margin: 12px auto 0;
    }

    .feature-card {
        background: white;
        border-radius: 20px;
        padding: 28px 16px;
        text-align: center;
        border: 1px solid rgba(44, 140, 153, 0.06);
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        height: 100%;
        box-shadow: 0 4px 16px rgba(44, 140, 153, 0.04);
        position: relative;
        overflow: hidden;
    }

        .feature-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, rgba(44, 140, 153, 0.04), rgba(255, 126, 95, 0.02));
            opacity: 0;
            transition: opacity 0.5s ease;
        }

        .feature-card:hover::before {
            opacity: 1;
        }

        .feature-card:hover {
            transform: translateY(-8px) scale(1.02);
            box-shadow: 0 16px 40px rgba(44, 140, 153, 0.10);
            border-color: rgba(44, 140, 153, 0.12);
        }

    .feature-icon {
        font-size: 2.6rem;
        color: var(--primary-color);
        display: block;
        margin-bottom: 12px;
        transition: all 0.4s ease;
    }

    .feature-card:hover .feature-icon {
        transform: scale(1.12) rotate(-4deg);
        color: var(--accent-color);
    }

    .feature-card h5 {
        font-size: 1rem;
        font-weight: 700;
        color: var(--text-dark);
        margin-bottom: 2px;
        letter-spacing: -0.2px;
    }

    .feature-card p {
        font-size: 0.82rem;
        color: var(--text-muted);
        margin-bottom: 0;
        font-weight: 400;
    }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 768px) {
        .min-vh-80 {
            min-height: auto;
            padding: 40px 0;
        }

        .stat-number {
            font-size: 1.8rem;
        }

        .feature-card {
            padding: 20px 12px;
        }

        .feature-icon {
            font-size: 2rem;
        }

        .floating-badge {
            display: none;
        }
    }

    /* ===== SCROLL ANIMATIONS (AOS style) ===== */
    .animate-on-scroll {
        opacity: 0;
        transform: translateY(30px);
        transition: all 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    }

        .animate-on-scroll.visible {
            opacity: 1;
            transform: translateY(0);
        }

    /* staggered delay */
    .delay-1 {
        transition-delay: 0.05s;
    }

    .delay-2 {
        transition-delay: 0.10s;
    }

    .delay-3 {
        transition-delay: 0.15s;
    }

    .delay-4 {
        transition-delay: 0.20s;
    }

    .delay-5 {
        transition-delay: 0.25s;
    }

    .delay-6 {
        transition-delay: 0.30s;
    }

    .delay-7 {
        transition-delay: 0.35s;
    }

    .delay-8 {
        transition-delay: 0.40s;
    }

    /* ===== CTA BUTTON GLOW ===== */
    .btn-glow {
        animation: glowPulse 2.5s ease-in-out infinite;
    }

    @@keyframes glowPulse {
        0%,
        100% {
            box-shadow: 0 0 0 0 rgba(44, 140, 153, 0.3);
        }

        50% {
            box-shadow: 0 0 30px 6px rgba(44, 140, 153, 0.15);
        }
    }

    .text-white-75 {
        color: rgba(255, 255, 255, 0.75);
    }
</style>

