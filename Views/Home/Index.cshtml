        <div class="row g-3 g-md-4">

            <!-- STAT 1 -->

            <div class="col-6 col-md-3 animate-on-scroll delay-1">

                <div class="card stat-card shadow-sm h-100 p-3 text-center">

                    <div class="card-body">

                        <div class="stat-icon rounded-circle
                                d-inline-flex
                                align-items-center
                                justify-content-center
                                mb-3"
                             style="
                             background: rgba(44,140,153,0.08);
                         ">

                            <i class="fas fa-calendar-check fa-2x text-primary"></i>

                        </div>


                        <div class="stat-number">
                            1,250+
                        </div>

                        <p class="stat-label">
                            Monthly Services
                        </p>

                    </div>

                </div>

            </div>


            <!-- STAT 2 -->

            <div class="col-6 col-md-3 animate-on-scroll delay-2">

                <div class="card stat-card shadow-sm h-100 p-3 text-center">

                    <div class="card-body">

                        <div class="stat-icon rounded-circle
                                d-inline-flex
                                align-items-center
                                justify-content-center
                                mb-3"
                             style="
                             background: rgba(40,167,69,0.08);
                         ">

                            <i class="fas fa-user-tie fa-2x text-success"></i>

                        </div>


                        <div class="stat-number">
                            45+
                        </div>

                        <p class="stat-label">
                            Certified Technicians
                        </p>

                    </div>

                </div>

            </div>


            <!-- STAT 3 -->

            <div class="col-6 col-md-3 animate-on-scroll delay-3">

                <div class="card stat-card shadow-sm h-100 p-3 text-center">

                    <div class="card-body">

                        <div class="stat-icon rounded-circle
                                d-inline-flex
                                align-items-center
                                justify-content-center
                                mb-3"
                             style="
                             background: rgba(255,193,7,0.08);
                         ">

                            <i class="fas fa-users fa-2x text-warning"></i>

                        </div>


