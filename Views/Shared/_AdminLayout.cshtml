@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    var adminName = Context.Session.GetString("AdminUsername");
    var adminRole = Context.Session.GetString("AdminRole");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - AirCon Admin</title>

    <link rel="stylesheet" href="~/bootstrap/bootstrap.min532.css" />
    <link rel="stylesheet" href="~/fontawesome/css/all.min651.css" />

    <style>

        :root {
            --primary: #2c8c99;
            --dark: #1f6b75;
            --light-bg: #f4f7fb;
            --sidebar-width: 260px;
            --sidebar-collapsed: 75px;
            --header-height: 70px;
            --transition: .3s ease;
        }

        body {
            margin: 0;
            font-family: 'Segoe UI';
            background: var(--light-bg);
            overflow-x: hidden;
        }

        /* ================= SIDEBAR ================= */
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: 260px;
            height: 100vh;
            background: linear-gradient(180deg, #2c8c99, #1f6b75);
            transform: translateX(0);
            transition: 0.3s ease;
            z-index: 2000;
        }

            .sidebar.collapsed {
                width: var(--sidebar-collapsed);
            }

        .sidebar-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px;
            border-bottom: 1px solid rgba(255,255,255,.15);
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #fff;
            font-weight: bold;
        }

        .sidebar.collapsed .logo span {
            display: none;
        }

        .toggle-btn {
            background: rgba(255,255,255,.15);
            border: none;
            color: #fff;
            width: 35px;
            height: 35px;
            border-radius: 6px;
        }

        /* ================= MENU ================= */
        .nav-menu {
            list-style: none;
            padding: 10px;
            margin: 0;
        }

            .nav-menu a {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 14px;
                color: rgba(255,255,255,.9);
                text-decoration: none;
                border-radius: 10px;
            }

                .nav-menu a:hover {
                    background: rgba(255,255,255,.18);
                }

        .sidebar.collapsed .nav-text {
            display: none;
        }

        /* ================= SUBMENU ================= */
        .has-submenu .submenu {
            display: none;
            flex-direction: column;
            padding-left: 15px;
        }

        .has-submenu.open .submenu {
            display: flex;
        }

        .submenu {
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .submenu a {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 10px 14px;
                color: rgba(255,255,255,.85);
                border-radius: 8px;
            }

                .submenu a i {
                    width: 18px;
                    text-align: center;
                }

        .submenu-icon {
            margin-left: auto;
            transition: .3s;
        }

        .has-submenu.open .submenu-icon {
            transform: rotate(180deg);
        }

        /* ================= MAIN ================= */
        .main {
            margin-left: var(--sidebar-width);
            transition: var(--transition);
        }

        .sidebar.collapsed ~ .main {
            margin-left: var(--sidebar-collapsed);
        }

        /* ================= HEADER ================= */
        .header {
            /* height: var(--header-height); */
            background: #fff;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 18px;
            border-bottom: 1px solid #eee;
            position: sticky;
            top: 0;
            z-index: 999;
           /*  flex-wrap: wrap; */
            gap: 10px;
        }

            .header h5 {
                margin: 0;
                font-weight: 700;
            }

        .header-right {
            display: flex;
            align-items: center;
            gap: 5px;
            margin-left: auto;
        }
        .avatar {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            background: var(--primary);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
        }

        /* ================= MOBILE ================= */
       

        .mobile-toggle {
            display: none;
            background: var(--primary);
            color: white;
            border: none;
            padding: 8px 12px;
            border-radius: 8px;
        }
        .sidebar-backdrop {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.5);
            display: none;
            z-index: 1500;
        }

            .sidebar-backdrop.show {
                display: block;
            }

        @@media (max-width: 992px) {

            .sidebar {
                transform: translateX(-100%);
            }

                .sidebar.show {
                    transform: translateX(0);
                }

            .main {
                margin-left: 0 !important;
            }

        .mobile-toggle {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .sidebar-backdrop.show {
            display: block;
        }

        }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>

    <div class="sidebar-backdrop" id="backdrop"></div>

    <div class="sidebar" id="sidebar">

        <!-- HEADER -->
        <div class="sidebar-header">
            <div class="logo">
                <i class="fa-solid fa-snowflake"></i>
                <span>AirCon Admin</span>
            </div>

            <button class="toggle-btn" id="toggleBtn">
                <i class="fas fa-bars"></i>
            </button>
        </div>

        <!-- MENU -->
        <ul class="nav-menu">

            <!-- DASHBOARD -->
            <li>
                <a asp-controller="Admin" asp-action="Dashboard">
                    <i class="fa-solid fa-chart-line"></i>
                    <span class="nav-text">Dashboard</span>
                </a>
            </li>

            <!-- TECHNICIANS -->
            <li class="has-submenu">

                <a href="#" class="submenu-toggle">
                    <i class="fa-solid fa-users-cog"></i>
                    <span class="nav-text">Technicians</span>
                    <i class="fa-solid fa-chevron-down submenu-icon"></i>
                </a>

                <ul class="submenu">

                    <li>
                        <a asp-controller="Users" asp-action="Create">
                            <i class="fa-solid fa-user-plus"></i>
                            <span class="nav-text">Create Account</span>
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Users" asp-action="Index">
                            <i class="fa-solid fa-users"></i>
                            <span class="nav-text">Manage Technicians</span>
                        </a>
                    </li>

                   @*  <li>
                        <a asp-controller="AdminService"
                           asp-action="Assign"
                           class="nav-link">

                            <i class="fa-solid fa-user-check"></i>

                            <span class="nav-text">
                                Assign Jobs
                            </span>

                        </a>
                    </li> *@
                    

                </ul>
            </li>

            <!-- SERVICES -->
            <li class="has-submenu">

                <a href="#" class="submenu-toggle">
                    <i class="fa-solid fa-screwdriver-wrench"></i>
                    <span class="nav-text">Services</span>
                    <i class="fa-solid fa-chevron-down submenu-icon"></i>
                </a>

                <ul class="submenu">

                    <li>
                        <a asp-controller="Appointment" asp-action="AppointmentList">
                            <i class="fa-solid fa-calendar-check"></i>
                            <span class="nav-text">Appointments</span>
                        </a>
                    </li>

                    @* <li>
                        <a asp-controller="AdminService" asp-action="Records">
                            <i class="fa-solid fa-file-lines"></i>
                            <span class="nav-text">Service Records</span>
                        </a>
                    </li> *@
@* 
                    <li>
                        <a asp-controller="InstallationRequest" asp-action="Index">
                            <i class="fa-solid fa-house-circle-check"></i>
                            <span class="nav-text">Installation Requests</span>
                        </a>
                    </li> *@

                </ul>
            </li>

            <!-- CUSTOMER CARE -->
            <li class="has-submenu">

                <a href="#" class="submenu-toggle">
                    <i class="fa-solid fa-comments"></i>
                    <span class="nav-text">Customer Care</span>
                    <i class="fa-solid fa-chevron-down submenu-icon"></i>
                </a>

                <ul class="submenu">

                    <li>
                        <a asp-controller="CustomerFeedback" asp-action="Index">
                            <i class="fa-solid fa-comment-dots"></i>
                            <span class="nav-text">Feedback</span>
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Complaint" asp-action="Index">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            <span class="nav-text">Complaints</span>
                        </a>
                    </li>
                </ul>
            </li>

            <!-- SCHEDULING -->
            <li class="has-submenu">

                <a href="#" class="submenu-toggle">
                    <i class="fa-solid fa-calendar-days"></i>
                    <span class="nav-text">Scheduling</span>
                    <i class="fa-solid fa-chevron-down submenu-icon"></i>
                </a>

                <ul class="submenu">

                    <li>
                        <a asp-controller="AdminService" asp-action="Calendar">
                            <i class="fa-solid fa-calendar"></i>
                            <span class="nav-text">Calendar</span>
                        </a>
                    </li>

                    <li>
                        <a asp-controller="TechnicianService" asp-action="Availability">
                            <i class="fa-solid fa-user-clock"></i>
                            <span class="nav-text">Availability</span>
                        </a>
                    </li>

                </ul>
            </li>

        </ul>

    </div>

    <!-- ================= MAIN ================= -->
    <div class="main" id="main">

        <!-- ================= HEADER ================= -->
        <div class="header">

            <!-- MOBILE TOGGLE (Technician Style) -->
            <button class="mobile-toggle" id="mobileToggle">
                <i class="fas fa-bars"></i>
            </button>

            <h5 class="mb-0">@ViewData["Title"]</h5>

            <div class="header-right">

                <!-- DATE -->
                @* <div>
                    @DateTime.Now.ToString("dd MMM yyyy")
                </div> *@
                <div class="text-muted small d-none d-md-block">
                    @DateTime.Now.ToString("dd MMM yyyy hh:mm tt")
                </div>
                <!-- AVATAR -->
                <div class="avatar">
                    @(adminName?.Substring(0, 1).ToUpper())
                </div>

                <!-- USER INFO -->
                <div>
                    <div><b>@adminName</b></div>
                    <small>@adminRole</small>
                </div>

                <!-- LOGOUT -->
                <a asp-controller="AdminLogin"
                   asp-action="Logout"
                   class="btn btn-sm btn-outline-danger">
                    Logout
                </a>

            </div>

        </div>

        <!-- ================= CONTENT ================= -->
        <div style="padding:20px;">
            @RenderBody()
        </div>

    </div>

    <script>

        const sidebar = document.getElementById("sidebar");
        const toggleBtn = document.getElementById("toggleBtn");
        const mobileToggle = document.getElementById("mobileToggle");
        const backdrop = document.getElementById("backdrop");

        // ================= DESKTOP COLLAPSE =================
        if (toggleBtn) {
            toggleBtn.addEventListener("click", () => {
                sidebar.classList.toggle("collapsed");

                localStorage.setItem(
                    "admin_sidebar",
                    sidebar.classList.contains("collapsed") ? "collapsed" : "expanded"
                );
            });
        }

        // restore state
        window.addEventListener("load", () => {
            if (localStorage.getItem("admin_sidebar") === "collapsed") {
                sidebar.classList.add("collapsed");
            }
        });

        // ================= MOBILE OPEN =================
        if (mobileToggle) {
            mobileToggle.addEventListener("click", () => {
                sidebar.classList.add("show");
                backdrop.classList.add("show");
            });
        }

        // ================= MOBILE CLOSE =================
        if (backdrop) {
            backdrop.addEventListener("click", () => {
                sidebar.classList.remove("show");
                backdrop.classList.remove("show");
            });
        }

        // ================= SUBMENU TOGGLE =================
        document.querySelectorAll(".submenu-toggle").forEach(menu => {

            menu.addEventListener("click", function (e) {
                e.preventDefault();

                const parent = this.closest(".has-submenu");
                parent.classList.toggle("open");

            });

        });

        // ================= ACTIVE MENU =================
        document.querySelectorAll(".nav-menu a").forEach(link => {

            link.addEventListener("click", function () {

                document.querySelectorAll(".nav-menu a")
                    .forEach(x => x.classList.remove("active"));

                this.classList.add("active");

                // close mobile after click
                if (window.innerWidth <= 992) {
                    sidebar.classList.remove("show");
                    backdrop.classList.remove("show");
                }

            });

        });

        // ================= OUTSIDE CLICK (MOBILE) =================
        document.addEventListener("click", function (e) {

            if (window.innerWidth > 992) return;

            const isInsideSidebar = sidebar.contains(e.target);
            const isToggle = mobileToggle && mobileToggle.contains(e.target);

            if (!isInsideSidebar && !isToggle) {
                sidebar.classList.remove("show");
                backdrop.classList.remove("show");
            }

        });

        // ================= RESPONSIVE RESET =================
        window.addEventListener("resize", function () {

            if (window.innerWidth > 992) {
                sidebar.classList.remove("show");
                backdrop.classList.remove("show");
            }

        });

    </script>
</body>
<