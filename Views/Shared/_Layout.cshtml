<!DOCTYPE html>

<html lang="en" data-bs-theme="light">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <title>@ViewData["Title"] - AirConServ</title>


    <!-- Bootstrap 5 -->
    <link href="~/bootstrap/bootstrap.min530.css"
          rel="stylesheet" />

    <!-- Favicon -->
    <link rel="icon"
          type="image/png"
          href="~/images/NewAClogo.png" />


    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="~/fontawesome/css/all.min640.css" />

    <link rel="icon" type="image/png" href="~/images/NewAClogo.png" />


    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
          rel="stylesheet" />


    <style>

        /* =========================================================
               ROOT
            ========================================================= */

        :root {
            --primary-color: #2c8c99;
            --primary-dark: #1a6b78;
            --primary-light: #e8f4f6;
            --secondary-color: #6c757d;
            --success-color: #198754;
            --purple: #6f42c1;
            --accent-color: #ff7e5f;
            --shadow-sm: 0 2px 8px rgba(44, 140, 153, 0.08);
            --shadow-md: 0 8px 30px rgba(44, 140, 153, 0.12);
            --shadow-lg: 0 20px 60px rgba(44, 140, 153, 0.15);
            --radius: 16px;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }


        /* =========================================================
               GLOBAL
            ========================================================= */

        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: #f8fafc;
            color: #1a2a3a;
            line-height: 1.6;
            overflow-x: hidden;
            margin: 0;
            min-height: 100vh;
        }

        img {
            max-width: 100%;
            height: auto;
        }

        a {
            -webkit-tap-highlight-color: transparent;
        }


        /* =========================================================
               NAVBAR
            ========================================================= */

        .navbar {
            min-height: 72px;
            padding: 10px 0;
            background: rgba(255, 255, 255, 0.94) !important;
            backdrop-filter: blur(16px) saturate(180%);
            -webkit-backdrop-filter: blur(16px) saturate(180%);
            border-bottom: 1px solid rgba(44, 140, 153, 0.07);
            transition: var(--transition);
            z-index: 1030;
        }


        /* =========================================================
               BRAND
            ========================================================= */

        .navbar-brand {
            display: inline-flex;
            align-items: center;
            font-weight: 800;
            font-size: 1.4rem;
            letter-spacing: -0.5px;
            color: var(--primary-color) !important;
            white-space: nowrap;
        }

            .navbar-brand i {
                color: var(--primary-color);
                font-size: 1.3rem;
            }

            .navbar-brand span {
                color: var(--primary-dark);
            }


        /* =========================================================
               NAV LINKS
            ========================================================= */

        .navbar-nav {
            gap: 2px;
        }

        .nav-link {
            font-weight: 500;
            font-size: 0.9rem;
            padding: 8px 14px !important;
            border-radius: 10px;
            transition: var(--transition);
            color: #4a5a6a !important;
            white-space: nowrap;
        }

            .nav-link:hover,
            .nav-link.active {
                color: var(--primary-color) !important;
                background: rgba(44, 140, 153, 0.06);
            }

            .nav-link.active {
                font-weight: 600;
            }


        /* =========================================================
               NAVBAR RIGHT SIDE
            ========================================================= */
        .navbar-actions {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 8px;
            flex-shrink: 0;
        }

        /* =========================================================
               BUTTONS
            ========================================================= */

        .navbar .btn {
            border-radius: 10px;
            padding: 8px 18px;
            font-weight: 600;
            font-size: 0.85rem;
            transition: var(--transition);
            white-space: nowrap;
        }

        .btn-outline-primary {
            color: var(--primary-color);
            border-color: var(--primary-color);
        }

            .btn-outline-primary:hover {
                background: var(--primary-color);
                border-color: var(--primary-color);
                color: #fff;
                transform: translateY(-1px);
                box-shadow: 0 4px 12px rgba(44, 140, 153, 0.25);
            }

        .btn-primary {
            background: var(--primary-color);
            border-color: var(--primary-color);
            color: #fff;
        }

            .btn-primary:hover {
                background: var(--primary-dark);
                border-color: var(--primary-dark);
                transform: translateY(-1px);
                box-shadow: 0 4px 12px rgba(44, 140, 153, 0.3);
            }


        /* =========================================================
               THEME BUTTON
            ========================================================= */

        .theme-switch {
            width: 40px;
            height: 40px;
            min-width: 40px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            cursor: pointer;
            transition: var(--transition);
            background: rgba(44, 140, 153, 0.06);
            color: var(--primary-color);
            font-size: 1.05rem;
            border: none;
            flex-shrink: 0;
        }

            .theme-switch:hover {
                background: rgba(44, 140, 153, 0.12);
                transform: rotate(20deg);
            }

            .theme-switch:focus {
                outline: none;
                box-shadow: 0 0 0 3px rgba(44, 140, 153, 0.15);
            }


        /* =========================================================
               MOBILE TOGGLER
            ========================================================= */

        .navbar-toggler {
            border: none;
            padding: 8px 10px;
            border-radius: 10px;
            background: rgba(44, 140, 153, 0.06);
            transition: var(--transition);
        }

            .navbar-toggler:hover {
                background: rgba(44, 140, 153, 0.12);
            }

            .navbar-toggler:focus {
                box-shadow: 0 0 0 3px rgba(44, 140, 153, 0.18);
            }

        .navbar-toggler-icon {
            width: 24px;
            height: 24px;
        }


        /* =========================================================
               MAIN
            ========================================================= */

        main {
            width: 100%;
            overflow-x: hidden;
        }


        /* =========================================================
               FOOTER
            ========================================================= */

        .footer {
            background: #fff;
            border-top: 1px solid rgba(44, 140, 153, 0.06);
            padding: 55px 0 30px;
            margin-top: 60px;
        }

            .footer h4,
            .footer h5 {
                font-weight: 700;
                color: var(--primary-dark);
            }

            .footer a {
                color: #6c7a8a;
                text-decoration: none;
                transition: var(--transition);
            }

                .footer a:hover {
                    color: var(--primary-color);
                }


            /* =========================================================
               SOCIAL LINKS
            ========================================================= */

            .footer .social-links {
                display: flex;
                align-items: center;
                flex-wrap: wrap;
                gap: 8px;
            }

            .footer .social-link {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 40px;
                height: 40px;
                border-radius: 50%;
                background: rgba(44, 140, 153, 0.06);
                color: var(--primary-color);
                transition: var(--transition);
            }

                .footer .social-link:hover {
                    background: var(--primary-color);
                    color: #fff;
                    transform: translateY(-3px);
                    box-shadow: 0 6px 20px rgba(44, 140, 153, 0.25);
                }


        /* =========================================================
               FOOTER CONTACT
            ========================================================= */

        .footer-contact li {
            display: flex;
            align-items: flex-start;
            gap: 5px;
            line-height: 1.5;
        }

        .footer-contact i {
            width: 18px;
            flex-shrink: 0;
            margin-top: 4px;
        }


        /* =========================================================
               DARK MODE
            ========================================================= */

        [data-bs-theme="dark"] {
            color-scheme: dark;
        }

            [data-bs-theme="dark"] body {
                background-color: #0f1419;
                color: #e8edf2;
            }

            [data-bs-theme="dark"] .navbar {
                background: rgba(18, 24, 30, 0.96) !important;
                border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            }

            [data-bs-theme="dark"] .navbar-brand {
                color: #fff !important;
            }

                [data-bs-theme="dark"] .navbar-brand span {
                    color: var(--primary-color);
                }

            [data-bs-theme="dark"] .nav-link {
                color: rgba(255, 255, 255, 0.75) !important;
            }

                [data-bs-theme="dark"] .nav-link:hover,
                [data-bs-theme="dark"] .nav-link.active {
                    color: var(--primary-color) !important;
                    background: rgba(44, 140, 153, 0.12);
                }

            [data-bs-theme="dark"] .navbar-toggler {
                background: rgba(255, 255, 255, 0.06);
            }

            [data-bs-theme="dark"] .navbar-toggler-icon {
                filter: invert(1);
            }

            [data-bs-theme="dark"] .theme-switch {
                background: rgba(255, 255, 255, 0.06);
                color: #d5dde4;
            }

                [data-bs-theme="dark"] .theme-switch:hover {
                    background: rgba(255, 255, 255, 0.12);
                }

            [data-bs-theme="dark"] .footer {
                background: #121a20;
                border-top: 1px solid rgba(255, 255, 255, 0.05);
            }

                [data-bs-theme="dark"] .footer h4,
                [data-bs-theme="dark"] .footer h5 {
                    color: #e8edf2;
                }

                [data-bs-theme="dark"] .footer a {
                    color: #8a9aa8;
                }

                    [data-bs-theme="dark"] .footer a:hover {
                        color: var(--primary-color);
                    }

                [data-bs-theme="dark"] .footer .social-link {
                    background: rgba(255, 255, 255, 0.06);
                    color: #8a9aa8;
                }

                    [data-bs-theme="dark"] .footer .social-link:hover {
                        background: var(--primary-color);
                        color: #fff;
                    }

            [data-bs-theme="dark"] .text-muted {
                color: #8a9aa8 !important;
            }

            [data-bs-theme="dark"] hr {
                border-color: rgba(255, 255, 255, 0.07);
            }


        /* =========================================================
               TABLET
            ========================================================= */

        @@media (max-width: 991.98px) {

            .navbar {
                min-height: 68px;
                padding: 8px 0;
            }

            .navbar-collapse {
                margin-top: 10px;
                padding: 12px;
                border-radius: 14px;
                background: rgba(255, 255, 255, 0.98);
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
                border: 1px solid rgba(44, 140, 153, 0.06);
            }

            [data-bs-theme="dark"] .navbar-collapse {
                background: rgba(18, 24, 30, 0.98);
                border-color: rgba(255, 255, 255, 0.05);
            }

            .navbar-nav {
                width: 100%;
                gap: 3px;
                margin-bottom: 10px;
            }

            .nav-item {
                width: 100%;
            }

            .nav-link {
                width: 100%;
                padding: 11px 14px !important;
                border-radius: 9px;
            }

            .navbar-actions {
                display: flex;
                align-items: center;
                justify-content: flex-end;
                gap: 8px;
                width: auto;
                padding-top: 0;
                border-top: none;
                flex-shrink: 0;
            }

                .navbar-actions .btn {
                    flex: 0 0 auto;
                    text-align: center;
                }

            [data-bs-theme="dark"] .navbar-actions {
                border-color: rgba(255, 255, 255, 0.06);
            }

            .navbar-actions .btn {
                flex: 1;
                text-align: center;
            }

            .theme-switch {
                flex-shrink: 0;
            }

            .footer {
                padding: 40px 0 25px;
                margin-top: 40px;
            }

            .footer-brand {
                text-align: center;
            }

                .footer-brand .social-links {
                    justify-content: center;
                }
        }


        /* =========================================================
               MOBILE
            ========================================================= */

        @@media (max-width: 575.98px) {

            .navbar {
                min-height: 62px;
                padding: 7px 0;
            }

                .navbar .container {
                    padding-left: 14px;
                    padding-right: 14px;
                }

            .navbar-brand {
                font-size: 1.15rem;
                letter-spacing: -0.4px;
            }

                .navbar-brand i {
                    font-size: 1.05rem;
                    margin-right: 5px !important;
                }

            .theme-switch {
                width: 38px;
                height: 38px;
                min-width: 38px;
            }

            .navbar-toggler {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
            }

            .navbar-toggler-icon {
                width: 21px;
                height: 21px;
            }

            .navbar-collapse {
                margin-top: 8px;
                padding: 10px;
                border-radius: 12px;
            }

            .nav-link {
                font-size: 0.88rem;
                padding: 10px 12px !important;
            }

            .navbar-actions {
                display: flex;
                align-items: center;
                gap: 6px;
                padding-top: 0;
                border-top: none;
                width: auto;
                flex-shrink: 0;
            }

                .navbar-actions .btn {
                    flex: 0 0 auto;
                    font-size: 0.78rem;
                    padding: 8px 10px;
                    min-height: 38px;
                }

                    .navbar-actions .btn i {
                        margin-right: 3px !important;
                    }

           

           /*  .theme-switch {
                width: 40px;
                height: 40px;
                min-width: 40px;
            } */
            /* FOOTER */

            .footer {
                padding: 35px 0 22px;
                margin-top: 30px;
            }

                .footer .container {
                    padding-left: 18px;
                    padding-right: 18px;
                }

            .footer-brand {
                text-align: center;
                margin-bottom: 10px;
            }

                .footer-brand p {
                    font-size: 0.84rem;
                    line-height: 1.6;
                }

            .footer h4 {
                font-size: 1.25rem;
            }

            .footer h5 {
                font-size: 0.95rem;
                margin-bottom: 12px !important;
            }

            .footer .list-unstyled li {
                font-size: 0.82rem;
                line-height: 1.5;
            }

            .footer-contact li {
                margin-bottom: 10px !important;
            }

            .footer .social-link {
                width: 36px;
                height: 36px;
                font-size: 0.85rem;
            }

            .footer hr {
                margin: 25px 0 20px !important;
            }

            .footer-bottom {
                text-align: center;
            }

                .footer-bottom p {
                    font-size: 0.75rem;
                }

                .footer-bottom .footer-policy {
                    display: flex;
                    justify-content: center;
                    flex-wrap: wrap;
                    gap: 8px;
                    margin-top: 8px;
                }

                    .footer-bottom .footer-policy a {
                        font-size: 0.75rem;
                        margin: 0 !important;
                    }
        }


        /* =========================================================
               SMALL PHONE
            ========================================================= */

        @@media (max-width: 390px) {

            .navbar-brand {
                font-size: 1.05rem;
            }

            .navbar-toggler {
                padding: 6px 7px;
            }

            .navbar-toggler-icon {
                width: 20px;
                height: 20px;
            }

            .navbar-actions .btn {
                font-size: 0.78rem;
                padding-left: 9px;
                padding-right: 9px;
            }

            .footer .col-6 {
                padding-left: 10px;
                padding-right: 10px;
            }
        }


        /* =========================================================
               SCROLLBAR
            ========================================================= */

        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        ::-webkit-scrollbar-track {
            background: rgba(44, 140, 153, 0.04);
        }

        ::-webkit-scrollbar-thumb {
            background: var(--primary-color);
            border-radius: 20px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: var(--primary-dark);
            }


        /* =========================================================
               UTILITIES
            ========================================================= */

        .bg-gradient-primary {
            background: linear-gradient( 135deg, var(--primary-color) 0%, var(--primary-dark) 100% );
        }

        .text-primary {
            color: var(--primary-color) !important;
        }

        .bg-primary-opacity-10 {
            background: rgba(44, 140, 153, 0.08);
        }

        .rounded-4 {
            border-radius: 20px;
        }

        .shadow-soft {
            box-shadow: var(--shadow-sm);
        }

        .shadow-hover {
            transition: var(--transition);
        }

            .shadow-hover:hover {
                box-shadow: var(--shadow-md);
                transform: translateY(-4px);
            }


        /* =========================================================
               REDUCE MOTION
            ========================================================= */

        @@media (prefers-reduced-motion: reduce) {

            *,
            *::before,
            *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
                scroll-behavior: auto !important;
            }
        }

    </style>

    @await RenderSectionAsync("Styles", required: false)

</head>

<body>

    <!-- =========================================================
         NAVIGATION
    ========================================================= -->

    <nav class="navbar navbar-expand-lg sticky-top">
        <div class="container">

            <!-- BRAND -->
            <a class="navbar-brand"
               asp-controller="Home"
               asp-action="Index">

                <i class="fas fa-wind me-2"></i>
                AirCon<span>Serv</span>

            </a>


            <!-- DESKTOP NAVIGATION -->
            <div class="collapse navbar-collapse" id="navbarNav">

                <ul class="navbar-nav me-auto">

                    <li class="nav-item">
                        <a class="nav-link active"
                           asp-controller="Home"
                           asp-action="Index">
                            Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="/Features">
                            Features
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="/Pricing">
                            Pricing
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="/About">
                            About
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="/Contact">
                            Contact
                        </a>
                    </li>

                </ul>

            </div>


            <!-- RIGHT ACTIONS
                 Keep outside navbar-collapse
                 so they stay visible on mobile -->
            <div class="navbar-actions">

                <!-- Theme -->
                <button class="theme-switch"
                        id="themeToggle"
                        type="button"
                        aria-label="Toggle dark mode">

                    <i class="fas fa-moon"
                       id="themeIcon"></i>

                </button>


                <!-- Login -->
                <a asp-controller="Login"
                   asp-action="Login"
                   class="btn btn-outline-primary">

                    <i class="fas fa-sign-in-alt me-1"></i>
                    <span>Login</span>

                </a>


                <!-- MOBILE MENU TOGGLE -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarNav"
                        aria-controls="navbarNav"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

            </div>

        </div>
    </nav>



    <!-- =========================================================
         MAIN CONTENT
    ========================================================= -->

    <main role="main">

        @RenderBody()

    </main>



    <!-- =========================================================
         FOOTER
    ========================================================= -->

    <footer class="footer">

        <div class="container">

            <div class="row g-4">


                <!-- BRAND -->

                <div class="col-lg-4 footer-brand">

                    <h4 class="fw-bold mb-3">

                        <i class="fas fa-wind me-2"></i>

                        AirCon<span class="text-primary">
                            Serv
                        </span>

                    </h4>


                    <p class="text-muted">

                        Professional air conditioning
                        servicing management system designed
                        to streamline operations and improve
                        customer satisfaction.

                    </p>


                    <div class="social-links mt-4">

                        <a href="#"
                           class="social-link"
                           aria-label="Facebook">

                            <i class="fab fa-facebook-f"></i>

                        </a>


                        <a href="#"
                           class="social-link"
                           aria-label="Twitter">

                            <i class="fab fa-twitter"></i>

                        </a>


                        <a href="#"
                           class="social-link"
                           aria-label="LinkedIn">

                            <i class="fab fa-linkedin-in"></i>

                        </a>


                        <a href="#"
                           class="social-link"
                           aria-label="Instagram">

                            <i class="fab fa-instagram"></i>

                        </a>

                    </div>

                </div>



                <!-- PRODUCT -->

                <div class="col-6 col-lg-2">

                    <h5 class="fw-bold mb-3">
                        Product
                    </h5>

                    <ul class="list-unstyled">

                        <li class="mb-2">
                            <a href="/Features">
                                Features
                            </a>
                        </li>

                        <li class="mb-2">
                            <a href="/Pricing">
                                Pricing
                            </a>
                        </li>

                        <li class="mb-2">
                            <a href="/Updates">
                                Updates
                            </a>
                        </li>

                        <li class="mb-2">
                            <a href="/FAQ">
                                FAQ
                            </a>
                        </li>

                    </ul>

                </div>



                <!-- COMPANY -->

                <div class="col-6 col-lg-2">

                    <h5 class="fw-bold mb-3">
                        Company
                    </h5>

                    <ul class="list-unstyled">

                        <li class="mb-2">
                            <a href="/About">
                                About
                            </a>
                        </li>

                        <li class="mb-2">
                            <a href="/Careers">
                                Careers
                            </a>
                        </li>

                        <li class="mb-2">
                            <a href="/Blog">
                                Blog
                            </a>
                        </li>

                        <li class="mb-2">
                            <a href="/Press">
                                Press
                            </a>
                        </li>

                    </ul>

                </div>



                <!-- CONTACT -->

                <div class="col-lg-4">

                    <h5 class="fw-bold mb-3">
                        Contact Us
                    </h5>


                    <ul class="list-unstyled
                           text-muted
                           footer-contact">

                        <li class="mb-2">

                            <i class="fas fa-map-marker-alt
                                  text-primary"></i>

                            <span>
                                123 Service Street,
                                Ygn City, AC 12345
                            </span>

                        </li>


                        <li class="mb-2">

                            <i class="fas fa-phone
                                  text-primary"></i>

                            <span>
                                (+95) 9 123 456 789
                            </span>

                        </li>


                        <li class="mb-2">

                            <i class="fas fa-envelope
                                  text-primary"></i>

                            <span>
                                support@airconserv.com
                            </span>

                        </li>


                        <li class="mb-2">

                            <i class="fas fa-clock
                                  text-primary"></i>

                            <span>
                                Mon-Fri 9:00AM - 6:00PM
                            </span>

                        </li>

                    </ul>

                </div>

            </div>


            <hr class="my-4" />


            <!-- FOOTER BOTTOM -->

            <div class="row align-items-center footer-bottom">

                <div class="col-md-6">

                    <p class="text-muted mb-0">

                        &copy; @DateTime.Now.Year
                        AirConServ.
                        All rights reserved.

                    </p>

                </div>


                <div class="col-md-6">

                    <div class="footer-policy text-md-end">

                        <a href="/Privacy"
                           class="text-muted me-3">

                            Privacy Policy

                        </a>


                        <a href="/Terms"
                           class="text-muted">

                            Terms of Service

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </footer>



    <!-- =========================================================
         BOOTSTRAP
    ========================================================= -->

    <script src="~/bootstrap/bootstrap.bundle.min.js"></script>


    <!-- =========================================================
         THEME + NAVBAR SCRIPT
    ========================================================= -->

    <script>

        document.addEventListener("DOMContentLoaded", function () {


            /* =====================================================
               THEME TOGGLE
            ===================================================== */

            const themeToggle =
                document.getElementById("themeToggle");

            const themeIcon =
                document.getElementById("themeIcon");

            const html =
                document.documentElement;


            const savedTheme =
                localStorage.getItem("theme") || "light";


            html.setAttribute(
                "data-bs-theme",
                savedTheme
            );


            updateThemeIcon(savedTheme);


            if (themeToggle) {

                themeToggle.addEventListener(
                    "click",
                    function () {

                        const currentTheme =
                            html.getAttribute(
                                "data-bs-theme"
                            );


                        const nextTheme =
                            currentTheme === "light"
                                ? "dark"
                                : "light";


                        html.setAttribute(
                            "data-bs-theme",
                            nextTheme
                        );


                        localStorage.setItem(
                            "theme",
                            nextTheme
                        );


                        updateThemeIcon(
                            nextTheme
                        );

                    }
                );

            }


            function updateThemeIcon(theme) {

                if (!themeIcon)
                    return;


                themeIcon.className =
                    theme === "dark"
                        ? "fas fa-sun"
                        : "fas fa-moon";

            }



            /* =====================================================
               MOBILE NAVBAR
            ===================================================== */

            const collapseElement =
                document.getElementById(
                    "navbarNav"
                );


            if (!collapseElement)
                return;


            const bsCollapse =
                bootstrap.Collapse.getOrCreateInstance(
                    collapseElement,
                    {
                        toggle: false
                    }
                );


            /* Close menu after clicking link */

            const navLinks =
                document.querySelectorAll(
                    ".navbar-nav .nav-link"
                );


            navLinks.forEach(function (link) {

                link.addEventListener(
                    "click",
                    function () {

                        if (
                            window.innerWidth < 992 &&
                            collapseElement.classList.contains("show")
                        ) {

                            bsCollapse.hide();

                        }

                    }
                );

            });



            /* =====================================================
               CLOSE MENU WHEN CLICKING OUTSIDE
            ===================================================== */

            document.addEventListener(
                "click",
                function (event) {

                    if (window.innerWidth >= 992)
                        return;


                    if (
                        !collapseElement.classList.contains("show")
                    )
                        return;


                    const navbar =
                        document.querySelector(".navbar");


                    if (
                        navbar &&
                        !navbar.contains(event.target)
                    ) {

                        bsCollapse.hide();

                    }

                }
            );


        });

    </script>


    @await RenderSectionAsync(
    "Scripts",
        required: false
        )

</body>

</html>
