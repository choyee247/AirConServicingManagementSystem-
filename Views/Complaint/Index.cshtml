@{
    ViewData["Title"] = "Complaint";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@model List<Complaint>

<div class="card-modern">

    <div class="flex-between">
        <h4 style="color:#2c8c99;">Complaints</h4>

        <a asp-action="Create" class="btn btn-sm text-white" style="background:#2c8c99;">
            + New Complaint
        </a>
    </div>

    <table class="table table-hover mt-3">

        <thead>
            <tr>
                <th>Customer</th>
                <th>Technician</th>
                <th>Title</th>
                <th>Status</th>
                <th>Date</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Customer.Name</td>
                <td>@item.Technician?.Name</td>
                <td>@item.Title</td>

                <td>
                    <span class="badge bg-@(item.Status=="New"?"danger":item.Status=="In Progress"?"warning":"success")">
                        @item.Status
                    </span>
                </td>

                <td>@item.CreatedAt.ToString("dd MMM yyyy")</td>

                <td>
                    <a asp-action="Details" asp-route-id="@item.ComplaintId" class="btn btn-info btn-sm">View</a>
                    <a asp-action="Delete" asp-route-id="@item.ComplaintId" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
        </tbody>

    </table>

</div>