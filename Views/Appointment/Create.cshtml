
@{
    ViewData["Title"] = "Create Appointment";
    //Layout = "~/Views/Shared/_TechnicianLayout.cshtml";
}
@{
    var userRole = Context.Session.GetString("UserRole");

    if (userRole == "Admin")
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
    else if (userRole == "Senior" || userRole == "Junior")
    {
        Layout = "~/Views/Shared/_TechnicianLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
}
@model Appointment

<link rel="stylesheet" href="~/css/select2.min(css).css" />
@* <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css"
      rel="stylesheet" /> *@

<div class="container py-4">

    <div class="card shadow-sm rounded-3">

        <div class="card-header bg-white">

            <h3 style="color:#2c8c99;font-weight:700;">
                Create Appointment
            </h3>

            <p class="text-muted mb-0">
                Schedule customer service visit
            </p>

        </div>


        <div class="card-body">


            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()


                <!-- Customer -->
                <div class="mb-3">

                    <label class="form-label">
                        Customer
                    </label>


                    <select asp-for="CustomerId"
                            id="CustomerId"
                            class="form-select"
                            required>


                        <option value="">
                            -- Search Customer --
                        </option>


                        @foreach (var c in ViewBag.Customers)
                        {
                            <option value="@c.Id">

                                @c.Name
                                (@c.Phone)

                            </option>
                        }


                    </select>


                </div>



                <!-- Phone -->
                <div class="mb-3">

                    <label class="form-label">
                        Phone Number
                    </label>


                    <input id="CustomerInfo"
                           class="form-control"
                           readonly />

                </div>



                <!-- Date -->
                <div class="mb-3">

                    <label class="form-label">
                        Scheduled Date
                    </label>


                    <input asp-for="ScheduledDate"
                           type="datetime-local"
                           class="form-control"
                           required />

                </div>




                <!-- Location -->
                <div class="mb-3">

                    <label class="form-label">
                        Location
                    </label>


                    <textarea asp-for="Location"
                           id="Location"
                           class="form-control"
                           placeholder="Customer address / location"
                           required ></textarea>

                </div>




                <!-- Notes -->
                <div class="mb-3">

                    <label class="form-label">
                        Notes
                    </label>


                    <textarea asp-for="Notes"
                              class="form-control"
                              rows="3"
                              placeholder="Optional details"></textarea>


                </div>




                <button type="submit"
                        class="btn w-100 text-white"
                        style="background:#2c8c99;">

                    Save

                </button>



            </form>


        </div>


    </div>


</div>



@section Scripts
{

    <script src="~/js/select2.min.js"></script>
    @* <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script> *@

    <script>


        $(document).ready(function () {



            // Enable Search Dropdown

            $("#CustomerId").select2({

                placeholder: "-- Search Customer --",

                allowClear: true,

                width: "100%"

            });





            // Customer Change Event

            $("#CustomerId").on("change", function () {


                var customerId = $(this).val();



                if(customerId == "")
                {

                    $("#Location").val("");

                    $("#CustomerInfo").val("");

                    return;

                }



                $.ajax({

                    url: "/Appointment/GetCustomerInfo",


                    type: "GET",


                    data: {

                        id: customerId

                    },


                    success: function(data)
                    {


                        if(data)
                        {

                            $("#Location")
                                .val(data.location);



                            $("#CustomerInfo")
                                .val(data.phone);

                        }


                    },


                    error:function()
                    {

                        console.log(
                            "Customer load error"
                        );

                    }


                });



            });



        });



    </script>


}