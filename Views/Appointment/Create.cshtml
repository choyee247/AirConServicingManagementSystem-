@model Appointment

@{
    ViewData["Title"] = "Create Appointment";

    var userRole = Context.Session.GetString("UserRole");

    if (userRole == "Admin")
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
    else if (userRole == "Senior" || userRole == "Junior")
    {
        Layout = "~/Views/Shared/_TechnicianLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
}

<link rel="stylesheet" href="~/css/select2.min(css).css" />

<style>

    .appointment-wrapper {
        max-width: 900px;
        margin: 0 auto;
    }

    .appointment-card {
        border: none;
        border-radius: 14px;
        overflow: hidden;
    }

    .appointment-header {
        background: #ffffff;
        border-bottom: 1px solid #eeeeee;
        padding: 24px 28px;
    }

    .appointment-title {
        color: #2c8c99;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .appointment-subtitle {
        color: #6c757d;
        margin-bottom: 0;
    }

    .appointment-body {
        padding: 28px;
    }

    .form-label {
        font-weight: 600;
        color: #333;
        margin-bottom: 8px;
    }

    .form-control,
    .form-select {
        min-height: 46px;
        border-radius: 8px;
        border: 1px solid #d9dfe3;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #2c8c99;
            box-shadow: 0 0 0 0.15rem rgba(44, 140, 153, 0.15);
        }

    textarea.form-control {
        min-height: 100px;
        resize: vertical;
    }

    .customer-info-box {
        background: #f6fbfc;
        border: 1px solid #dceff1;
        border-radius: 8px;
        padding: 12px 15px;
    }

    .customer-info-label {
        font-size: 12px;
        color: #6c757d;
        margin-bottom: 3px;
    }

    .customer-info-value {
        color: #2c8c99;
        font-weight: 600;
    }

    .select2-container {
        width: 100% !important;
    }

    .select2-container--default .select2-selection--single {
        height: 46px;
        border: 1px solid #d9dfe3;
        border-radius: 8px;
        display: flex;
        align-items: center;
    }

        .select2-container--default
        .select2-selection--single
        .select2-selection__rendered {
            line-height: 44px;
            padding-left: 14px;
            color: #333;
        }

        .select2-container--default
        .select2-selection--single
        .select2-selection__arrow {
            height: 44px;
            right: 8px;
        }

    .select2-container--default.select2-container--focus
    .select2-selection--single {
        border-color: #2c8c99;
        box-shadow: 0 0 0 0.15rem rgba(44, 140, 153, 0.15);
    }

    .select2-dropdown {
        border-color: #2c8c99;
    }

    .select2-results__option--highlighted[aria-selected] {
        background-color: #2c8c99 !important;
    }

    .btn-save {
        background: #2c8c99;
        border: none;
        min-height: 46px;
        border-radius: 8px;
        font-weight: 600;
    }

        .btn-save:hover {
            background: #247783;
        }

    .btn-cancel {
        min-height: 46px;
        border-radius: 8px;
        font-weight: 600;
    }

    .required-star {
        color: #dc3545;
    }

    .field-validation-error {
        font-size: 13px;
    }

    @@media (max-width: 576px) {

        .appointment-body {
            padding: 20px;
        }

        .appointment-header {
            padding: 20px;
        }

        .action-buttons {
            flex-direction: column;
        }

            .action-buttons .btn {
                width: 100%;
            }
    }

</style>


<div class="container py-4">

    <div class="appointment-wrapper">

        <div class="card shadow-sm appointment-card">

            <!-- Header -->
            <div class="appointment-header">

                <h3 class="appointment-title">
                    <i class="fas fa-calendar-plus me-2"></i>
                    Create Appointment
                </h3>

                <p class="appointment-subtitle">
                    Schedule a customer service visit
                </p>

            </div>


            <!-- Body -->
            <div class="appointment-body">

                <form asp-action="Create"
                      method="post">

                    @Html.AntiForgeryToken()


                    <!-- Customer -->
                    <div class="mb-4">

                        <label class="form-label">
                            Customer
                            <span class="required-star">*</span>
                        </label>

                        <select asp-for="CustomerId"
                                id="CustomerId"
                                class="form-select"
                                required>

                            <option value="">
                                -- Search Customer --
                            </option>

                        </select>

                        <span asp-validation-for="CustomerId"
                              class="text-danger">
                        </span>

                        <small class="text-muted">
                            Type customer name or phone number to search.
                        </small>

                    </div>


                    <!-- Customer Phone -->
                    <div class="mb-4">

                        <label class="form-label">
                            Phone Number
                        </label>

                        <div class="customer-info-box">

                            <div class="customer-info-label">
                                Customer Phone
                            </div>

                            <div id="CustomerInfo"
                                 class="customer-info-value">

                                --

                            </div>

                        </div>

                    </div>


                    <!-- Scheduled Date -->
                    <div class="mb-4">

                        <label class="form-label">
                            Scheduled Date
                            <span class="required-star">*</span>
                        </label>

                        <input asp-for="ScheduledDate"
                               type="datetime-local"
                               class="form-control"
                               required />

                        <span asp-validation-for="ScheduledDate"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Location -->
                    <div class="mb-4">

                        <label class="form-label">
                            Location
                            <span class="required-star">*</span>
                        </label>

                        <textarea asp-for="Location"
                                  id="Location"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Customer address / location"
                                  required></textarea>

                        <span asp-validation-for="Location"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Notes -->
                    <div class="mb-4">

                        <label class="form-label">
                            Notes
                        </label>

                        <textarea asp-for="Notes"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Optional details"></textarea>

                        <span asp-validation-for="Notes"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Buttons -->
                    <div class="action-buttons d-flex justify-content-end gap-2">

                        <a asp-action="Index"
                           class="btn btn-light btn-cancel px-4">

                            <i class="fas fa-times me-1"></i>
                            Cancel

                        </a>

                        <button type="submit"
                                class="btn btn-save text-white px-5">

                            <i class="fas fa-save me-1"></i>
                            Save Appointment

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/select2.min.js"></script>

    <script>

        $(document).ready(function () {

            /*
             * ==========================================
             * Customer Search - Server Side AJAX
             * ==========================================
             */

            $("#CustomerId").select2({

                placeholder: "-- Search Customer --",

                allowClear: true,

                width: "100%",

                minimumInputLength: 2,

                ajax: {

                    url: '@Url.Action("SearchCustomers", "Appointment")',

                    type: "GET",

                    dataType: "json",

                    delay: 300,

                    data: function (params) {

                        return {
                            search: params.term
                        };

                    },

                    processResults: function (data) {

                        return {
                            results: data
                        };

                    },

                    cache: true

                },

                language: {

                    inputTooShort: function () {

                        return "Please enter at least 2 characters.";

                    },

                    searching: function () {

                        return "Searching...";

                    },

                    noResults: function () {

                        return "No customer found.";

                    }

                }

            });


            /*
             * ==========================================
             * Customer Selected
             * ==========================================
             */

            $("#CustomerId").on("change", function () {

                var customerId = $(this).val();


                if (!customerId) {

                    $("#Location").val("");

                    $("#CustomerInfo").text("--");

                    return;

                }


                /*
                 * Get Customer Information
                 */

                $.ajax({

                    url: '@Url.Action("GetCustomerInfo", "Appointment")',

                    type: "GET",

                    data: {
                        id: customerId
                    },

                    success: function (data) {

                        if (data) {

                            $("#Location")
                                .val(data.location || "");

                            $("#CustomerInfo")
                                .text(data.phone || "--");

                        }
                        else {

                            $("#Location").val("");

                            $("#CustomerInfo").text("--");

                        }

                    },

                    error: function () {

                        console.log("Customer information load error.");

                    }

                });

            });

        });

    </script>
}