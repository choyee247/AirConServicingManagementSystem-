@model IEnumerable<AirConServicingManagementSystem.Models.TechnicianSchedulePlan>

@{
    ViewData["Title"] = "Calendar";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Modern Icons & FullCalendar -->
<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>

<!-- Google Font (Inter) for modern look -->
<link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet" />

<div class="container-fluid px-3 px-md-4 py-4" style="font-family: 'Inter', sans-serif; background: #f0f6f9; min-height: 100vh;">

    <!-- ====== HEADER with Glass effect ====== -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3 p-4 rounded-4"
         style="background: rgba(255, 255, 255, 0.65); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
                border: 1px solid rgba(255,255,255,0.6); box-shadow: 0 8px 32px rgba(44, 140, 153, 0.10);">

        <div>
            <h4 class="fw-bold mb-1 d-flex align-items-center gap-2" style="color: #1d5e66;">
                <span class="rounded-circle d-inline-flex align-items-center justify-content-center"
                      style="width: 42px; height: 42px; background: linear-gradient(135deg, #2c8c99, #1d6b75); color: white; box-shadow: 0 4px 12px rgba(44,140,153,0.3);">
                    <i class="fas fa-calendar-check"></i>
                </span>
                Technician Schedule
            </h4>
            <p class="text-muted small mb-0 ms-1" style="letter-spacing: 0.3px;">
                <i class="fas fa-circle me-1" style="color: #2c8c99; font-size: 6px; vertical-align: middle;"></i>
                Drag, click & manage all technician plans
            </p>
        </div>

        <!-- Neumorphic Create Button -->
        <a asp-controller="AdminService"
           asp-action="CreatePlan"
           class="btn text-white fw-semibold px-5 py-3 rounded-pill shadow-lg"
           style="background: linear-gradient(145deg, #2c8c99, #1e6f7a);
                  border: none;
                  box-shadow: 0 6px 20px rgba(44, 140, 153, 0.35), inset 0 1px 2px rgba(255,255,255,0.3);
                  transition: all 0.2s ease; letter-spacing: 0.5px;">
            <i class="fas fa-plus-circle me-2"></i> Create Plan
        </a>
    </div>

    <!-- ====== SUCCESS ALERT (Soft glass) ====== -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-dismissible fade show rounded-4 border-0 shadow-sm d-flex align-items-center gap-3 p-3 mb-4"
             style="background: rgba(44, 140, 153, 0.08); backdrop-filter: blur(4px); border-left: 5px solid #2c8c99; color: #1a5f66;">
            <i class="fas fa-check-circle fs-4" style="color: #2c8c99;"></i>
            <span class="fw-medium">@TempData["SuccessMessage"]</span>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- ====== CALENDAR CARD (Glassmorphism) ====== -->
    <div class="card border-0 rounded-4 shadow-lg mb-4 overflow-hidden"
         style="background: rgba(255, 255, 255, 0.60); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
                border: 1px solid rgba(255, 255, 255, 0.7); box-shadow: 0 12px 40px rgba(44, 140, 153, 0.08);">
        <div class="card-body p-3 p-md-4">
            <div id="calendar" style="min-height: 480px;"></div>
        </div>
    </div>

    <!-- ====== SCHEDULE LIST (Modern Neumorphic card) ====== -->
    <div class="card border-0 rounded-4 shadow-lg overflow-hidden"
         style="background: rgba(255, 255, 255, 0.55); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
                border: 1px solid rgba(255, 255, 255, 0.6); box-shadow: 0 12px 40px rgba(44, 140, 153, 0.06);">

        <div class="card-header bg-transparent border-0 d-flex flex-wrap align-items-center justify-content-between py-3 px-3 px-md-4"
             style="border-bottom: 1px solid rgba(44, 140, 153, 0.10);">
            <h5 class="mb-0 fw-bold d-flex align-items-center gap-2" style="color: #1d5e66;">
                <i class="fas fa-list-check" style="color: #2c8c99;"></i>
                Schedule Plan List
            </h5>
            <span class="badge rounded-pill px-4 py-2 fw-semibold"
                  style="background: rgba(44, 140, 153, 0.12); color: #1d5e66; border: 1px solid rgba(44,140,153,0.15);">
                <i class="far fa-calendar-alt me-1"></i> @(Model?.Count() ?? 0) plans
            </span>
        </div>

        <div class="card-body p-0 p-md-2">
            <div class="table-responsive px-2 px-md-3">
                <table class="table table-hover align-middle mb-0" style="min-width: 620px; font-size: 0.9rem;">
                    <thead style="background: rgba(44, 140, 153, 0.04); border-bottom: 2px solid rgba(44, 140, 153, 0.10);">
                        <tr>
                            <th class="ps-3 ps-md-4 py-3 fw-semibold" style="color: #1d5e66;"><i class="fas fa-user-cog me-2" style="color: #2c8c99;"></i> Technician</th>
                            <th class="fw-semibold" style="color: #1d5e66;"><i class="fas fa-user me-2" style="color: #2c8c99;"></i> Customer</th>
                            <th class="d-none d-sm-table-cell fw-semibold" style="color: #1d5e66;"><i class="fas fa-location-dot me-2" style="color: #2c8c99;"></i> Location</th>
                            <th class="fw-semibold" style="color: #1d5e66;"><i class="far fa-clock me-2" style="color: #2c8c99;"></i> Planned</th>
                            <th class="fw-semibold" style="color: #1d5e66;"><i class="fas fa-circle me-2" style="color: #2c8c99; font-size: 8px;"></i> Status</th>
                            <th class="d-none d-lg-table-cell fw-semibold" style="color: #1d5e66;"><i class="fas fa-pen me-2" style="color: #2c8c99;"></i> Note</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                var statusColor = item.Status switch
                                {
                                    "Completed" => "#27ae60",
                                    "In Progress" => "#f39c12",
                                    _ => "#2c8c99"
                                };
                                var statusIcon = item.Status switch
                                {
                                    "Completed" => "fa-check-circle",
                                    "In Progress" => "fa-spinner fa-pulse",
                                    _ => "fa-clock"
                                };
                                <tr class="border-bottom" style="border-color: rgba(44,140,153,0.05) !important;">
                                    <td class="ps-3 ps-md-4 py-3">
                                        <span class="fw-semibold" style="color: #1d5e66;">@item.Technician?.Name</span>
                                    </td>
                                    <td>@item.CustomerName</td>
                                    <td class="d-none d-sm-table-cell">@item.Location</td>
                                    <td>
                                        <span class="badge bg-white text-dark fw-normal px-3 py-2 rounded-pill shadow-sm"
                                              style="border: 1px solid rgba(44,140,153,0.15); font-size: 0.75rem;">
                                            @item.PlannedDate.ToString("dd MMM yyyy hh:mm tt")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge rounded-pill px-3 py-2 fw-semibold"
                                              style="background: @statusColor; color: white; box-shadow: 0 2px 8px rgba(0,0,0,0.05);">
                                            <i class="fas @statusIcon me-1"></i> @item.Status
                                        </span>
                                    </td>
                                    <td class="d-none d-lg-table-cell text-truncate" style="max-width: 140px; color: #3d6b73;">@item.Notes</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5">
                                    <i class="far fa-calendar-plus fa-3x d-block mb-3" style="color: #b8d9de;"></i>
                                    <span style="font-weight: 500; color: #3d6b73;">No schedule plans available</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ===== FULLCALENDAR SCRIPT (Modern) ===== -->
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var calendarEl = document.getElementById('calendar');

        var calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            height: 'auto',
            contentHeight: 'auto',
            aspectRatio: 1.4,

            headerToolbar: {
                left: 'prev,next',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek'
            },

            events: '/AdminService/GetPlans',

            eventColor: '#2c8c99',
            eventTextColor: '#ffffff',
            eventBorderColor: 'transparent',
            eventBackgroundColor: '#2c8c99',

            // Modern soft shadow on events
            eventClassNames: ['fw-semibold', 'shadow-sm'],

            eventClick: function (info) {
                if (info.event.url) {
                    window.location.href = info.event.url;
                    info.jsEvent.preventDefault();
                }
            },

            // Responsive + modern touches
            views: {
                timeGridWeek: {
                    titleFormat: { year: 'numeric', month: 'short', day: 'numeric' }
                }
            }
        });

        calendar.render();

        // Reflow on resize
        let resizeTimer;
        window.addEventListener('resize', function () {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(() => calendar.updateSize(), 100);
        });
    });
</script>

<!-- ====== CUSTOM STYLES : Modern Glass + Neumorphism ====== -->
<style>
    /* Global reset */
    * {
        font-family: 'Inter', sans-serif;
    }

    body {
        background: #eef5f8;
    }

    /* Glassmorphism card base */
    .card {
        transition: transform 0.15s ease, box-shadow 0.2s ease;
    }

        .card:hover {
            transform: translateY(-2px);
            box-shadow: 0 20px 50px rgba(44, 140, 153, 0.10) !important;
        }

    /* Neumorphic button effect */
    .btn {
        transition: all 0.2s ease;
    }

        .btn:hover {
            transform: scale(1.02) translateY(-2px);
            box-shadow: 0 12px 28px rgba(44, 140, 153, 0.4) !important;
            background: linear-gradient(145deg, #1e6f7a, #155a63) !important;
        }

    /* FullCalendar modern overrides */
    .fc .fc-button-primary {
        background: #2c8c99 !important;
        border: none !important;
        box-shadow: 0 2px 8px rgba(44, 140, 153, 0.15);
        border-radius: 30px !important;
        padding: 0.4rem 1rem;
        font-weight: 500;
        transition: 0.15s;
    }

        .fc .fc-button-primary:hover {
            background: #1d6b75 !important;
            box-shadow: 0 4px 16px rgba(44, 140, 153, 0.25);
            transform: scale(0.97);
        }

        .fc .fc-button-primary:disabled {
            background: #9ac8cf !important;
            opacity: 0.7;
        }

    .fc .fc-toolbar-title {
        font-weight: 700;
        color: #1a5f66;
        font-size: 1.3rem;
        letter-spacing: -0.3px;
    }

    .fc .fc-col-header-cell-cushion {
        color: #1d5e66;
        font-weight: 600;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        opacity: 0.8;
    }

    .fc .fc-daygrid-day-number {
        color: #1d5e66;
        font-weight: 500;
    }

    .fc .fc-daygrid-day.fc-day-today {
        background: rgba(44, 140, 153, 0.06) !important;
        border-radius: 8px;
    }

    .fc .fc-daygrid-day {
        border-radius: 6px;
        transition: background 0.1s;
    }

        .fc .fc-daygrid-day:hover {
            background: rgba(44, 140, 153, 0.02);
        }

    /* Event pill style */
    .fc .fc-event {
        border-radius: 40px !important;
        border: none !important;
        padding: 2px 10px !important;
        font-weight: 500;
        font-size: 0.78rem;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(44, 140, 153, 0.15);
        transition: 0.1s;
        background: #2c8c99 !important;
    }

        .fc .fc-event:hover {
            opacity: 0.9;
            box-shadow: 0 4px 16px rgba(44, 140, 153, 0.25);
            transform: scale(0.98);
        }

    /* Responsive fine-tune */
    @@media (max-width: 576px) {
        .fc .fc-header-toolbar {
            flex-direction: column;
            gap: 0.5rem;
        }

        .fc .fc-toolbar-title {
            font-size: 1rem !important;
        }

        .fc .fc-button {
            font-size: 0.7rem;
            padding: 0.2rem 0.7rem;
        }

        .fc .fc-daygrid-day-number {
            font-size: 0.75rem;
        }

        .table-responsive .table {
            font-size: 0.78rem;
        }

        .table td, .table th {
            padding: 0.4rem 0.2rem;
        }

        .badge.py-2 {
            padding: 0.25rem 0.6rem !important;
            font-size: 0.7rem;
        }

        .rounded-4 {
            border-radius: 1rem !important;
        }
    }

    @@media (max-width: 768px) {
        .fc .fc-toolbar-title {
            font-size: 1.1rem;
        }

        .card-body {
            padding: 0.8rem !important;
        }
    }

    /* Scroll bar modern */
    ::-webkit-scrollbar {
        width: 5px;
        height: 5px;
    }

    ::-webkit-scrollbar-track {
        background: rgba(44, 140, 153, 0.03);
    }

    ::-webkit-scrollbar-thumb {
        background: #2c8c99;
        border-radius: 30px;
    }
</style>