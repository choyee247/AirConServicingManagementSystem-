@model IEnumerable<AirConServicingManagementSystem.Models.TechnicianSchedulePlan>

@{
    ViewData["Title"] = "Technician Schedule";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var plans = Model?.ToList() ?? new List<AirConServicingManagementSystem.Models.TechnicianSchedulePlan>();

    var totalPlans = plans.Count;
    var pendingPlans = plans.Count(x => x.Status == "Pending");
    var progressPlans = plans.Count(x => x.Status == "In Progress");
    var completedPlans = plans.Count(x => x.Status == "Completed");
}

<link rel="stylesheet" href="~/fontawesome/css/all.min650.css" />
<script src="~/fontawesome/css/fullcalendar6115.js"></script>

<style>

    :root {
        --primary: #2c8c99;
        --primary-dark: #1f707a;
        --soft: #eef8fa;
        --text: #234b52;
        --muted: #71858a;
    }

    body {
        background: #f4f8f9;
    }

    .schedule-page {
        padding: 20px;
    }

    /* HEADER */

    .page-header {
        background: #ffffff;
        border-radius: 16px;
        padding: 18px 22px;
        margin-bottom: 18px;
        border: 1px solid #e5eef0;
        box-shadow: 0 5px 20px rgba(44, 140, 153, .07);
    }

    .page-title {
        display: flex;
        align-items: center;
        gap: 12px;
        color: var(--text);
        font-size: 1.35rem;
        font-weight: 700;
        margin: 0;
    }

    .page-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: var(--soft);
        color: var(--primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .page-subtitle {
        margin: 5px 0 0 54px;
        color: var(--muted);
        font-size: .85rem;
    }

    /* STAT CARDS */

    .stat-card {
        background: #fff;
        border: 1px solid #e5eef0;
        border-radius: 14px;
        padding: 15px;
        height: 100%;
        box-shadow: 0 4px 15px rgba(44, 140, 153, .05);
    }

    .stat-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: var(--soft);
        color: var(--primary);
        display: flex;
        align-items: center;
        justify-content: center;
        float: left;
        margin-right: 12px;
    }

    .stat-title {
        color: var(--muted);
        font-size: .75rem;
        margin-bottom: 2px;
    }

    .stat-number {
        color: var(--text);
        font-size: 1.35rem;
        font-weight: 700;
    }

    /* CARDS */

    .content-card {
        background: #fff;
        border: 1px solid #e5eef0;
        border-radius: 16px;
        box-shadow: 0 5px 20px rgba(44, 140, 153, .06);
        overflow: hidden;
    }

    .card-header-custom {
        padding: 15px 18px;
        border-bottom: 1px solid #edf2f3;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .card-title-custom {
        color: var(--text);
        font-size: .95rem;
        font-weight: 700;
        margin: 0;
    }

    .count-badge {
        background: var(--soft);
        color: var(--primary-dark);
        padding: 5px 10px;
        border-radius: 20px;
        font-size: .72rem;
        font-weight: 600;
    }

    .calendar-body {
        padding: 15px;
    }

    #calendar {
        width: 100%;
    }

    /* TABLE */

    .table-wrap {
        overflow-x: auto;
    }

    .schedule-table {
        width: 100%;
        min-width: 750px;
        border-collapse: collapse;
    }

        .schedule-table th {
            background: #f8fbfc;
            color: #527178;
            font-size: .72rem;
            font-weight: 700;
            text-transform: uppercase;
            padding: 11px 14px;
            border-bottom: 1px solid #e5eef0;
            white-space: nowrap;
        }

        .schedule-table td {
            padding: 12px 14px;
            border-bottom: 1px solid #edf2f3;
            font-size: .84rem;
            vertical-align: middle;
        }

        .schedule-table tbody tr:hover {
            background: #fbfeff;
        }

    .tech-name {
        font-weight: 600;
        color: var(--text);
    }

    .customer-name {
        font-weight: 500;
        color: #344f55;
    }

    .location-text {
        color: #687e83;
        max-width: 180px;
    }

    .date-text {
        white-space: nowrap;
        color: #415e64;
        font-size: .78rem;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: .7rem;
        font-weight: 600;
    }

    .status-pending {
        background: #fff4d8;
        color: #9a6a00;
    }

    .status-progress {
        background: #e7f4f7;
        color: #247785;
    }

    .status-completed {
        background: #e7f7ee;
        color: #26804b;
    }

    .note-text {
        max-width: 180px;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
        color: #71858a;
    }

    /* FULLCALENDAR */

    .fc {
        font-size: .85rem;
    }

        .fc .fc-toolbar-title {
            color: var(--text);
            font-size: 1.1rem;
            font-weight: 700;
        }

        .fc .fc-button-primary {
            background: var(--primary);
            border-color: var(--primary);
            border-radius: 8px;
            font-size: .75rem;
        }

            .fc .fc-button-primary:hover {
                background: var(--primary-dark);
                border-color: var(--primary-dark);
            }

        .fc .fc-daygrid-day-number {
            color: var(--text);
            font-size: .78rem;
        }

        .fc .fc-event {
            border: none;
            border-radius: 6px;
            padding: 2px 5px;
            font-size: .7rem;
        }

        .fc .fc-daygrid-day.fc-day-today {
            background: rgba(44, 140, 153, .06);
        }

    /* EMPTY */

    .empty-state {
        text-align: center;
        padding: 45px 20px;
        color: var(--muted);
    }

        .empty-state i {
            font-size: 38px;
            color: #b8d9de;
            margin-bottom: 12px;
        }

    /* MOBILE */

    @@media (max-width: 768px) {

        .schedule-page {
            padding: 10px;
        }

        .page-header {
            padding: 14px;
        }

        .page-title {
            font-size: 1.1rem;
        }

        .page-subtitle {
            margin-left: 0;
            margin-top: 8px;
        }

        .stat-card {
            padding: 12px;
        }

        .stat-number {
            font-size: 1.1rem;
        }

        .calendar-body {
            padding: 8px;
        }

        .fc .fc-toolbar {
            flex-wrap: wrap;
            gap: 8px;
        }

        .fc .fc-toolbar-title {
            font-size: .9rem;
        }
    }

</style>


<div class="schedule-page">

    <!-- HEADER -->

    <div class="page-header">

        <h2 class="page-title">

            <span class="page-icon">
                <i class="fas fa-calendar-check"></i>
            </span>

            Technician Schedule

        </h2>

        <p class="page-subtitle">
            View and monitor technician service schedules
        </p>

    </div>


    <!-- STATISTICS -->

    <div class="row g-3 mb-3">

        <div class="col-6 col-md-3">

            <div class="stat-card">

                <div class="stat-icon">
                    <i class="fas fa-calendar"></i>
                </div>

                <div class="stat-title">
                    Total Plans
                </div>

                <div class="stat-number">
                    @totalPlans
                </div>

            </div>

        </div>


        <div class="col-6 col-md-3">

            <div class="stat-card">

                <div class="stat-icon">
                    <i class="fas fa-clock"></i>
                </div>

                <div class="stat-title">
                    Pending
                </div>

                <div class="stat-number">
                    @pendingPlans
                </div>

            </div>

        </div>


        <div class="col-6 col-md-3">

            <div class="stat-card">

                <div class="stat-icon">
                    <i class="fas fa-spinner"></i>
                </div>

                <div class="stat-title">
                    In Progress
                </div>

                <div class="stat-number">
                    @progressPlans
                </div>

            </div>

        </div>


        <div class="col-6 col-md-3">

            <div class="stat-card">

                <div class="stat-icon">
                    <i class="fas fa-check-circle"></i>
                </div>

                <div class="stat-title">
                    Completed
                </div>

                <div class="stat-number">
                    @completedPlans
                </div>

            </div>

        </div>

    </div>


    <!-- CALENDAR -->

    <div class="content-card mb-3">

        <div class="card-header-custom">

            <h5 class="card-title-custom">
                <i class="fas fa-calendar-days me-2"
                   style="color:#2c8c99;"></i>

                Schedule Calendar
            </h5>

            <span class="count-badge">
                @totalPlans Plans
            </span>

        </div>

        <div class="calendar-body">

            <div id="calendar"></div>

        </div>

    </div>


    <!-- SCHEDULE LIST -->

    <div class="content-card">

        <div class="card-header-custom">

            <h5 class="card-title-custom">

                <i class="fas fa-list-check me-2"
                   style="color:#2c8c99;"></i>

                Schedule Plan List

            </h5>

            <span class="count-badge">
                @totalPlans Records
            </span>

        </div>


        <div class="table-wrap">

            @if (plans.Any())
            {
                <table class="schedule-table">

                    <thead>

                        <tr>

                            <th>
                                Technician
                            </th>

                            <th>
                                Customer
                            </th>

                            <th>
                                Location
                            </th>

                            <th>
                                Planned Date
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Notes
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item in plans)
                        {
                            var statusClass =
                            item.Status == "Completed"
                            ? "status-completed"
                            : item.Status == "In Progress"
                            ? "status-progress"
                            : "status-pending";

                            var statusIcon =
                            item.Status == "Completed"
                            ? "fa-check"
                            : item.Status == "In Progress"
                            ? "fa-spinner"
                            : "fa-clock";

                            <tr>

                                <td>

                                    <span class="tech-name">
                                        <i class="fas fa-user-cog me-1"
                                           style="color:#2c8c99;"></i>

                                        @item.Technician?.Name
                                    </span>

                                </td>


                                <td>

                                    <span class="customer-name">
                                        @item.CustomerName
                                    </span>

                                </td>


                                <td>

                                    <span class="location-text">
                                        @item.Location
                                    </span>

                                </td>


                                <td>

                                    <span class="date-text">

                                        <i class="far fa-calendar me-1"
                                           style="color:#2c8c99;"></i>

                                        @item.PlannedDate.ToString(
                                        "dd MMM yyyy, hh:mm tt")

                            </span>

                        </td>


                        <td>

                            <span class="status-badge @statusClass">

                                <i class="fas @statusIcon"></i>

                                @item.Status

                            </span>

                        </td>


                        <td>

                            <span class="note-text"
                                  title="@item.Notes">

                                @item.Notes

                            </span>

                        </td>

                    </tr>
                                        }

                    </tbody>

                </table>
            }
            else
            {
                <div class="empty-state">

                    <i class="far fa-calendar-plus d-block"></i>

                    <div>
                        No technician schedules available.
                    </div>

                    <small>
                        Assigned appointments will appear here automatically.
                    </small>

                </div>
            }

        </div>

    </div>

</div>


<script>

    document.addEventListener('DOMContentLoaded', function () {

        const calendarEl = document.getElementById('calendar');

        const calendar = new FullCalendar.Calendar(calendarEl, {

            initialView: 'dayGridMonth',

            height: 'auto',

            contentHeight: 'auto',

            aspectRatio: 1.5,

            headerToolbar: {

                left: 'prev,next today',

                center: 'title',

                right: 'dayGridMonth,timeGridWeek'

            },

            events: '/AdminService/GetPlans',

            eventColor: '#2c8c99',

            eventTextColor: '#ffffff',

            eventBorderColor: 'transparent',

            eventClick: function (info) {

                if (info.event.url) {

                    info.jsEvent.preventDefault();

                    window.location.href = info.event.url;

                }

            },

            views: {

                timeGridWeek: {

                    titleFormat: {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric'
                    }

                }

            }

        });

        calendar.render();

    });

</script>