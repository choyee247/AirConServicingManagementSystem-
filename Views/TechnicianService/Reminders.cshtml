@{
    ViewData["Title"] = "Reminder";
    Layout = "~/Views/Shared/_TechnicianLayout.cshtml";
}
@model List<ServiceReminder>

<style>
    :root {
        --primary-color: #2c8c99;
        --primary-dark: #1a6b77;
        --primary-light: #4ca6b3;
        --primary-soft: rgba(44, 140, 153, 0.08);
        --primary-opacity-10: rgba(44, 140, 153, 0.10);
        --font-base: 17px;
    }

    /* ----- Base ----- */
    body {
        font-size: var(--font-base);
    }

    .container {
        padding: 16px 14px !important;
        max-width: 100% !important;
    }

    /* ----- Page Header ----- */
    .page-header {
        margin-bottom: 1.5rem;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 0.8rem;
    }

        .page-header .section-title {
            font-size: 1.6rem;
            font-weight: 700;
            color: var(--primary-color);
            display: flex;
            align-items: center;
            gap: 0.6rem;
            margin-bottom: 0;
        }

            .page-header .section-title i {
                font-size: 1.5rem;
            }

        .page-header .reminder-count {
            background: var(--primary-opacity-10);
            color: var(--primary-color);
            padding: 0.3rem 1.2rem;
            border-radius: 60px;
            font-weight: 600;
            font-size: 0.9rem;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

    /* ----- Reminder Card ----- */
    .reminder-card {
        background: white;
        border-radius: 20px;
        padding: 1.2rem 1.2rem;
        margin-bottom: 1rem;
        border: 1px solid rgba(44, 140, 153, 0.06);
        box-shadow: 0 4px 16px rgba(44, 140, 153, 0.06);
        transition: 0.2s;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 0.8rem;
    }

        .reminder-card:hover {
            box-shadow: 0 8px 28px rgba(44, 140, 153, 0.10);
            transform: translateY(-2px);
        }

        .reminder-card .reminder-info {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 0.6rem;
            flex: 1;
            min-width: 200px;
        }

            .reminder-card .reminder-info .customer-name {
                font-size: 1.05rem;
                font-weight: 600;
                color: #1e293b;
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

                .reminder-card .reminder-info .customer-name i {
                    color: var(--primary-color);
                    font-size: 1rem;
                }

            .reminder-card .reminder-info .reminder-type {
                font-size: 0.85rem;
                color: #6c757d;
                background: #f8f9fa;
                padding: 0.15rem 0.8rem;
                border-radius: 40px;
                border: 1px solid #e9ecef;
            }

            .reminder-card .reminder-info .reminder-date {
                font-size: 0.85rem;
                font-weight: 600;
                color: var(--primary-color);
                background: var(--primary-opacity-10);
                padding: 0.15rem 0.9rem;
                border-radius: 40px;
                display: inline-flex;
                align-items: center;
                gap: 0.4rem;
                white-space: nowrap;
            }

                .reminder-card .reminder-info .reminder-date i {
                    font-size: 0.8rem;
                }

        .reminder-card .reminder-actions {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
            align-items: center;
        }

    /* ----- Buttons ----- */
    .btn-reminder {
        padding: 0.45rem 1.2rem;
        border-radius: 60px;
        font-weight: 600;
        font-size: 0.85rem;
        border: none;
        transition: 0.2s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        cursor: pointer;
        white-space: nowrap;
    }

        .btn-reminder:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 16px rgba(0,0,0,0.12);
        }

        .btn-reminder:active {
            transform: translateY(0);
        }

    .btn-done {
        background: #28a745;
        color: white;
    }

        .btn-done:hover {
            background: #1e7e34;
            color: white;
        }

    .btn-reassign {
        background: #ffc107;
        color: #1e2a32;
    }

        .btn-reassign:hover {
            background: #e0a800;
            color: #1e2a32;
        }

    /* ----- Empty State ----- */
    .empty-state {
        text-align: center;
        padding: 3rem 1rem;
        background: white;
        border-radius: 20px;
        border: 1px solid rgba(44, 140, 153, 0.06);
        box-shadow: 0 4px 16px rgba(44, 140, 153, 0.04);
    }

        .empty-state i {
            font-size: 4rem;
            color: var(--primary-color);
            opacity: 0.2;
        }

        .empty-state h4 {
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--primary-color);
            margin-top: 0.8rem;
            margin-bottom: 0.3rem;
        }

        .empty-state p {
            font-size: 0.95rem;
            color: #6c757d;
            margin-bottom: 0;
        }

    /* ----- Responsive ----- */
    @@media (max-width: 992px) {
        .container

    {
        padding: 12px 10px !important;
    }

    .page-header .section-title {
        font-size: 1.3rem;
    }

        .page-header .section-title i {
            font-size: 1.2rem;
        }

    .page-header .reminder-count {
        font-size: 0.8rem;
        padding: 0.25rem 1rem;
    }

    .reminder-card {
        padding: 1rem 1rem;
    }

        .reminder-card .reminder-info .customer-name {
            font-size: 0.95rem;
        }

        .reminder-card .reminder-info .reminder-type {
            font-size: 0.78rem;
        }

        .reminder-card .reminder-info .reminder-date {
            font-size: 0.78rem;
            padding: 0.1rem 0.7rem;
        }

    .btn-reminder {
        font-size: 0.78rem;
        padding: 0.35rem 1rem;
    }

    }

    @@media (max-width: 768px) {
        body

    {
        font-size: 16px;
    }

    .container {
        padding: 10px 6px !important;
    }

    .page-header {
        flex-direction: column;
        align-items: flex-start;
    }

        .page-header .section-title {
            font-size: 1.1rem;
        }

            .page-header .section-title i {
                font-size: 1rem;
            }

        .page-header .reminder-count {
            font-size: 0.7rem;
            padding: 0.2rem 0.8rem;
            align-self: flex-start;
        }

    .reminder-card {
        padding: 0.8rem 0.8rem;
        border-radius: 16px;
        flex-direction: column;
        align-items: stretch;
        gap: 0.6rem;
    }

        .reminder-card .reminder-info {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.4rem;
            min-width: unset;
        }

            .reminder-card .reminder-info .customer-name {
                font-size: 0.9rem;
            }

            .reminder-card .reminder-info .reminder-type {
                font-size: 0.72rem;
                padding: 0.1rem 0.6rem;
            }

            .reminder-card .reminder-info .reminder-date {
                font-size: 0.72rem;
                padding: 0.1rem 0.6rem;
            }

        .reminder-card .reminder-actions {
            width: 100%;
            justify-content: stretch;
        }

            .reminder-card .reminder-actions form {
                flex: 1;
                min-width: 0;
            }

    .btn-reminder {
        font-size: 0.72rem;
        padding: 0.3rem 0.8rem;
        width: 100%;
        justify-content: center;
    }

    .empty-state {
        padding: 2rem 0.8rem;
        border-radius: 16px;
    }

        .empty-state i {
            font-size: 3rem;
        }

        .empty-state h4 {
            font-size: 1.1rem;
        }

        .empty-state p {
            font-size: 0.85rem;
        }

    }

    @@media (max-width: 480px) {
        body

    {
        font-size: 15px;
    }

    .container {
        padding: 6px 3px !important;
    }

    .page-header .section-title {
        font-size: 0.95rem;
    }

        .page-header .section-title i {
            font-size: 0.85rem;
        }

    .page-header .reminder-count {
        font-size: 0.6rem;
        padding: 0.15rem 0.6rem;
    }

    .reminder-card {
        padding: 0.5rem 0.5rem;
        border-radius: 12px;
        gap: 0.4rem;
    }

        .reminder-card .reminder-info .customer-name {
            font-size: 0.8rem;
        }

            .reminder-card .reminder-info .customer-name i {
                font-size: 0.75rem;
            }

        .reminder-card .reminder-info .reminder-type {
            font-size: 0.6rem;
            padding: 0.05rem 0.5rem;
        }

        .reminder-card .reminder-info .reminder-date {
            font-size: 0.6rem;
            padding: 0.05rem 0.5rem;
        }

            .reminder-card .reminder-info .reminder-date i {
                font-size: 0.6rem;
            }

    .btn-reminder {
        font-size: 0.6rem;
        padding: 0.2rem 0.6rem;
    }

    .empty-state {
        padding: 1.5rem 0.5rem;
        border-radius: 12px;
    }

        .empty-state i {
            font-size: 2.5rem;
        }

        .empty-state h4 {
            font-size: 0.95rem;
        }

        .empty-state p {
            font-size: 0.75rem;
        }

    }

    /* ----- Dark Mode ----- */
    [data-bs-theme="dark"] .reminder-card {
        background: #2d2d2d !important;
        border-color: #495057 !important;
    }

        [data-bs-theme="dark"] .reminder-card .reminder-info .customer-name {
            color: #e0e0e0 !important;
        }

        [data-bs-theme="dark"] .reminder-card .reminder-info .reminder-type {
            background: #3d3d3d !important;
            border-color: #495057 !important;
            color: #a0a0a0 !important;
        }

        [data-bs-theme="dark"] .reminder-card .reminder-info .reminder-date {
            background: rgba(44, 140, 153, 0.15) !important;
            color: #7fcbd4 !important;
        }

    [data-bs-theme="dark"] .empty-state {
        background: #2d2d2d !important;
        border-color: #495057 !important;
    }

        [data-bs-theme="dark"] .empty-state h4 {
            color: #7fcbd4 !important;
        }

        [data-bs-theme="dark"] .empty-state p {
            color: #a0a0a0 !important;
        }

    [data-bs-theme="dark"] .page-header .reminder-count {
        background: rgba(44, 140, 153, 0.15) !important;
        color: #7fcbd4 !important;
    }

    /* ----- Loading Spinner ----- */
    .btn-reminder .spinner {
        display: none;
        width: 14px;
        height: 14px;
        border: 2px solid rgba(255,255,255,0.3);
        border-top-color: white;
        border-radius: 50%;
        animation: spin 0.6s linear infinite;
    }

    .btn-reminder.loading .spinner {
        display: inline-block;
    }

    .btn-reminder.loading .btn-text {
        opacity: 0.7;
    }

    .btn-reassign.loading .spinner {
        border-top-color: #1e2a32;
    }

    @@keyframes spin {
        to

    {
        transform: rotate(360deg);
    }

    }
</style>

<div class="container py-2 py-md-4">

    <!-- Page Header -->
    <div class="page-header">
        <div class="section-title">
            <i class="fas fa-clock"></i>
            Service Reminders
        </div>
        <span class="reminder-count">
            <i class="fas fa-bell me-1"></i>
            @(Model?.Count ?? 0) Reminders
        </span>
    </div>

    <!-- Reminder List -->
    @if (Model != null && Model.Count > 0)
    {
        @foreach (var item in Model)
        {
            <div class="reminder-card">

                <!-- Info -->
                <div class="reminder-info">
                    <span class="customer-name">
                        <i class="fas fa-user"></i>
                        @(item.Customer?.Name ?? "Unknown Customer")
                    </span>

                    <span class="reminder-type">
                        <i class="fas fa-tag me-1" style="color:var(--primary-color);"></i>
                        @(item.ReminderType ?? "Reminder")
                    </span>

                    <span class="reminder-date">
                        <i class="fas fa-calendar-alt"></i>
                        @item.ReminderDate?.ToString("dd MMM yyyy")
                    </span>
                </div>

                <!-- Actions -->
                <div class="reminder-actions">

                    <form asp-action="HandleReminder"
                          asp-controller="TechnicianService"
                          method="post"
                          class="reminder-form"
                          style="display:inline-block;flex:1;min-width:0;">

                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.Id" />

                        <button type="submit"
                                name="action"
                                value="Done"
                                class="btn-reminder btn-done">
                            <i class="fas fa-check"></i>
                            <span class="btn-text">Done</span>
                            <span class="spinner"></span>
                        </button>
                    </form>

                    <form asp-action="HandleReminder"
                          asp-controller="TechnicianService"
                          method="post"
                          class="reminder-form"
                          style="display:inline-block;flex:1;min-width:0;">

                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.Id" />

                        <button type="submit"
                                name="action"
                                value="ReAssign"
                                class="btn-reminder btn-reassign">
                            <i class="fas fa-redo"></i>
                            <span class="btn-text">ReAssign</span>
                            <span class="spinner"></span>
                        </button>
                    </form>

                </div>

            </div>
        }
    }
    else
    {
        <!-- Empty State -->
        <div class="empty-state">
            <i class="fas fa-bell-slash"></i>
            <h4>No Service Reminders</h4>
            <p>You don't have any service reminders at the moment.</p>
        </div>
    }

</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {

        // ============================================
        // LOADING SPINNER ON FORM SUBMIT
        // ============================================
        document.querySelectorAll('.reminder-form').forEach(form => {
            form.addEventListener('submit', function(e) {

                // Find the button that was clicked
                const button = this.querySelector('button[type="submit"]:focus') ||
                              this.querySelector('button[type="submit"]');

                if (button) {
                    // Add loading state
                    button.classList.add('loading');
                    button.disabled = true;

                    // Change button text
                    const btnText = button.querySelector('.btn-text');
                    if (btnText) {
                        const action = button.getAttribute('name') === 'action' ?
                                       button.value :
                                       'Processing';
                        btnText.textContent = action + '...';
                    }
                }

                // Prevent double submission
                const submitButtons = this.querySelectorAll('button[type="submit"]');
                submitButtons.forEach(btn => {
                    btn.disabled = true;
                });

            });
        });

        // ============================================
        // CONFIRM FOR REASSIGN
        // ============================================
        document.querySelectorAll('.btn-reassign').forEach(button => {
            button.addEventListener('click', function(e) {
                // Only if it's not already loading
                if (this.classList.contains('loading')) return;

                if (!confirm('Are you sure you want to reassign this reminder?')) {
                    e.preventDefault();
                    return false;
                }
            });
        });

        // ============================================
        // CONFIRM FOR DONE
        // ============================================
        document.querySelectorAll('.btn-done').forEach(button => {
            button.addEventListener('click', function(e) {
                if (this.classList.contains('loading')) return;

                if (!confirm('Mark this reminder as done?')) {
                    e.preventDefault();
                    return false;
                }
            });
        });

    });
</script>