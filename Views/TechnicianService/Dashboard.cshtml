@{
    ViewData["Title"] = "Technician Dashboard";
    Layout = "~/Views/Shared/_TechnicianLayout.cshtml";
}
@using System.Linq
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.5">
    <title>Technician Dashboard</title>
    <!-- Font Awesome 6 (Free) -->
    @* <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"> *@
    <link rel="stylesheet" href="~/fontawesome/css/600all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #f2f6fc;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            padding: 20px 16px;
            color: #1e293b;
            font-size: 17px;
        }

        /* ----- main container ----- */
        .dashboard-wrap {
            max-width: 1440px;
            margin: 0 auto;
        }

        /* ----- primary color #2c8c99 ----- */
        :root {
            --primary: #2c8c99;
            --primary-light: #4ca6b3;
            --primary-dark: #1a6b77;
            --primary-soft: rgba(44, 140, 153, 0.08);
        }

        /* ----- cards & shadows ----- */
        .card-modern {
            background: #ffffff;
            border-radius: 24px;
            padding: 1.8rem 1.5rem;
            box-shadow: 0 4px 16px rgba(44, 140, 153, 0.06);
            transition: transform 0.2s ease, box-shadow 0.25s ease;
            border: 1px solid rgba(44, 140, 153, 0.06);
            height: 100%;
        }

            .card-modern:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 28px rgba(44, 140, 153, 0.10);
            }

        /* ----- header ----- */
        .dashboard-header {
            background: #ffffff;
            border-radius: 24px;
            padding: 1.5rem 2rem;
            margin-bottom: 1.8rem;
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 18px rgba(44, 140, 153, 0.06);
            border-left: 6px solid #2c8c99;
            gap: 1rem;
        }

        .header-title {
            font-size: 2rem;
            font-weight: 700;
            letter-spacing: -0.3px;
            color: #0f2b33;
        }

            .header-title i {
                color: #2c8c99;
                margin-right: 10px;
            }

        .header-sub {
            color: #5d6f7e;
            font-size: 1rem;
            font-weight: 500;
            margin-top: 4px;
        }

        .header-date {
            background: #f0f7fa;
            padding: 0.5rem 1.6rem;
            border-radius: 60px;
            font-weight: 600;
            font-size: 0.95rem;
            color: #1f4b54;
            border: 1px solid #d7e8ed;
            white-space: nowrap;
        }

            .header-date i {
                margin-right: 6px;
                color: #2c8c99;
            }

        /* ----- stat cards ----- */
        .stat-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1rem;
            margin-bottom: 1.8rem;
        }

        .stat-card {
            background: #fff;
            border-radius: 22px;
            padding: 1.2rem 1.2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-left: 6px solid #2c8c99;
            box-shadow: 0 4px 14px rgba(44, 140, 153, 0.06);
            transition: 0.2s;
            min-height: 90px;
        }

            .stat-card:hover {
                background: #fafdff;
                box-shadow: 0 8px 24px rgba(44, 140, 153, 0.10);
            }

        .stat-left .stat-label {
            font-size: 0.9rem;
            font-weight: 600;
            color: #5f7a88;
            letter-spacing: 0.3px;
        }

        .stat-left .stat-number {
            font-size: 2.8rem;
            font-weight: 800;
            color: #0a2e38;
            line-height: 1.2;
        }

        .stat-left .stat-sub {
            font-size: 0.8rem;
            color: #889ea8;
            font-weight: 500;
        }

        .stat-icon {
            width: 54px;
            height: 54px;
            background: rgba(44, 140, 153, 0.10);
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #2c8c99;
            font-size: 1.8rem;
            flex-shrink: 0;
        }

        /* row: progress + quick */
        .row-grid-2 {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 1.5rem;
            margin-bottom: 1.8rem;
        }

        .progress-wrapper {
            margin-top: 0.3rem;
        }

        .progress-track {
            background: #e7edf2;
            border-radius: 40px;
            height: 12px;
            overflow: hidden;
            margin-top: 8px;
        }

        .progress-fill {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, #2c8c99, #47b5c4);
            border-radius: 40px;
            transition: width 0.4s;
        }

        .quick-btn {
            display: block;
            width: 100%;
            padding: 0.8rem;
            border-radius: 60px;
            border: 1.5px solid #dce9ef;
            background: white;
            font-weight: 600;
            font-size: 0.95rem;
            color: #1f4b54;
            transition: 0.2s;
            margin-bottom: 0.7rem;
            text-align: center;
            text-decoration: none;
        }

            .quick-btn i {
                margin-right: 10px;
                color: #2c8c99;
            }

            .quick-btn:hover {
                background: #2c8c99;
                color: white;
                border-color: #2c8c99;
                text-decoration: none;
            }

                .quick-btn:hover i {
                    color: white;
                }

        /* ----- sections ----- */
        .section-title {
            font-size: 1.3rem;
            font-weight: 700;
            color: #12343e;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.6rem;
            flex-wrap: wrap;
        }

            .section-title i {
                color: #2c8c99;
                font-size: 1.3rem;
            }

        .grid-2col {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
            margin-bottom: 1.8rem;
        }

        .reminder-item, .appointment-item, .complaint-item, .feedback-item {
            background: #f8fbfd;
            border-radius: 16px;
            padding: 0.8rem 1rem;
            margin-bottom: 0.6rem;
            border-left: 4px solid #2c8c99;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.4rem;
            font-size: 0.95rem;
        }

            .reminder-item .badge-priority {
                background: #f1c40f;
                padding: 0.15rem 0.8rem;
                border-radius: 30px;
                font-size: 0.7rem;
                font-weight: 700;
                color: #1e2a32;
            }

        .badge-high {
            background: #e67e22;
            color: white;
        }

        .badge-low {
            background: #3498db;
            color: white;
        }

        .appointment-item .appt-time {
            font-weight: 600;
            color: #2c8c99;
            font-size: 0.85rem;
        }

        .complaint-item .complaint-status {
            padding: 0.15rem 0.9rem;
            border-radius: 40px;
            font-size: 0.7rem;
            font-weight: 700;
            white-space: nowrap;
        }

        .status-new {
            background: #e67e22;
            color: white;
        }

        .status-progress {
            background: #2980b9;
            color: white;
        }

        .status-resolved {
            background: #27ae60;
            color: white;
        }

        .feedback-item .stars {
            color: #f1c40f;
            letter-spacing: 2px;
            font-size: 0.9rem;
        }

        .task-badge {
            background: #2c8c99;
            color: white;
            padding: 0.15rem 1.2rem;
            border-radius: 60px;
            font-weight: 600;
            font-size: 0.85rem;
        }

        .daily-job-list {
            margin-top: 0.5rem;
        }

        .daily-job-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.8rem 0.6rem;
            border-bottom: 1px solid #eee;
            gap: 0.6rem;
            font-size: 0.95rem;
        }

            .daily-job-item:last-child {
                border-bottom: none;
            }

        .job-main {
            display: flex;
            align-items: center;
            gap: 10px;
            flex: 1;
            min-width: 0;
        }

        .job-text {
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        .job-title {
            font-weight: 600;
            color: #1f2e3a;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 250px;
            font-size: 0.95rem;
        }

        .job-meta {
            font-size: 0.8rem;
            display: flex;
            gap: 8px;
            color: #666;
        }

        .job-time {
            font-weight: 600;
            color: #2c8c99;
            white-space: nowrap;
            font-size: 0.9rem;
        }

        .empty-state {
            color: #888;
            padding: 12px;
            text-align: center;
            font-size: 0.9rem;
        }

        /* table */
        .table-wrap {
            overflow-x: auto;
            margin-top: 0.5rem;
            -webkit-overflow-scrolling: touch;
        }

        .table-custom {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.95rem;
            min-width: 450px;
        }

            .table-custom th {
                background: #f0f7fa;
                color: #1f4b54;
                font-weight: 600;
                padding: 0.7rem 0.8rem;
                border-bottom: 2px solid #d7e8ed;
                text-align: left;
                font-size: 0.85rem;
            }

            .table-custom td {
                padding: 0.6rem 0.8rem;
                border-bottom: 1px solid #eaf0f4;
                font-size: 0.85rem;
            }

        .badge-status {
            padding: 0.2rem 0.9rem;
            border-radius: 60px;
            font-size: 0.7rem;
            font-weight: 700;
            display: inline-block;
            white-space: nowrap;
        }

        .badge-assigned {
            background: #d7eef3;
            color: #0e5a66;
        }

        .badge-pending {
            background: #fef3d7;
            color: #8a6d0b;
        }

        .badge-accepted {
            background: #d4edda;
            color: #0f6b3a;
        }

        .badge-completed {
            background: #cce5ff;
            color: #004085;
        }

        /* ----- responsive ----- */
        @@media (max-width: 1200px) {
            .stat-grid {
                grid-template-columns: repeat(4, 1fr);
                gap: 0.8rem;
            }
        }

        @@media (max-width: 992px) {
            .stat-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 0.8rem;
            }

            .row-grid-2 {
                grid-template-columns: 1fr;
                gap: 1rem;
            }

            .grid-2col {
                grid-template-columns: 1fr;
                gap: 1rem;
            }

            .header-title {
                font-size: 1.7rem;
            }

            .stat-left .stat-number {
                font-size: 2.4rem;
            }
        }

        @@media (max-width: 640px) {
            body {
                padding: 10px 8px;
                font-size: 16px;
            }

            .dashboard-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 0.6rem;
                padding: 1rem 1.2rem;
                border-radius: 18px;
            }

            .header-title {
                font-size: 1.4rem;
            }

            .header-sub {
                font-size: 0.85rem;
            }

            .header-date {
                font-size: 0.8rem;
                padding: 0.3rem 1.2rem;
                align-self: flex-start;
                white-space: normal;
            }

            .stat-grid {
                grid-template-columns: 1fr 1fr;
                gap: 0.6rem;
            }

            .stat-card {
                padding: 0.7rem 0.8rem;
                min-height: 70px;
                border-left-width: 4px;
                border-radius: 16px;
            }

            .stat-left .stat-number {
                font-size: 1.8rem;
            }

            .stat-left .stat-label {
                font-size: 0.75rem;
            }

            .stat-left .stat-sub {
                font-size: 0.65rem;
            }

            .stat-icon {
                width: 40px;
                height: 40px;
                font-size: 1.4rem;
                border-radius: 12px;
            }

            .card-modern {
                padding: 1rem 0.8rem;
                border-radius: 18px;
            }

            .section-title {
                font-size: 1.1rem;
            }

            .quick-btn {
                font-size: 0.85rem;
                padding: 0.6rem;
            }

            .reminder-item, .appointment-item, .complaint-item, .feedback-item {
                padding: 0.5rem 0.7rem;
                font-size: 0.85rem;
                border-left-width: 3px;
                border-radius: 12px;
            }

                .feedback-item .stars {
                    font-size: 0.8rem;
                }

                .complaint-item .complaint-status {
                    font-size: 0.6rem;
                    padding: 0.1rem 0.7rem;
                }

            .daily-job-item {
                padding: 0.5rem 0.4rem;
                font-size: 0.85rem;
                flex-wrap: wrap;
            }

            .job-title {
                max-width: 160px;
                font-size: 0.85rem;
            }

            .job-meta {
                font-size: 0.7rem;
            }

            .job-time {
                font-size: 0.8rem;
            }

            .task-badge {
                font-size: 0.75rem;
                padding: 0.1rem 1rem;
            }

            .table-custom {
                font-size: 0.8rem;
                min-width: 350px;
            }

                .table-custom th,
                .table-custom td {
                    padding: 0.4rem 0.5rem;
                    font-size: 0.75rem;
                }

            .badge-status {
                font-size: 0.6rem;
                padding: 0.15rem 0.6rem;
            }
        }

        @@media (max-width: 420px) {
            .stat-grid {
                grid-template-columns: 1fr 1fr;
                gap: 0.5rem;
            }

            .stat-card {
                padding: 0.5rem 0.6rem;
                min-height: 60px;
            }

            .stat-left .stat-number {
                font-size: 1.5rem;
            }

            .stat-left .stat-label {
                font-size: 0.65rem;
            }

            .stat-icon {
                width: 34px;
                height: 34px;
                font-size: 1.1rem;
                border-radius: 10px;
            }

            .header-title {
                font-size: 1.2rem;
            }

            .card-modern {
                padding: 0.7rem 0.6rem;
            }

            .daily-job-item {
                flex-direction: column;
                align-items: flex-start;
                gap: 0.3rem;
            }

            .job-title {
                max-width: 100%;
                white-space: normal;
            }

            .job-time {
                align-self: flex-start;
            }

            .table-custom {
                min-width: 280px;
                font-size: 0.7rem;
            }
        }

        /* extras */
        .flex-between {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.4rem;
        }

        .fw-600 {
            font-weight: 600;
        }

        .mt-2 {
            margin-top: 0.8rem;
        }

        .mb-1 {
            margin-bottom: 0.3rem;
        }

        .text-center {
            text-align: center;
        }

        .text-muted {
            color: #8ba3ae;
        }

        .py-3 {
            padding-top: 0.8rem;
            padding-bottom: 0.8rem;
        }

        .gap-1 {
            gap: 0.3rem;
        }

        .badge {
            display: inline-block;
        }

        .ms-2 {
            margin-left: 0.5rem;
        }
    </style>
</head>
<body>
    <div class="dashboard-wrap">

        <!-- HEADER -->
        <div class="dashboard-header">

            <div>
                <div class="header-title">
                    <i class="fas fa-user-cog"></i> Technician Panel
                </div>

                <div class="header-sub">
                    <i class="fas fa-calendar-check" style="color:#2c8c99;"></i>
                    Welcome back, <strong>@Model.TechnicianName</strong>
                </div>
            </div>

            <div class="header-date">
                <i class="fas fa-calendar-alt"></i>
                @Model.CurrentDateTime.ToString("dd MMM yyyy")
                · <i class="far fa-clock"></i>
                @Model.CurrentDateTime.ToString("hh:mm tt")
            </div>

        </div>

        <!-- STATS: Assigned, Pending, Accepted, Completed -->
        <div class="stat-grid">
            <div class="stat-card">
                <div class="stat-left">
                    <div class="stat-label">
                        <i class="fas fa-tasks" style="color:#2c8c99;"></i> Daily Jobs
                    </div>
                    <div class="stat-number">
                        @(Model.TodayJobs?.Count ?? 0)
                    </div>
                    <div class="stat-sub">today</div>
                </div>
                <div class="stat-icon">
                    <i class="fas fa-calendar-day"></i>
                </div>
            </div>
            <div class="stat-card" style="border-left-color: #f1c40f;">
                <div class="stat-left">
                    <div class="stat-label"><i class="fas fa-hourglass-half" style="color:#f1c40f;"></i> Pending</div>
                    <div class="stat-number">@Model.PendingCount</div>
                    <div class="stat-sub">awaiting</div>
                </div>
                <div class="stat-icon" style="background:rgba(241,196,15,0.12); color:#d4a017;"><i class="fas fa-clock"></i></div>
            </div>
            <div class="stat-card" style="border-left-color: #27ae60;">
                <div class="stat-left">
                    <div class="stat-label"><i class="fas fa-spinner" style="color:#27ae60;"></i> In Progress</div>
                    <div class="stat-number">@Model.InProgressCount</div>
                    <div class="stat-sub">accepted</div>
                </div>
                <div class="stat-icon" style="background:rgba(39,174,96,0.10); color:#1e8449;"><i class="fas fa-sync-alt fa-fw"></i></div>
            </div>
            <div class="stat-card" style="border-left-color: #2980b9;">
                <div class="stat-left">
                    <div class="stat-label"><i class="fas fa-check-circle" style="color:#2980b9;"></i> Completed</div>
                    <div class="stat-number">@Model.CompletedCount</div>
                    <div class="stat-sub">finished</div>
                </div>
                <div class="stat-icon" style="background:rgba(41,128,185,0.10); color:#1f618d;"><i class="fas fa-check-double"></i></div>
            </div>
        </div>

        <!-- PROGRESS + QUICK ACTIONS -->
        <div class="row-grid-2">
            <div class="card-modern">
                <div class="section-title">
                    <i class="fas fa-chart-line"></i> Completion Rate
                </div>
                <div class="progress-wrapper">
                    <div class="flex-between">
                        <span style="font-size:0.95rem;">Overall progress</span>
                        <span class="fw-600" style="color:#2c8c99; font-size:1.1rem;">
                            @Math.Round(Model.CompletionRate, 0)%
                        </span>
                    </div>
                    <div class="progress-track">
                        <div class="progress-fill" style="width:@Model.CompletionRate%;"></div>
                    </div>
                    <div style="display:flex; justify-content:space-between; margin-top:12px; font-size:0.85rem; color:#3d6673; flex-wrap:wrap; gap:0.5rem;">
                        <span><i class="fas fa-check-circle" style="color:#27ae60;"></i> @Model.CompletedCount done</span>
                        <span><i class="fas fa-hourglass-half" style="color:#f1c40f;"></i> @Model.PendingCount pending</span>
                        <span><i class="fas fa-tasks" style="color:#2c8c99;"></i> @Model.TotalCount total</span>
                    </div>
                </div>
            </div>
            <div class="card-modern">
                <div class="section-title"><i class="fas fa-bolt"></i> Quick Actions</div>
                <a href="/TechnicianService/MySchedule" class="quick-btn">
                    <i class="fas fa-calendar-alt"></i> View Schedule
                </a>
                <a asp-controller="TechnicianService" asp-action="Reminders" class="quick-btn">
                    <i class="fas fa-bell"></i> Reminders
                    <span style="background:#2c8c99; color:white; padding:0.1rem 0.8rem; border-radius:30px; font-size:0.7rem;">
                        @Model.ReminderCount
                    </span>
                </a>
            </div>
        </div>

        <!-- 2-col: Daily Jobs + Appointments -->
        <div class="grid-2col">
            <!-- Daily Jobs -->
            <div class="card-modern">
                <div class="flex-between schedule-header">
                    <div class="section-title" style="margin-bottom:0;">
                        <i class="fas fa-tasks"></i> Daily Jobs
                    </div>
                    <span class="task-badge">
                        @(Model.TodayJobs?.Count ?? 0) tasks
                    </span>
                </div>
                <div class="daily-job-list">
                    @if (Model?.TodayJobs != null && Model.TodayJobs.Count > 0)
                    {
                        foreach (var item in Model.TodayJobs)
                        {
                            <div class="daily-job-item">
                                <div class="job-main">
                                    <i class="fas fa-user-circle" style="font-size:1.1rem;"></i>
                                    <div class="job-text">
                                        <div class="job-title">
                                            @(item.Customer?.Name ?? "Unknown") · @item.Title
                                        </div>
                                        <div class="job-meta">
                                            <span>@item.PlanType</span>
                                            <span style="color:@(item.Priority=="High"?"#e74c3c":"#2c8c99")">
                                                @item.Priority
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <div class="job-time">
                                    @item.PlannedDate.ToString("HH:mm")
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="fas fa-calendar-day"></i> No jobs for today
                        </div>
                    }
                </div>
            </div>

            <!-- Appointments -->
            <div class="card-modern">
                <div class="section-title">
                    <i class="fas fa-map-pin"></i> Appointments
                </div>
                @if (Model.RecentAppointments != null && Model.RecentAppointments.Count > 0)
                {
                    foreach (var item in Model.RecentAppointments)
                    {
                        <div class="appointment-item">
                            <span>
                                <i class="fas fa-user" style="color:#2c8c99;"></i>
                                @item.Customer?.Name
                                <span style="font-size:0.8rem; color:#5f7a88;">@item.ScheduledDate.ToString("hh:mm tt")</span>
                            </span>
                            <span class="appt-time">
                                <i class="fas fa-map-marker-alt"></i>
                                @item.Location
                            </span>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">No appointments scheduled</div>
                }
            </div>
        </div>

        <!-- Complaints + Feedback row -->
        <div class="grid-2col">
            <!-- Complaints -->
            <div class="card-modern">
                <div class="section-title">
                    <i class="fas fa-exclamation-circle"></i> Complaints
                    <span style="background:#2c8c99; color:white; padding:0.1rem 0.9rem; border-radius:30px; font-size:0.8rem;">
                        @Model.ComplaintCount
                    </span>
                </div>
                @if (Model.Complaints != null && Model.Complaints.Count > 0)
                {
                    foreach (var item in Model.Complaints)
                    {
                        <div class="complaint-item">
                            <span>
                                <i class="fas fa-file-signature"></i>
                                @item.Title
                            </span>
                            <span style="font-size:0.75rem; color:#5f7a88;">@item.Customer?.Name</span>
                            <span class="complaint-status status-@(item.Status.ToLower())">
                                @item.Status
                            </span>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">No complaints</div>
                }
            </div>

            <!-- Feedback -->
            <div class="card-modern">
                <div class="section-title">
                    <i class="fas fa-star"></i> Feedback & Ratings
                    <span style="background:#2c8c99; color:white; padding:0.1rem 0.9rem; border-radius:30px; font-size:0.8rem;">
                        @Model.AverageRating.ToString("0.0") ★
                    </span>
                </div>
                @if (Model.Feedbacks != null && Model.Feedbacks.Count > 0)
                {
                    foreach (var item in Model.Feedbacks)
                    {
                        <div class="feedback-item">
                            <span>
                                <i class="fas fa-user-circle"></i>
                                @item.Customer?.Name
                            </span>
                            <span class="stars">
                                @for (int i = 0; i < item.Rating; i++)
                                {
                                    <i class="fas fa-star"></i>
                                }
                            </span>
                            <span style="font-size:0.8rem; color:#5f7a88; max-width:150px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                                "@item.Comment"
                            </span>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">No feedback yet</div>
                }
            </div>
        </div>

        <!-- Recent Tasks Table -->
       @*  <div class="card-modern" style="margin-bottom:1.8rem;">
            <div class="flex-between" style="flex-wrap:wrap; gap:0.5rem;">
                <div class="section-title" style="margin-bottom:0;">
                    <i class="fas fa-history"></i> Recent Tasks
                </div>
                <a href="#" style="color:#2c8c99; font-weight:600; text-decoration:none; font-size:0.9rem;">
                    <i class="fas fa-arrow-right"></i> View all
                </a>
            </div>
            <div class="table-wrap">
                <table class="table-custom">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Customer</th>
                            <th>Location</th>
                            <th>Status</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if ((Model.RecentTasks?.Count ?? 0) > 0)
                        {
                            foreach (var item in Model.RecentTasks)
                            {
                                <tr>
                                    <td><strong>#AC-@item.ServiceId</strong></td>
                                    <td>@item.Customer?.Name</td>
                                    <td>@item.Location</td>
                                    <td>
                                        <span class="badge-status
                                        @(item.Status=="Assigned" ? "badge-assigned" :
                                          item.Status=="Pending" ? "badge-pending" :
                                          item.Status=="In Progress" ? "badge-accepted" :
                                          "badge-completed")">
                                            @item.Status
                                        </span>
                                    </td>
                                    <td>@item.CreatedAt.ToString("dd MMM yyyy")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted" style="padding:0.8rem;">
                                    No recent tasks found
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div style="margin-top:0.8rem; font-size:0.8rem; color:#5f7a88; display:flex; gap:1.2rem; flex-wrap:wrap;">
                <span>Assigned: @(Model.RecentTasks?.Count(x => x.Status == "Assigned") ?? 0)</span>
                <span>Pending: @(Model.RecentTasks?.Count(x => x.Status == "Pending") ?? 0)</span>
                <span>Completed: @(Model.RecentTasks?.Count(x => x.Status == "Completed") ?? 0)</span>
            </div>
        </div>

        <!-- Footer -->
        <div style="margin-top: 2rem; text-align: center; font-size:0.85rem; color:#6f8e9b; border-top:1px solid #dce9ef; padding-top:1.5rem;">
            <i class="fas fa-circle" style="color:#2c8c99; font-size:0.4rem;"></i> Technician Dashboard
        </div> *@

    </div>

    <script>
        // Live clock update
        setInterval(() => {
            const now = new Date();
            const timeStr = now.toLocaleTimeString();
            const dateEl = document.querySelector('.header-date');
            if (dateEl) {
                const datePart = dateEl.innerHTML.split('·')[0];
                dateEl.innerHTML = datePart + '· <i class="far fa-clock"></i> ' + timeStr;
            }
        }, 1000);
    </script>
</body>
</html>