@using AirConServicingManagementSystem.ViewsModels
@model MyScheduleVM

@{
    ViewData["Title"] = "My Schedule";
    Layout = "~/Views/Shared/_TechnicianLayout.cshtml";
}

<style>

    :root {
        --main: #2c8c99;
        --main-dark: #1a6b77;
        --soft: #eaf4f7;
        --dark: #1e4b54;
    }

    .schedule-container {
        padding: 15px;
    }

    /* =========================
           HEADER
           ========================= */

    .schedule-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .schedule-title h2 {
        margin: 0;
        color: var(--main);
        font-weight: 700;
    }

    .schedule-title p {
        margin: 5px 0 0;
        color: #6c757d;
    }

    .today-badge {
        background: var(--soft);
        color: var(--dark);
        padding: 8px 15px;
        border-radius: 30px;
        font-weight: 600;
    }

    /* =========================
           SUMMARY
           ========================= */

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 15px;
        margin-bottom: 25px;
    }

    .summary-card {
        background: white;
        border-radius: 15px;
        padding: 18px;
        box-shadow: 0 4px 15px rgba(0,0,0,.06);
        border-left: 5px solid var(--main);
    }

        .summary-card h6 {
            margin: 0;
            color: #6c757d;
            font-size: 13px;
            text-transform: uppercase;
        }

        .summary-card h3 {
            margin: 5px 0 0;
            color: var(--dark);
            font-weight: 800;
        }

    .summary-today {
        border-left-color: #2c8c99;
    }

    .summary-upcoming {
        border-left-color: #f39c12;
    }

    .summary-priority {
        border-left-color: #e74c3c;
    }

    .summary-completed {
        border-left-color: #27ae60;
    }

    /* =========================
           TABLE
           ========================= */

    .schedule-card {
        background: white;
        border-radius: 18px;
        box-shadow: 0 4px 20px rgba(0,0,0,.06);
        overflow: hidden;
    }

    .schedule-table {
        width: 100%;
        border-collapse: collapse;
    }

        .schedule-table thead {
            background: var(--main);
            color: white;
        }

        .schedule-table th {
            padding: 14px;
            font-size: 13px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .schedule-table td {
            padding: 13px 14px;
            border-bottom: 1px solid #eee;
            vertical-align: middle;
        }

        .schedule-table tbody tr:hover {
            background: var(--soft);
        }

    /* =========================
           BADGES
           ========================= */

    .badge-modern {
        display: inline-block;
        padding: 5px 11px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .priority-high {
        background: #fdeaea;
        color: #c0392b;
    }

    .priority-medium {
        background: #fff4df;
        color: #d68910;
    }

    .priority-low {
        background: #edf0f2;
        color: #68737d;
    }

    .status-pending {
        background: #fff4df;
        color: #d68910;
    }

    .status-progress {
        background: var(--soft);
        color: var(--main-dark);
    }

    .status-completed {
        background: #e8f7ee;
        color: #219653;
    }

    /* =========================
           BUTTONS
           ========================= */

    .action-buttons {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    .btn-schedule {
        border: none;
        border-radius: 7px;
        padding: 6px 11px;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .btn-start {
        background: var(--main);
        color: white;
    }

        .btn-start:hover {
            background: var(--main-dark);
            color: white;
        }

    .btn-continue {
        background: #f39c12;
        color: white;
    }

        .btn-continue:hover {
            background: #d68910;
            color: white;
        }

    .btn-view {
        background: #17a2b8;
        color: white;
    }

        .btn-view:hover {
            background: #138496;
            color: white;
        }


    .status-remaining {
        background: #fff3cd;
        color: #856404;
    }
    /* =========================
           EMPTY
           ========================= */

    .empty-box {
        text-align: center;
        padding: 60px 20px;
        color: #777;
    }

        .empty-box i {
            font-size: 50px;
            color: var(--main);
            opacity: .25;
            margin-bottom: 15px;
        }

        .empty-box h4 {
            color: var(--main);
            font-weight: 700;
        }

    /* =========================
           MOBILE
           ========================= */

    .mobile-schedule {
        display: none;
    }

    .mobile-card {
        background: white;
        border-radius: 15px;
        padding: 15px;
        margin-bottom: 12px;
        box-shadow: 0 3px 15px rgba(0,0,0,.06);
    }

    .mobile-item {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        padding: 6px 0;
    }

    .mobile-label {
        color: #6c757d;
        font-size: 12px;
        font-weight: 700;
        min-width: 75px;
    }

    .mobile-value {
        text-align: right;
        font-size: 14px;
        font-weight: 500;
        color: #1e293b;
    }

    .mobile-actions {
        border-top: 1px solid #eee;
        margin-top: 10px;
        padding-top: 10px;
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    /* =========================
           RESPONSIVE
           ========================= */

    @@media (max-width: 992px) {

        .summary-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .schedule-table {
            min-width: 850px;
        }

        .schedule-card {
            overflow-x: auto;
        }
    }

    @@media (max-width: 768px) {

        .schedule-container {
            padding: 10px 5px;
        }

        .schedule-header {
            align-items: flex-start;
        }

        .summary-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
        }

        .summary-card {
            padding: 13px;
        }

            .summary-card h3 {
                font-size: 22px;
            }

        .desktop-schedule {
            display: none;
        }

        .mobile-schedule {
            display: block;
        }
    }

    @@media (max-width: 480px) {

        .schedule-title h2 {
            font-size: 21px;
        }

        .schedule-title p {
            font-size: 13px;
        }

        .today-badge {
            font-size: 12px;
        }

        .summary-card h6 {
            font-size: 10px;
        }

        .summary-card h3 {
            font-size: 19px;
        }

        .mobile-item {
            align-items: flex-start;
        }

        .mobile-value {
            font-size: 13px;
        }
    }

    /* =========================
           DARK MODE
           ========================= */

    [data-bs-theme="dark"] .summary-card,
    [data-bs-theme="dark"] .schedule-card,
    [data-bs-theme="dark"] .mobile-card {
        background: #2d2d2d;
    }

        [data-bs-theme="dark"] .summary-card h3 {
            color: #eee;
        }

        [data-bs-theme="dark"] .summary-card h6,
        [data-bs-theme="dark"] .schedule-title p {
            color: #aaa;
        }

    [data-bs-theme="dark"] .schedule-table td {
        color: #eee;
        border-color: #444;
    }

    [data-bs-theme="dark"] .schedule-table tbody tr:hover {
        background: rgba(44,140,153,.1);
    }

    [data-bs-theme="dark"] .mobile-card {
        color: #eee;
    }

    [data-bs-theme="dark"] .mobile-value {
        color: #eee;
    }

    [data-bs-theme="dark"] .mobile-actions {
        border-color: #444;
    }

</style>


<div class="schedule-container">

    <!-- =========================
         HEADER
         ========================= -->

    <div class="schedule-header">

        <div class="schedule-title">

            <h2>
                <i class="fas fa-calendar-alt me-2"></i>
                My Schedule
            </h2>

            <p>
                View and manage your assigned schedules.
            </p>

        </div>

        <div class="today-badge">

            <i class="fas fa-calendar-day me-1"></i>

            @DateTime.Now.ToString("dd MMM yyyy")

        </div>

    </div>


    <!-- =========================
         SUMMARY
         ========================= -->

    <div class="summary-grid">

        <div class="summary-card summary-today">

            <h6>
                <i class="fas fa-calendar-day me-1"></i>
                Today
            </h6>

            <h3>
                @Model.TodayCount
            </h3>

        </div>


        <div class="summary-card summary-upcoming">

            <h6>
                <i class="fas fa-clock me-1"></i>
                Upcoming
            </h6>

            <h3>
                @Model.UpcomingCount
            </h3>

        </div>


        <div class="summary-card summary-priority">

            <h6>
                <i class="fas fa-exclamation-circle me-1"></i>
                High Priority
            </h6>

            <h3>
                @Model.HighPriorityCount
            </h3>

        </div>


        <div class="summary-card summary-completed">

            <h6>
                <i class="fas fa-check-circle me-1"></i>
                Completed
            </h6>

            <h3>
                @Model.CompletedCount
            </h3>

        </div>

    </div>


    <!-- =========================
         DESKTOP TABLE
         ========================= -->

    <div class="schedule-card desktop-schedule">

        @if (Model.Plans == null || !Model.Plans.Any())
        {
            <div class="empty-box">

                <i class="fas fa-calendar-times"></i>

                <h4>No Schedules Found</h4>

                <p>
                    You don't have any assigned schedules yet.
                </p>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="schedule-table">

                    <thead>

                        <tr>

                            <th>Date & Time</th>

                            <th>Customer</th>

                            <th>Schedule</th>

                            <th>Location</th>

                            <th>Priority</th>

                            <th>Status</th>

                            <th>Action</th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item in Model.Plans)
                        {
                            <tr>

                                <!-- DATE -->

                                <td>

                                    <div class="fw-bold">

                                        @item.PlannedDate.ToString("dd MMM yyyy")

                                    </div>

                                    <small class="text-muted">

                                        <i class="far fa-clock me-1"></i>

                                        @item.PlannedDate.ToString("hh:mm tt")

                                    </small>

                                </td>


                                <!-- CUSTOMER -->

                                <td>

                                    <div class="fw-semibold">

                                        <i class="fas fa-user me-1"
                                           style="color:var(--main);"></i>

                                        @(item.CustomerName
                                                                        ?? item.Customer?.Name
                                                                        ?? "N/A")

                            </div>

                                </td>


                                <!-- SCHEDULE -->

                                <td>

                                    <div class="fw-semibold">

                                        @(item.Title ?? "-")

                                    </div>

                            @if (!string.IsNullOrWhiteSpace(item.PlanType))
                                    {
                                        <small class="text-muted">

                                            @item.PlanType

                                        </small>
                                    }

                                </td>


                                <!-- LOCATION -->

                                <td>

                                    <span>

                                        <i class="fas fa-map-marker-alt me-1"
                                           style="color:var(--main);"></i>

                                        @(item.Location ?? "-")

                                    </span>

                                </td>


                                <!-- PRIORITY -->

                                <td>

                                    @{
                                        var priority =
                                        item.Priority?.Trim().ToLower();
                                    }

                                <span class="badge-modern
                                            @(priority == "high"
                                                                                  ? "priority-high"
                                                                                  : priority == "medium"
                                                                                      ? "priority-medium"
                                                                                      : "priority-low")">

                                @(item.Priority ?? "Low")

                                    </span>

                                </td>


                                <!-- STATUS -->

                                <td>

                            @{
                                        var status = item.Status?.Trim().ToLower();
                                    }

                                <span class="badge-modern
                                         @(status == "Completed"
                                              ? "status-completed"
                                           : status == "In Progress"
                                                  ? "status-progress"
                                                  : status == "Remaining"
                                                      ? "status-remaining"
                                                      : "status-pending")">

                                @(item.Status ?? "Pending")

                                    </span>

                                </td>


                                <!-- ACTION -->

                                <td>

                                    <div class="action-buttons">

                                @if (status == "Pending" || status == "Remaining")
                                        {
                                            <a asp-action="Start"
                                               asp-route-id="@item.PlanId"
                                               class="btn-schedule btn-start">

                                                <i class="fas fa-play"></i>

                                                Start

                                            </a>
                                        }

                                        else if (status == "In Progress")
                                        {
                                            <a asp-action="Continue"
                                               asp-route-id="@item.PlanId"
                                               class="btn-schedule btn-continue">

                                                <i class="fas fa-forward"></i>

                                                Continue

                                            </a>
                                        }

                                        <a asp-action="Details"
                                           asp-route-id="@item.PlanId"
                                           class="btn-schedule btn-view">

                                            <i class="fas fa-eye"></i>

                                            View

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>


    <!-- =========================
         MOBILE
         ========================= -->

    <div class="mobile-schedule">

        @if (Model.Plans == null || !Model.Plans.Any())
        {
            <div class="empty-box">

                <i class="fas fa-calendar-times"></i>

                <h4>No Schedules Found</h4>

                <p>
                    You don't have any assigned schedules yet.
                </p>

            </div>
        }
        else
        {
            foreach (var item in Model.Plans)
            {
                var status = item.Status?.Trim().ToLower();

                var priority =
                item.Priority?.Trim().ToLower();


                <div class="mobile-card">

                    <!-- DATE -->

                    <div class="mobile-item">

                        <span class="mobile-label">
                            Date
                        </span>

                        <span class="mobile-value">

                            @item.PlannedDate.ToString("dd MMM yyyy")

                            <br />

                            <small class="text-muted">

                                @item.PlannedDate.ToString("hh:mm tt")

                            </small>

                        </span>

                    </div>


                    <!-- CUSTOMER -->

                    <div class="mobile-item">

                        <span class="mobile-label">
                            Customer
                        </span>

                        <span class="mobile-value">

                            @(item.CustomerName
                                                ?? item.Customer?.Name
                                                ?? "N/A")

                </span>

                    </div>


                    <!-- TITLE -->

                    <div class="mobile-item">

                        <span class="mobile-label">
                            Schedule
                        </span>

                        <span class="mobile-value">

                            @item.Title

                    @if (!string.IsNullOrWhiteSpace(item.PlanType))
                            {
                                <br />

                                <small class="text-muted">
                                    @item.PlanType
                                </small>
                            }

                </span>

            </div>


            <!-- LOCATION -->

            <div class="mobile-item">

                <span class="mobile-label">
                    Location
                </span>

                <span class="mobile-value">

                    @(item.Location ?? "-")

                </span>

            </div>


            <!-- PRIORITY -->

            <div class="mobile-item">

                <span class="mobile-label">
                    Priority
                </span>

                <span class="mobile-value">

                    <span class="badge-modern
                                @(priority == "high"
                                                              ? "priority-high"
                                                              : priority == "medium"
                                                                  ? "priority-medium"
                                                                  : "priority-low")">

                        @(item.Priority ?? "Low")

                    </span>

                </span>

            </div>


            <!-- STATUS -->

            <div class="mobile-item">

                <span class="mobile-label">
                    Status
                </span>

                <span class="mobile-value">

                    <span class="badge-modern
                         @(status == "Completed"
                                  ? "status-completed"
                                      : status == "In Progress"
                                      ? "status-progress"
                                      : status == "Remaining"
                                          ? "status-remaining"
                                          : "status-pending")">

                        @(item.Status ?? "Pending")

                            </span>

                        </span>

                    </div>


                    <!-- ACTION -->

                    <div class="mobile-actions">

                @if (status == "Pending" || status == "Remaining")
                        {
                            <a asp-action="Start"
                               asp-route-id="@item.PlanId"
                               class="btn-schedule btn-start">

                                <i class="fas fa-play"></i>

                                Start

                            </a>
                        }

                        else if (status == "In Progress")
                        {
                            <a asp-action="Continue"
                               asp-route-id="@item.PlanId"
                               class="btn-schedule btn-continue">

                                <i class="fas fa-forward"></i>

                                Continue

                            </a>
                        }

                        <a asp-action="Details"
                           asp-route-id="@item.PlanId"
                           class="btn-schedule btn-view">

                            <i class="fas fa-eye"></i>

                            View

                        </a>

                    </div>

                </div>
            }
        }

    </div>

</div>