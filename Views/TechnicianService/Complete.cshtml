    <script>

        function calculateNextService(index) {

            let condition =
                document.getElementById("condition_" + index).value;

            let months = 0;

            if (condition === "Good")
                months = 6;
            else if (condition === "Normal")
                months = 3;
            else if (condition === "Bad")
                months = 1;
            else {
                document.getElementById("nextService_" + index).value = "";
                return;
            }

            let date = new Date();
            date.setMonth(date.getMonth() + months);

            document.getElementById("nextService_" + index).value =
                date.toISOString().split('T')[0];
        }

        function calculateInvoice() {
          let partsTotal = 0;
          document.querySelectorAll("#partsTable tbody tr").forEach(row => {
            let qty = parseFloat(row.querySelector(".qty")?.value || 0);
            let price = parseFloat(row.querySelector(".price")?.value || 0);
            let total = qty * price;
            row.querySelector(".total").value = total;
            partsTotal += total;
          });
          let chargeTotal = 0;
          document.querySelectorAll(".chargeAmount").forEach(x => chargeTotal += parseFloat(x.value || 0));
          let expenseTotal = 0;
          document.querySelectorAll(".expenseAmount").forEach(x => expenseTotal += parseFloat(x.value || 0));
          document.getElementById("partsTotal").value = partsTotal;
          document.getElementById("chargeTotal").value = chargeTotal;
          document.getElementById("expenseTotal").value = expenseTotal;
          document.getElementById("grandTotal").value = partsTotal + chargeTotal + expenseTotal;
        }

        document.addEventListener("input", function() { calculateInvoice(); });

        let partIndex = 1;
        function addPartRow() {
          let table = document.querySelector("#partsTable tbody");
          let row = `<tr><td><input class="form-control" name="Parts[${partIndex}].PartName"/></td><td><input class="form-control qty" type="number" value="1" name="Parts[${partIndex}].Quantity"/></td><td><input class="form-control price" type="number" value="0" name="Parts[${partIndex}].UnitPrice"/></td><td><input class="form-control total" readonly/></td><td><button type="button" class="btn btn-danger" onclick="removeRow(this)">✕</button></td></tr>`;
          table.insertAdjacentHTML("beforeend", row);
          partIndex++;
        }

        function removeRow(btn) {
          btn.closest("tr").remove();
          calculateInvoice();
        }

        // function previewImages(event) {
        //   let area = document.getElementById("previewArea");
        //   area.innerHTML = "";
        //   Array.from(event.target.files).forEach(file => {
        //     let reader = new FileReader();
        //     reader.onload = function(e) {
        //       let img = document.createElement("img");
        //       img.src = e.target.result;
        //       img.style.width = "80px";
        //       img.style.height = "80px";
        //       img.style.objectFit = "cover";
        //       img.className = "rounded";
        //       area.appendChild(img);
        //     }
        //     reader.readAsDataURL(file);
        //   });
        // }

               function bindPreview(inputId, previewId) {

            const input = document.getElementById(inputId);

            let dt = new DataTransfer();

            input.addEventListener("change", function () {

                Array.from(input.files).forEach(file => {

                    dt.items.add(file);

                });

                input.files = dt.files;

                render();

            });

            function render() {

                const preview = document.getElementById(previewId);

                preview.innerHTML = "";

                Array.from(dt.files).forEach((file, index) => {

                    const reader = new FileReader();

                    reader.onload = function (e) {

                        const card = document.createElement("div");

                        card.className = "photo-item";

                        card.innerHTML = `
                            <img src="${e.target.result}"
                                 class="preview-img"
                                 data-src="${e.target.result}">

                            <button type="button"
                                    class="remove-photo">
                                ×
                            </button>
                        `;
                       card.querySelector(".preview-img")
                        .onclick = function () {

                            document.getElementById("modalImage").src = this.src;

                            const modal = new bootstrap.Modal(
                                document.getElementById("imageModal")
                            );

                            modal.show();

                        };

                        // Remove Button
                        card.querySelector(".remove-photo")
                            .onclick = function () {

                            const newDT = new DataTransfer();

                            Array.from(dt.files)
                                .forEach((f, i) => {

                                if (i !== index)
                                    newDT.items.add(f);

                            });

                            dt = newDT;

                            input.files = dt.files;

                            render();

                        };

                        // Preview Click
                        card.querySelector(".preview-img")
                            .onclick = function () {

                            document
                                .getElementById("modalImage")
                                .src = this.dataset.src;

                            new bootstrap.Modal(
                                document.getElementById("imageModal")
                            ).show();

                        };

                        preview.appendChild(card);

                    };

                    reader.readAsDataURL(file);

                });

            }

        }

                bindPreview(
            "beforePhotos",
            "beforePreview");

        bindPreview(
            "afterPhotos",
            "afterPreview");

        bindPreview(
            "problemPhotos",
            "problemPreview");

           document.querySelectorAll(".aircon-selector").forEach(check => {

            const index = check.dataset.index;
            const hidden = document.getElementById("selected_" + index);
            const card = document.getElementById(check.dataset.target);

            // Page Load
            if (check.checked) {
                hidden.value = "true";
                card.classList.remove("d-none");
            }

            check.addEventListener("change", function () {

                if (this.checked) {
                    hidden.value = "true";
                    card.classList.remove("d-none");
                }
                else {
                    hidden.value = "false";
                    card.classList.add("d-none");
                }

            });

        });

        document.querySelectorAll(".service-qty-input").forEach(input => {
          input.addEventListener("input", function() {
            let total = parseInt(this.dataset.total);
            let completed = parseInt(this.dataset.completed);
            let todayQty = parseInt(this.value) || 0;
            let newCompleted = completed + todayQty;
            let newRemaining = total - newCompleted;
            if (newRemaining < 0) {
              newRemaining = 0;
              this.value = total - completed;
              newCompleted = total;
            }
            document.getElementById(this.dataset.completedId).innerText = newCompleted;
            document.getElementById(this.dataset.remainingId).innerText = newRemaining;
            document.getElementById(this.dataset.summaryCompletedId).innerText = newCompleted;
            document.getElementById(this.dataset.summaryRemainingId).innerText = newRemaining;
          });
        });
    </script>
