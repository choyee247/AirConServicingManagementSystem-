@model AirConServicingManagementSystem.ViewsModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.5">
    <title>Admin · Technician Admin Dashboard</title>
    <!-- Font Awesome 6 Free -->
    @* <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"> *@
    <link rel="stylesheet" href="~/fontawesome/css/beta3allmin600.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #f4f9fc;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            padding: 20px 16px;
            color: #1a2b33;
            font-size: 17px;
        }

        .admin-wrap {
            max-width: 1400px;
            margin: 0 auto;
        }

        /* ----- primary color #2c8c99 & variants ----- */
        :root {
            --primary: #2c8c99;
            --primary-light: #4ca6b3;
            --primary-dark: #1a6b77;
            --primary-soft: rgba(44, 140, 153, 0.08);
            --primary-glow: rgba(44, 140, 153, 0.20);
            --shadow-teal: 0 12px 30px rgba(44, 140, 153, 0.12);
        }

        /* ----- cards & glass effect ----- */
        .card-modern {
            background: #ffffff;
            border-radius: 24px;
            padding: 1.8rem 1.5rem;
            box-shadow: 0 6px 22px rgba(44, 140, 153, 0.07), 0 2px 6px rgba(0,0,0,0.02);
            transition: all 0.25s ease;
            border: 1px solid rgba(44, 140, 153, 0.06);
            height: 100%;
            position: relative;
            overflow: hidden;
        }

            .card-modern::after {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 4px;
                background: linear-gradient(90deg, var(--primary), var(--primary-light));
                opacity: 0.7;
            }

            .card-modern:hover {
                transform: translateY(-5px);
                box-shadow: var(--shadow-teal);
                border-color: rgba(44, 140, 153, 0.15);
            }

        /* ----- header with gradient ----- */
        .admin-header {
            background: linear-gradient(135deg, var(--primary), var(--primary-light));
            color: white;
            padding: 1.8rem 2.2rem;
            border-radius: 28px;
            margin-bottom: 2rem;
            box-shadow: 0 12px 34px rgba(44, 140, 153, 0.25);
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            border: 1px solid rgba(255,255,255,0.08);
            gap: 1rem;
        }

            .admin-header h2 {
                font-weight: 700;
                font-size: 2.2rem;
                letter-spacing: -0.3px;
                margin-bottom: 0.3rem;
            }

                .admin-header h2 i {
                    margin-right: 12px;
                    opacity: 0.9;
                }

            .admin-header .badge-role {
                background: rgba(255,255,255,0.18);
                padding: 0.5rem 1.4rem;
                border-radius: 60px;
                font-size: 0.95rem;
                font-weight: 600;
                backdrop-filter: blur(4px);
                display: inline-block;
            }

            .admin-header .header-date {
                background: rgba(255,255,255,0.12);
                padding: 0.5rem 1.8rem;
                border-radius: 60px;
                font-weight: 500;
                font-size: 1.05rem;
                backdrop-filter: blur(4px);
                border: 1px solid rgba(255,255,255,0.1);
                white-space: nowrap;
            }

        .header-badges {
            display: flex;
            gap: 0.6rem;
            flex-wrap: wrap;
            margin-top: 6px;
        }

        /* ----- stat grid (4 items) ----- */
        .stat-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1.2rem;
            margin-bottom: 2rem;
        }

        .stat-card {
            background: white;
            border-radius: 22px;
            padding: 1.3rem 1.2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-left: 6px solid var(--primary);
            box-shadow: 0 4px 14px rgba(44, 140, 153, 0.06);
            transition: 0.2s;
            border: 1px solid rgba(44, 140, 153, 0.06);
            min-height: 100px;
        }

            .stat-card:hover {
                background: #fafdff;
                box-shadow: 0 10px 28px rgba(44, 140, 153, 0.10);
                transform: translateY(-3px);
            }

        .stat-left .stat-label {
            font-size: 0.95rem;
            font-weight: 600;
            color: #5f7a88;
            letter-spacing: 0.3px;
            text-transform: uppercase;
        }

        .stat-left .stat-number {
            font-size: 2.8rem;
            font-weight: 800;
            color: var(--primary-dark);
            line-height: 1.2;
        }

        .stat-left .stat-sub {
            font-size: 0.85rem;
            color: #8ba3ae;
            font-weight: 500;
        }

        .stat-icon {
            width: 58px;
            height: 58px;
            background: var(--primary-soft);
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--primary);
            font-size: 2rem;
            flex-shrink: 0;
        }

        /* ----- 2-col layout: manage + feedback/complaint ----- */
        .grid-2col {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.8rem;
            margin-bottom: 2rem;
        }

        .section-title {
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--primary-dark);
            display: flex;
            align-items: center;
            gap: 0.6rem;
            margin-bottom: 1.2rem;
            border-bottom: 2px solid rgba(44, 140, 153, 0.08);
            padding-bottom: 0.6rem;
        }

            .section-title i {
                color: var(--primary);
                font-size: 1.3rem;
            }

        /* ----- technician list ----- */
        .tech-item {
            background: #f8fbfd;
            border-radius: 60px;
            padding: 0.7rem 1.2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 0.7rem;
            border: 1px solid #e2eef3;
            transition: 0.1s;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

            .tech-item .tech-name {
                font-weight: 600;
                color: #12343e;
                font-size: 1.05rem;
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

            .tech-item .tech-status {
                font-size: 0.8rem;
                background: var(--primary-soft);
                padding: 0.15rem 1rem;
                border-radius: 40px;
                color: var(--primary-dark);
                font-weight: 600;
                white-space: nowrap;
            }

        .btn-teal-outline {
            background: transparent;
            border: 1.5px solid var(--primary);
            color: var(--primary);
            border-radius: 60px;
            padding: 0.3rem 1.2rem;
            font-weight: 600;
            font-size: 0.85rem;
            transition: 0.2s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            white-space: nowrap;
        }

            .btn-teal-outline:hover {
                background: var(--primary);
                color: white;
            }

        .btn-teal-solid {
            background: var(--primary);
            border: none;
            color: white;
            border-radius: 60px;
            padding: 0.5rem 1.6rem;
            font-weight: 600;
            font-size: 0.9rem;
            transition: 0.2s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            white-space: nowrap;
        }

            .btn-teal-solid:hover {
                background: var(--primary-dark);
                color: white;
            }

        /* ----- feedback & complaint items ----- */
        .feedback-item, .complaint-item {
            background: #f8fbfd;
            border-radius: 16px;
            padding: 0.8rem 1rem;
            margin-bottom: 0.6rem;
            border-left: 4px solid var(--primary);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.4rem;
            font-size: 0.95rem;
        }

            .feedback-item .stars {
                color: #f1c40f;
                letter-spacing: 2px;
                font-size: 0.95rem;
            }

            .complaint-item .complaint-badge {
                font-size: 0.75rem;
                font-weight: 700;
                padding: 0.15rem 1rem;
                border-radius: 40px;
                background: #e67e22;
                color: white;
                white-space: nowrap;
            }

        .complaint-badge.resolved {
            background: #27ae60;
        }

        .complaint-badge.progress {
            background: #2980b9;
        }

        .complaint-badge.new {
            background: #e67e22;
        }

        /* ----- assign technician (quick action) ----- */
        .assign-box {
            background: #f2f9fc;
            border-radius: 20px;
            padding: 1rem 1.2rem;
            border: 1px dashed var(--primary);
            margin-top: 1rem;
        }

            .assign-box .assign-row {
                display: flex;
                gap: 0.8rem;
                flex-wrap: wrap;
                align-items: center;
            }

        /* ----- table (recent) ----- */
        .table-wrap {
            overflow-x: auto;
            margin-top: 0.5rem;
            -webkit-overflow-scrolling: touch;
        }

        .table-custom {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.95rem;
            min-width: 500px;
        }

            .table-custom th {
                background: #f0f7fa;
                color: var(--primary-dark);
                font-weight: 600;
                padding: 0.8rem 0.8rem;
                border-bottom: 2px solid #d7e8ed;
                text-align: left;
                font-size: 0.85rem;
            }

            .table-custom td {
                padding: 0.7rem 0.8rem;
                border-bottom: 1px solid #eaf0f4;
                font-size: 0.9rem;
            }

        .badge-status {
            padding: 0.25rem 1rem;
            border-radius: 60px;
            font-size: 0.75rem;
            font-weight: 700;
            display: inline-block;
            white-space: nowrap;
        }

        .badge-active {
            background: #d4edda;
            color: #0f6b3a;
        }

        .badge-pending {
            background: #fef3d7;
            color: #8a6d0b;
        }

        /* ----- quick action bottom ----- */
        .quick-action-box {
            background: linear-gradient(135deg, rgba(44,140,153,0.04), rgba(44,140,153,0.10));
            border-radius: 24px;
            padding: 1.5rem 2rem;
            border: 1px solid rgba(44,140,153,0.15);
        }

            .quick-action-box .action-row {
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                gap: 1rem;
                justify-content: space-between;
            }

            .quick-action-box select {
                padding: 0.5rem 1.4rem;
                border-radius: 60px;
                border: 1px solid #dce9ef;
                background: white;
                font-weight: 500;
                font-size: 0.9rem;
                flex: 1;
                min-width: 150px;
            }

        /* ----- responsive ----- */
        @@media (max-width: 1200px) {
            .stat-grid {
                grid-template-columns: repeat(4, 1fr);
                gap: 0.8rem;
            }
        }

        @@media (max-width: 992px) {
            .stat-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 0.8rem;
            }

            .grid-2col {
                grid-template-columns: 1fr;
                gap: 1.2rem;
            }

            .admin-header h2 {
                font-size: 1.8rem;
            }

            .stat-left .stat-number {
                font-size: 2.4rem;
            }
        }

        @@media (max-width: 640px) {
            body {
                /* padding: 10px 8px; */
                font-size: 16px;
            }

            .admin-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 0.6rem;
                padding: 1rem 1.2rem;
                border-radius: 20px;
            }

                .admin-header h2 {
                    font-size: 1.5rem;
                }

                .admin-header .badge-role {
                    font-size: 0.8rem;
                    padding: 0.3rem 1rem;
                }

                .admin-header .header-date {
                    font-size: 0.85rem;
                    padding: 0.3rem 1.2rem;
                    align-self: flex-start;
                    white-space: normal;
                }

            .stat-grid {
                grid-template-columns: 1fr 1fr;
                gap: 0.6rem;
            }

            .stat-card {
                padding: 0.7rem 0.8rem;
                min-height: 70px;
                border-left-width: 4px;
                border-radius: 16px;
            }

            .stat-left .stat-number {
                font-size: 1.8rem;
            }

            .stat-left .stat-label {
                font-size: 0.75rem;
            }

            .stat-left .stat-sub {
                font-size: 0.65rem;
            }

            .stat-icon {
                width: 40px;
                height: 40px;
                font-size: 1.4rem;
                border-radius: 12px;
            }

            .card-modern {
                padding: 1rem 0.8rem;
                border-radius: 18px;
            }

            .section-title {
                font-size: 1.1rem;
            }

            .tech-item {
                padding: 0.5rem 0.8rem;
                border-radius: 40px;
            }

                .tech-item .tech-name {
                    font-size: 0.9rem;
                }

                .tech-item .tech-status {
                    font-size: 0.7rem;
                    padding: 0.1rem 0.8rem;
                }

            .btn-teal-outline {
                font-size: 0.7rem;
                padding: 0.2rem 0.8rem;
            }

            .btn-teal-solid {
                font-size: 0.75rem;
                padding: 0.3rem 1.2rem;
            }

            .feedback-item, .complaint-item {
                padding: 0.5rem 0.7rem;
                font-size: 0.85rem;
                border-left-width: 3px;
                border-radius: 12px;
            }

                .feedback-item .stars {
                    font-size: 0.8rem;
                }

                .complaint-item .complaint-badge {
                    font-size: 0.65rem;
                    padding: 0.1rem 0.7rem;
                }

            .assign-box {
                padding: 0.7rem 0.8rem;
                border-radius: 16px;
            }

            .table-custom {
                font-size: 0.8rem;
                min-width: 400px;
            }

                .table-custom th,
                .table-custom td {
                    padding: 0.4rem 0.4rem;
                    font-size: 0.75rem;
                }

            .quick-action-box {
                padding: 0.8rem 0.8rem;
                border-radius: 18px;
            }

                .quick-action-box .action-row {
                    flex-direction: column;
                    align-items: stretch;
                    gap: 0.6rem;
                }

                .quick-action-box select {
                    max-width: 100%;
                    min-width: unset;
                    width: 100%;
                    font-size: 0.85rem;
                    padding: 0.4rem 1rem;
                }
        }

        @@media (max-width: 420px) {
            .stat-grid {
                grid-template-columns: 1fr 1fr;
                gap: 0.5rem;
            }

            .stat-card {
                padding: 0.5rem 0.6rem;
                min-height: 60px;
            }

            .stat-left .stat-number {
                font-size: 1.5rem;
            }

            .stat-left .stat-label {
                font-size: 0.65rem;
            }

            .stat-icon {
                width: 34px;
                height: 34px;
                font-size: 1.1rem;
            }

            .admin-header h2 {
                font-size: 1.2rem;
            }

            .card-modern {
                padding: 0.7rem 0.6rem;
            }

            .tech-item {
                flex-wrap: wrap;
                gap: 0.3rem;
            }

            .table-custom {
                min-width: 320px;
                font-size: 0.7rem;
            }
        }

        /* extras */
        .flex-between {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        .gap-1 {
            gap: 0.5rem;
        }

        .mt-2 {
            margin-top: 1.2rem;
        }

        .mb-1 {
            margin-bottom: 0.5rem;
        }

        .fw-600 {
            font-weight: 600;
        }

        .text-muted-soft {
            color: #6b8a96;
        }

        .bg-soft-teal {
            background: var(--primary-soft);
        }

        .text-center {
            text-align: center;
        }

        .py-4 {
            padding-top: 1.5rem;
            padding-bottom: 1.5rem;
        }

        .py-3 {
            padding-top: 0.8rem;
            padding-bottom: 0.8rem;
        }

        .text-muted {
            color: #8ba3ae;
        }

        .table-custom .badge {
            padding: 0.25rem 1rem;
            border-radius: 60px;
            font-size: 0.75rem;
            font-weight: 700;
            white-space: nowrap;
        }
    </style>
</head>
<body>
    <div class="admin-wrap">

        <!-- HEADER -->
        <div class="admin-header">

            <!-- LEFT SIDE -->
            <div style="flex:1; min-width:200px;">
                <h2>
                    <i class="fas fa-user-shield"></i>
                    Technician Admin
                </h2>

                <div class="header-badges">

                    <span class="badge-role">
                        <i class="fas fa-user"></i>
                        @Model.AdminName
                    </span>

                    <span class="badge-role">
                        <i class="fas fa-wrench"></i>
                        @Model.TotalTechnicians Technicians
                    </span>

                    <span class="badge-role">
                        <i class="fas fa-exchange-alt"></i>
                        Manage & Track
                    </span>

                </div>
            </div>

            <!-- RIGHT SIDE -->
            <div class="header-date">

                <i class="far fa-calendar-alt"></i>
                @Model.CurrentDateTime.ToString("dd MMM yyyy")

                &nbsp;·&nbsp;

                <i class="far fa-clock"></i>
                @Model.CurrentDateTime.ToString("hh:mm tt")

            </div>

        </div>

        <!-- STATS: Customers, Technicians, Services, Warranty -->
        <div class="stat-grid">

            <!-- Customers -->
            <div class="stat-card">
                <div class="stat-left">
                    <div class="stat-label">
                        <i class="fas fa-users" style="color:#2c8c99;"></i> Customers
                    </div>
                    <div class="stat-number">@Model.TotalCustomers</div>
                    <div class="stat-sub">Total customers</div>
                </div>
                <div class="stat-icon"><i class="fas fa-user-friends"></i></div>
            </div>

            <!-- Technicians -->
            <div class="stat-card" style="border-left-color:#27ae60;">
                <div class="stat-left">
                    <div class="stat-label">
                        <i class="fas fa-user-gear" style="color:#27ae60;"></i> Technicians
                    </div>
                    <div class="stat-number">@Model.TotalTechnicians</div>
                    <div class="stat-sub">
                        @Model.ActiveTechnicians active · @Model.AvailableTechnicians avail
                    </div>
                </div>
                <div class="stat-icon" style="color:#27ae60;">
                    <i class="fas fa-hard-hat"></i>
                </div>
            </div>

            <!-- Services -->
            <div class="stat-card" style="border-left-color:#2980b9;">
                <div class="stat-left">
                    <div class="stat-label">
                        <i class="fas fa-screwdriver-wrench" style="color:#2980b9;"></i> Services
                    </div>
                    <div class="stat-number">@Model.TotalServices</div>
                    <div class="stat-sub">
                        @Model.ActiveServices active · @Model.CompletedServices done
                    </div>
                </div>
                <div class="stat-icon" style="color:#2980b9;">
                    <i class="fas fa-clipboard-list"></i>
                </div>
            </div>

            <!-- Warranty -->
            <div class="stat-card" style="border-left-color:#f39c12;">
                <div class="stat-left">
                    <div class="stat-label">
                        <i class="fas fa-shield-halved" style="color:#f39c12;"></i> Warranty
                    </div>
                    <div class="stat-number">@Model.WarrantyCases</div>
                    <div class="stat-sub">
                        @Model.ExpiringWarranty expiring soon
                    </div>
                </div>
                <div class="stat-icon" style="color:#f39c12;">
                    <i class="fas fa-clock"></i>
                </div>
            </div>

        </div>

        <!-- 2-col: Manage Technicians + Feedback & Complaints -->
        <div class="grid-2col">

            <!-- LEFT: Technician management -->
            <div class="card-modern">

                <div class="section-title">
                    <i class="fas fa-user-cog"></i>
                    Manage Technicians
                </div>

                @if (Model.Technicians != null && Model.Technicians.Count > 0)
                {
                    foreach (var tech in Model.Technicians.Take(4))
                    {
                        <div class="tech-item">

                            <span class="tech-name">

                                @if (tech.LeaveDate != null)
                                {
                                    <i class="fas fa-circle"
                                       style="color:#e67e22;font-size:0.5rem;"></i>
                                }
                                else if (tech.IsAvailable)
                                {
                                    <i class="fas fa-circle"
                                       style="color:#27ae60;font-size:0.5rem;"></i>
                                }
                                else
                                {
                                    <i class="fas fa-circle"
                                       style="color:#f1c40f;font-size:0.5rem;"></i>
                                }

                                @tech.Name

                            </span>

                            <span class="tech-status"
                                  style="@(tech.LeaveDate!=null
                            ? "background:#fee2d7;color:#b85a2b;"
                            : tech.IsAvailable
                                ? ""
                                : "background:#fef3d7;color:#8a6d0b;")">

                                @if (tech.LeaveDate != null)
                                {
                                    @:On Leave
                                }
                                else if (tech.IsAvailable)
                                {
                                    @:Available
                                }
                                else
                                {
                                    @:Busy
                                }

                            </span>

                            <a asp-controller="AdminService"
                               asp-action="Calendar"
                               asp-route-id="@tech.TechnicianId"
                               class="btn-teal-outline">

                                <i class="fas fa-calendar-alt"></i>
                                Calendar

                            </a>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        No technicians found.
                    </div>
                }

                <!-- Bottom Card -->
                <div class="assign-box">

                    <div class="assign-row">

                        <div style="flex:1; min-width:140px;">

                            <strong style="color:#2c8c99; font-size:0.95rem;">
                                Total : @Model.TotalTechnicians
                            </strong>

                            <br />

                            <small style="color:#5f7a88; font-size:0.8rem;">
                                <span style="display:inline-block;">Avail : @Model.AvailableTechnicians</span>
                                <span style="display:inline-block; margin-left:0.5rem;">Busy : @Model.BusyTechnicians</span>
                                <span style="display:inline-block; margin-left:0.5rem;">Leave : @Model.OnLeaveTechnicians</span>
                            </small>

                        </div>

                        <a asp-controller="Users"
                           asp-action="Create"
                           class="btn-teal-solid">

                            <i class="fas fa-plus-circle"></i>
                            Add

                        </a>

                    </div>

                    <div style="font-size:0.75rem;color:#5f7a88;margin-top:10px;">

                        <i class="fas fa-info-circle"
                           style="color:#2c8c99;"></i>

                        Manage technicians from Technician Management.

                    </div>

                </div>

                <div style="margin-top:1rem;
                background:#eef6f9;
                border-radius:30px;
                padding:0.5rem 1rem;
                font-size:0.85rem;">

                    <i class="fas fa-calendar-check"
                       style="color:#2c8c99;"></i>

                    <strong>Today's Available :</strong>

                    @Model.AvailableTechnicians /

                    @Model.TotalTechnicians

                </div>

            </div>

            <!-- RIGHT: Feedback & Complaints -->
            <div class="card-modern">

                <div class="section-title">
                    <i class="fas fa-comment-dots"></i> Feedback & Complaints
                </div>

                <!-- FEEDBACK -->
                <div style="margin-bottom:0.8rem; font-weight:600; color:#2c8c99; font-size:1rem;">
                    <i class="fas fa-star" style="color:#f1c40f;"></i>
                    Recent Feedback (Avg: @Model.AverageRating.ToString("0.0"))
                </div>

                @if (Model.RecentFeedbacks?.Any() == true)
                {
                    foreach (var f in Model.RecentFeedbacks)
                    {
                        <div class="feedback-item">
                            <span style="font-size:0.9rem;">
                                <i class="fas fa-user-circle"></i>
                                @(f.Customer?.Name ?? "Unknown")
                            </span>

                            <span class="stars">
                                @string.Concat(Enumerable.Repeat("★", f.Rating))
                            </span>

                            <span style="color:#5f7a88;font-size:0.8rem; max-width:150px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                                "@f.Comment"
                            </span>
                        </div>
                    }
                }

                <!-- COMPLAINTS -->
                <div style="margin-top:1rem; font-weight:600; color:#e67e22; font-size:1rem;">
                    <i class="fas fa-exclamation-triangle"></i>
                    Complaints
                    <small style="font-size:0.75rem; display:block; color:#5f7a88; font-weight:400;">
                        @Model.NewComplaints New · @Model.InProgressComplaints In Progress · @Model.ResolvedComplaints Resolved
                    </small>
                </div>

                @if (Model.RecentComplaints?.Any() == true)
                {
                    foreach (var c in Model.RecentComplaints)
                    {
                        <div class="complaint-item">

                            <span style="font-size:0.9rem;">
                                <i class="fas fa-file-signature"></i>
                                @c.Title
                            </span>

                            <span style="font-size:0.75rem; color:#5f7a88;">
                                @c.Customer?.Name
                            </span>

                            <span class="complaint-badge
                      @(c.Status=="New"?"new":
                        c.Status=="In Progress"?"progress":"resolved")">
                                @c.Status
                            </span>

                        </div>
                    }
                }

                <!-- FOOTER -->
                <div style="margin-top:1rem; background:var(--primary-soft);
                border-radius:60px; padding:0.4rem 1.2rem;
                display:inline-block; font-size:0.85rem;">

                    <i class="fas fa-arrow-right" style="color:#2c8c99;"></i>
                    <strong>Forward complaints</strong> to assigned technician
                </div>

            </div>
        </div>

        <!-- Recent service records + Assign preview -->
        <div class="card-modern" style="margin-bottom:1.8rem;">
            <div class="flex-between">
                <div class="section-title" style="margin-bottom:0; border-bottom:0; padding-bottom:0;">
                    <i class="fas fa-history"></i> Recent Service Records
                </div>
                <span style="background:var(--primary-soft); padding:0.25rem 1.4rem; border-radius:60px; font-size:0.85rem; font-weight:600; color:var(--primary-dark);">
                    <i class="fas fa-user-cog"></i> Assigned to technicians
                </span>
            </div>
            <div class="table-wrap">
                <table class="table-custom">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Customer</th>
                            <th>Technician</th>
                            <th>Status</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentServiceRecords != null && Model.RecentServiceRecords.Any())
                        {
                            foreach (var item in Model.RecentServiceRecords)
                            {
                                <tr>
                                    <td><strong>#SR-@item.ServiceId</strong></td>
                                    <td>@item.Customer?.Name</td>
                                    <td>
                                        @(item.Technician?.Name ?? "<span style='color:#f39c12'>Unassigned</span>")
                                    </td>
                                    <td>
                                        <span class="badge-status"
                                              style="background-color:
                      @(item.Status == "Completed" ? "#27ae60" :
                        item.Status == "In Progress" ? "#f39c12" :
                        item.Status == "Assigned" ? "#2c8c99" :
                        "#f1c40f");
                      color:white;">
                                            @item.Status
                                        </span>
                                    </td>
                                    <td>@item.CreatedAt.ToString("dd MMM yyyy")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-3">
                                    No service records found
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div style="margin-top:1rem; display:flex; gap:1.5rem; flex-wrap:wrap; font-size:0.85rem; color:#5f7a88;">

                <span>
                    <i class="fas fa-check-circle" style="color:#27ae60;"></i>
                    @(Model.RecentServiceRecords?.Count(x => x.Status == "Completed") ?? 0) completed
                </span>

                <span>
                    <i class="fas fa-hourglass-half" style="color:#f1c40f;"></i>
                    @(Model.RecentServiceRecords?.Count(x => x.Status == "Pending") ?? 0) pending
                </span>

                <span>
                    <i class="fas fa-user-plus" style="color:var(--primary);"></i>
                    @(Model.RecentServiceRecords?.Count(x => x.TechnicianId == null) ?? 0) unassigned
                </span>

            </div>
        </div>

        <!-- Quick action: assign technician to customer complaint/feedback -->
        <div class="quick-action-box">
            <div class="action-row">
                <div>
                    <i class="fas fa-link" style="color:var(--primary);"></i>
                    <span style="font-weight:600; color:var(--primary-dark); font-size:1rem;">Assign technician</span>
                    <span style="display:block; font-size:0.85rem; color:#5f7a88;">Select from customer list and assign</span>
                </div>
                <div style="display:flex; gap:0.6rem; flex-wrap:wrap; flex:1; min-width:200px;">
                    <select name="customerId">
                        @foreach (var c in Model.Customers)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                    <select name="technicianId">
                        @foreach (var t in Model.Technicians)
                        {
                            <option value="@t.TechnicianId">@t.Name</option>
                        }
                    </select>
                    <button class="btn-teal-solid" style="flex:0 0 auto;"><i class="fas fa-check"></i> Assign</button>
                </div>
            </div>
        </div>

        <!-- footer -->
        <div style="margin-top: 2.5rem; text-align: center; font-size:0.85rem; color:#8ba3ae; border-top:1px solid #dce9ef; padding-top:1.5rem;">
            <i class="fas fa-circle" style="color:var(--primary); font-size:0.4rem;"></i> Technician Admin Dashboard
        </div>

    </div>
    <script>
        setInterval(() => {
            const now = new Date();
            const time = now.toLocaleTimeString();
            const clockEl = document.querySelector('.header-date');
            if (clockEl) {
                const datePart = clockEl.innerHTML.split('·')[0];
                clockEl.innerHTML = datePart + '· <i class="far fa-clock"></i> ' + time;
            }
        }, 1000);
    </script>
</body>
</html>