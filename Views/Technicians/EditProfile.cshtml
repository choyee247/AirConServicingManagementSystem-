@model AirConServicingManagementSystem.Models.TechnicianProfileVM

@{
    ViewData["Title"] = "Edit Profile";
    Layout = "~/Views/Shared/_TechnicianLayout.cshtml";
}

<style>
    :root {
        --primary-color: #2c8c99;
        --primary-dark: #1a6b77;
        --primary-light: #4ca6b3;
        --primary-soft: rgba(44, 140, 153, 0.08);
        --primary-opacity-10: rgba(44, 140, 153, 0.10);
        --font-base: 17px;
    }

    /* ----- Base ----- */
    body {
        font-size: var(--font-base);
    }

    .container {
        padding: 16px 14px !important;
        max-width: 100% !important;
    }

    /* ----- Form Card ----- */
    .form-card {
        border-radius: 24px !important;
        border: 1px solid rgba(44, 140, 153, 0.06) !important;
        box-shadow: 0 8px 32px rgba(44, 140, 153, 0.08) !important;
        overflow: hidden;
        max-width: 800px;
        margin: 0 auto;
    }

        .form-card .card-header {
            background: linear-gradient(135deg, var(--primary-color), var(--primary-dark)) !important;
            color: white;
            padding: 1.5rem 2rem !important;
            border-bottom: none !important;
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
        }

            .form-card .card-header h4 {
                font-size: 1.6rem;
                font-weight: 700;
                margin-bottom: 0;
                display: flex;
                align-items: center;
                gap: 0.8rem;
            }

                .form-card .card-header h4 i {
                    font-size: 1.6rem;
                }

            .form-card .card-header .form-badge {
                background: rgba(255,255,255,0.2);
                padding: 0.3rem 1.2rem;
                border-radius: 60px;
                font-size: 0.85rem;
                font-weight: 600;
                backdrop-filter: blur(4px);
                border: 1px solid rgba(255,255,255,0.1);
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
            }

        .form-card .card-body {
            padding: 2rem !important;
            background: #ffffff;
        }

    /* ----- Form Elements ----- */
    .form-group {
        margin-bottom: 1.5rem;
    }

        .form-group .form-label {
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--primary-dark);
            margin-bottom: 0.4rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

            .form-group .form-label i {
                color: var(--primary-color);
                width: 20px;
                font-size: 0.95rem;
            }

            .form-group .form-label .required {
                color: #e74c3c;
                font-weight: 700;
                font-size: 1.1rem;
            }

        .form-group .form-control {
            font-size: 0.95rem;
            padding: 0.6rem 1rem;
            border-radius: 12px;
            border: 2px solid #e9ecef;
            transition: 0.2s;
            background: #f8fafc;
            color: #1e293b;
            width: 100%;
            box-sizing: border-box;
        }

            .form-group .form-control:focus {
                border-color: var(--primary-color);
                box-shadow: 0 0 0 4px rgba(44, 140, 153, 0.12);
                background: #ffffff;
                outline: none;
            }

            .form-group .form-control[readonly] {
                background: #e9ecef;
                color: #6c757d;
                cursor: not-allowed;
            }

        .form-group textarea.form-control {
            resize: vertical;
            min-height: 80px;
            font-family: inherit;
        }

        .form-group .text-danger {
            font-size: 0.8rem;
            margin-top: 0.3rem;
            display: block;
        }

    /* ----- Row Layout for Side by Side ----- */
    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
    }

    /* ----- Action Buttons ----- */
    .form-actions {
        display: flex;
        gap: 0.8rem;
        flex-wrap: wrap;
        margin-top: 1.5rem;
        padding-top: 1.5rem;
        border-top: 2px solid rgba(44, 140, 153, 0.06);
    }

    .btn-form {
        padding: 0.7rem 2rem;
        border-radius: 60px;
        font-weight: 600;
        font-size: 0.95rem;
        border: none;
        transition: 0.2s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        cursor: pointer;
    }

        .btn-form:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 24px rgba(0,0,0,0.12);
        }

        .btn-form:active {
            transform: translateY(0);
        }

    .btn-save {
        background: #28a745;
        color: white;
    }

        .btn-save:hover {
            background: #1e7e34;
            color: white;
        }

    .btn-cancel {
        background: #6c757d;
        color: white;
    }

        .btn-cancel:hover {
            background: #5a6268;
            color: white;
        }

    .btn-reset {
        background: #ffc107;
        color: #1e2a32;
    }

        .btn-reset:hover {
            background: #e0a800;
            color: #1e2a32;
        }

    /* ----- Responsive ----- */
    @@media (max-width: 992px) {
        .container

    {
        padding: 12px 10px !important;
    }

    .form-card .card-header h4 {
        font-size: 1.3rem;
    }

    .form-card .card-header .form-badge {
        font-size: 0.75rem;
        padding: 0.25rem 1rem;
    }

    .form-card .card-body {
        padding: 1.5rem !important;
    }

    .form-group .form-control {
        font-size: 0.9rem;
        padding: 0.5rem 0.9rem;
    }

    .form-group .form-label {
        font-size: 0.85rem;
    }

    }

    @@media (max-width: 768px) {
        body

    {
        font-size: 16px;
    }

    .container {
        padding: 10px 6px !important;
    }

    .form-card {
        border-radius: 18px !important;
    }

        .form-card .card-header {
            padding: 1rem 1.2rem !important;
            flex-direction: column;
            align-items: flex-start;
        }

            .form-card .card-header h4 {
                font-size: 1.1rem;
            }

                .form-card .card-header h4 i {
                    font-size: 1.2rem;
                }

            .form-card .card-header .form-badge {
                font-size: 0.65rem;
                padding: 0.2rem 0.8rem;
                align-self: flex-start;
            }

        .form-card .card-body {
            padding: 1rem !important;
        }

    .form-group {
        margin-bottom: 1rem;
    }

        .form-group .form-label {
            font-size: 0.8rem;
        }

            .form-group .form-label i {
                font-size: 0.8rem;
                width: 18px;
            }

        .form-group .form-control {
            font-size: 0.85rem;
            padding: 0.45rem 0.8rem;
            border-radius: 10px;
        }

    .form-row {
        grid-template-columns: 1fr;
        gap: 0;
    }

    .form-actions {
        flex-direction: column;
        gap: 0.6rem;
        padding-top: 1rem;
        margin-top: 1rem;
    }

    .btn-form {
        padding: 0.5rem 1.2rem;
        font-size: 0.85rem;
        justify-content: center;
        width: 100%;
    }

    }

    @@media (max-width: 480px) {
        body

    {
        font-size: 15px;
    }

    .container {
        padding: 6px 3px !important;
    }

    .form-card {
        border-radius: 14px !important;
    }

        .form-card .card-header {
            padding: 0.7rem 0.8rem !important;
        }

            .form-card .card-header h4 {
                font-size: 0.95rem;
            }

                .form-card .card-header h4 i {
                    font-size: 1rem;
                }

            .form-card .card-header .form-badge {
                font-size: 0.55rem;
                padding: 0.15rem 0.6rem;
            }

        .form-card .card-body {
            padding: 0.7rem !important;
        }

    .form-group {
        margin-bottom: 0.8rem;
    }

        .form-group .form-label {
            font-size: 0.7rem;
        }

            .form-group .form-label i {
                font-size: 0.7rem;
                width: 16px;
            }

        .form-group .form-control {
            font-size: 0.75rem;
            padding: 0.35rem 0.6rem;
            border-radius: 8px;
            border-width: 1.5px;
        }

        .form-group textarea.form-control {
            min-height: 60px;
        }

        .form-group .text-danger {
            font-size: 0.65rem;
        }

    .btn-form {
        padding: 0.4rem 1rem;
        font-size: 0.75rem;
        border-radius: 50px;
    }

    }

    /* ----- Dark Mode ----- */
    [data-bs-theme="dark"] .form-card {
        background: #2d2d2d !important;
        border-color: #495057 !important;
    }

        [data-bs-theme="dark"] .form-card .card-body {
            background: #2d2d2d !important;
        }

    [data-bs-theme="dark"] .form-group .form-label {
        color: rgba(44, 140, 153, 0.9) !important;
    }

    [data-bs-theme="dark"] .form-group .form-control {
        background: #3d3d3d !important;
        border-color: #495057 !important;
        color: #e0e0e0 !important;
    }

        [data-bs-theme="dark"] .form-group .form-control:focus {
            background: #3d3d3d !important;
            border-color: var(--primary-color) !important;
            box-shadow: 0 0 0 4px rgba(44, 140, 153, 0.15) !important;
        }

        [data-bs-theme="dark"] .form-group .form-control[readonly] {
            background: #3d3d3d !important;
            color: #a0a0a0 !important;
            border-color: #495057 !important;
        }

    [data-bs-theme="dark"] .form-actions {
        border-color: #495057 !important;
    }

    [data-bs-theme="dark"] .form-card .card-header .form-badge {
        background: rgba(255,255,255,0.1) !important;
        border-color: rgba(255,255,255,0.05) !important;
    }

    /* ----- Validation Styles ----- */
    .input-validation-error {
        border-color: #e74c3c !important;
        background: #fff5f5 !important;
    }

        .input-validation-error:focus {
            border-color: #e74c3c !important;
            box-shadow: 0 0 0 4px rgba(231, 76, 60, 0.12) !important;
        }

    [data-bs-theme="dark"] .input-validation-error {
        background: #3d1a1a !important;
        border-color: #e74c3c !important;
    }

    /* ----- Loading Spinner ----- */
    .btn-form .spinner {
        display: none;
        width: 16px;
        height: 16px;
        border: 2px solid rgba(255,255,255,0.3);
        border-top-color: white;
        border-radius: 50%;
        animation: spin 0.6s linear infinite;
    }

    .btn-form.loading .spinner {
        display: inline-block;
    }

    .btn-form.loading .btn-text {
        opacity: 0.7;
    }

    @@keyframes spin {
        to

    {
        transform: rotate(360deg);
    }

    }

    /* ----- Success Message ----- */
    .alert-success-custom {
        background: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
        border-radius: 12px;
        padding: 0.8rem 1rem;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.95rem;
    }

        .alert-success-custom i {
            font-size: 1.2rem;
        }

    [data-bs-theme="dark"] .alert-success-custom {
        background: #1a3d1a;
        color: #8fdf8f;
        border-color: #2d5a2d;
    }
</style>

<div class="container py-2 py-md-4">

    <div class="form-card card shadow">

        <!-- HEADER -->
        <div class="card-header">
            <h4>
                <i class="fa fa-user-edit"></i>
                Edit Profile
            </h4>
            <span class="form-badge">
                <i class="fa-regular fa-clock"></i>
                Update your information
            </span>
        </div>

        <!-- BODY -->
        <div class="card-body">

            <!-- Success Message (if any) -->
            @if (TempData["Success"] != null)
            {
                <div class="alert-success-custom">
                    <i class="fa-regular fa-circle-check"></i>
                    @TempData["Success"]
                </div>
            }

            <form asp-action="EditProfile" method="post" id="editProfileForm">

                @Html.AntiForgeryToken()

                <!-- Hidden Fields -->
                <input type="hidden" asp-for="TechnicianId" />

                <!-- Full Name -->
                <div class="form-group">
                    <label class="form-label" asp-for="Name">
                        <i class="fa-regular fa-user"></i>
                        Full Name
                        <span class="required">*</span>
                    </label>
                    <input asp-for="Name" class="form-control" placeholder="Enter your full name" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <!-- Phone Number -->
                <div class="form-group">
                    <label class="form-label" asp-for="PhoneNumber">
                        <i class="fa-regular fa-phone"></i>
                        Phone Number
                        <span class="required">*</span>
                    </label>
                    <input asp-for="PhoneNumber" class="form-control" placeholder="Enter your phone number" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>

                <!-- Address -->
                <div class="form-group">
                    <label class="form-label" asp-for="Address">
                        <i class="fa-regular fa-location-dot"></i>
                        Address
                        <span class="required">*</span>
                    </label>
                    <textarea asp-for="Address" class="form-control" rows="3" placeholder="Enter your address"></textarea>
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                <!-- Row: Role + Join Date -->
                <div class="form-row">

                    <!-- Role (Read Only) -->
                    <div class="form-group">
                        <label class="form-label">
                            <i class="fa-regular fa-user-tie"></i>
                            Role
                        </label>
                        <input asp-for="TechnicianRole" class="form-control" readonly />
                    </div>

                    <!-- Join Date (Read Only) -->
                    <div class="form-group">
                        <label class="form-label">
                            <i class="fa-regular fa-calendar-plus"></i>
                            Join Date
                        </label>
                        <input value="@Model.JoinDate?.ToString("yyyy-MM-dd")" class="form-control" readonly />
                    </div>

                </div>

                <!-- Form Actions -->
                <div class="form-actions">

                    <button type="submit" class="btn-form btn-save" id="saveBtn">
                        <i class="fa-regular fa-floppy-disk"></i>
                        <span class="btn-text">Save Changes</span>
                        <span class="spinner"></span>
                    </button>

                    <a asp-action="Profile" class="btn-form btn-cancel">
                        <i class="fa-regular fa-xmark"></i>
                        Cancel
                    </a>

                    <button type="reset" class="btn-form btn-reset">
                        <i class="fa-regular fa-rotate-right"></i>
                        Reset
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function() {

            // ============================================
            // LOADING SPINNER ON FORM SUBMIT
            // ============================================
            const form = document.getElementById('editProfileForm');
            const saveBtn = document.getElementById('saveBtn');

            if (form && saveBtn) {
                form.addEventListener('submit', function(e) {

                    // Check if form is valid
                    if (form.checkValidity()) {
                        saveBtn.classList.add('loading');
                        saveBtn.disabled = true;
                    }

                });
            }

            // ============================================
            // AUTO-RESIZE TEXTAREA
            // ============================================
            const textareas = document.querySelectorAll('textarea');

            textareas.forEach(textarea => {
                textarea.addEventListener('input', function() {
                    this.style.height = 'auto';
                    this.style.height = this.scrollHeight + 'px';
                });
            });

            // ============================================
            // REAL-TIME VALIDATION STYLING
            // ============================================
            const inputs = document.querySelectorAll('.form-control:not([readonly])');

            inputs.forEach(input => {
                input.addEventListener('blur', function() {
                    if (this.value.trim() === '') {
                        this.classList.add('input-validation-error');
                    } else {
                        this.classList.remove('input-validation-error');
                    }
                });

                input.addEventListener('input', function() {
                    if (this.value.trim() !== '') {
                        this.classList.remove('input-validation-error');
                    }
                });
            });

            // ============================================
            // RESET BUTTON - Clear validation errors
            // ============================================
            const resetBtn = document.querySelector('.btn-reset');

            if (resetBtn) {
                resetBtn.addEventListener('click', function(e) {
                    // Clear validation errors
                    document.querySelectorAll('.input-validation-error').forEach(el => {
                        el.classList.remove('input-validation-error');
                    });

                    // Reset textarea height
                    document.querySelectorAll('textarea').forEach(textarea => {
                        textarea.style.height = 'auto';
                    });
                });
            }

        });
    </script>
}