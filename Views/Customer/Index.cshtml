@model IEnumerable<AirConServicingManagementSystem.Models.Customer>

@{
    ViewData["Title"] = "Customer Management";
    Layout = "~/Views/Shared/_TechnicianLayout.cshtml";
}

<style>
    :root {
        --primary-color: #2c8c99;
        --primary-dark: #1a6b77;
        --primary-light: #4ca6b3;
        --primary-soft: rgba(44, 140, 153, 0.08);
        --primary-opacity-10: rgba(44, 140, 153, 0.10);
        --primary-opacity-20: rgba(44, 140, 153, 0.20);
    }

    /* ----- Base Styles ----- */
    body {
        font-size: 17px;
    }

    .container-fluid {
        padding: 16px 12px !important;
    }

    /* ----- Primary Color Utilities ----- */
    .text-primary {
        color: var(--primary-color) !important;
    }

    .bg-primary {
        background-color: var(--primary-color) !important;
    }

    .border-primary {
        border-color: var(--primary-color) !important;
    }

    .btn-primary {
        background-color: var(--primary-color);
        border-color: var(--primary-color);
        color: white;
        font-size: 0.95rem;
        padding: 0.5rem 1.4rem;
    }

        .btn-primary:hover {
            background-color: var(--primary-dark);
            border-color: var(--primary-dark);
            color: white;
        }

    .btn-outline-primary {
        color: var(--primary-color);
        border-color: var(--primary-color);
        font-size: 0.85rem;
        padding: 0.4rem 1rem;
    }

        .btn-outline-primary:hover {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
            color: white;
        }

    .bg-gradient-primary {
        background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%) !important;
    }

    .bg-primary-opacity-10 {
        background-color: var(--primary-opacity-10) !important;
    }

    .bg-primary-opacity-25 {
        background-color: var(--primary-opacity-20) !important;
    }

    .text-primary-opacity-75 {
        color: rgba(44, 140, 153, 0.75) !important;
    }

    /* ----- Cards & Shadows ----- */
    .card {
        border-radius: 20px !important;
        border: 1px solid rgba(44, 140, 153, 0.06) !important;
        box-shadow: 0 4px 16px rgba(44, 140, 153, 0.06) !important;
    }

    .card-body {
        padding: 1.2rem 1rem !important;
    }

    .card-header {
        background: white !important;
        border-bottom: 1px solid rgba(44, 140, 153, 0.06) !important;
        padding: 1rem 1.2rem !important;
    }

    /* ----- Header Section ----- */
    .page-header h2 {
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--primary-color);
        margin-bottom: 0.2rem;
    }

    .page-header p {
        font-size: 0.95rem;
        color: #6c757d;
        margin-bottom: 0;
    }

    /* ----- Stats Cards ----- */
    .stat-card {
        border-radius: 18px !important;
        padding: 0.8rem 1rem !important;
        min-height: 80px;
    }

        .stat-card .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            flex-shrink: 0;
        }

        .stat-card .stat-number {
            font-size: 2rem;
            font-weight: 800;
            line-height: 1.2;
            margin-bottom: 0;
        }

        .stat-card .stat-label {
            font-size: 0.75rem;
            opacity: 0.75;
            font-weight: 500;
        }

    /* ----- Search & Filter ----- */
    .filter-section .input-group-text {
        background: #f8f9fa;
        border-right: none;
        font-size: 0.9rem;
        padding: 0.5rem 0.8rem;
    }

    .filter-section .form-control,
    .filter-section .form-select {
        font-size: 0.9rem;
        padding: 0.5rem 0.8rem;
        border-radius: 10px !important;
    }

    .filter-section .form-control {
        border-left: none;
    }

    .filter-section .input-group .form-control:focus {
        border-color: var(--primary-color);
        box-shadow: none;
    }

    .filter-section .form-select:focus {
        border-color: var(--primary-color);
        box-shadow: 0 0 0 0.2rem rgba(44, 140, 153, 0.15);
    }

    /* ----- Table ----- */
    .table {
        font-size: 0.95rem;
        margin-bottom: 0;
    }

        .table th {
            font-weight: 600;
            font-size: 0.85rem;
            color: var(--primary-color);
            border-bottom: 2px solid rgba(44, 140, 153, 0.10);
            padding: 0.8rem 1rem;
            background: var(--primary-opacity-10);
        }

        .table td {
            vertical-align: middle;
            padding: 0.8rem 1rem;
            border-bottom: 1px solid rgba(44, 140, 153, 0.06);
        }

    .customer-row:hover {
        background-color: var(--primary-opacity-10);
        transition: background-color 0.2s;
    }

    .customer-row .avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        flex-shrink: 0;
    }

    .customer-row .customer-name {
        font-size: 1rem;
        font-weight: 600;
        color: var(--primary-color);
        margin-bottom: 0;
    }

    .customer-row .customer-id {
        font-size: 0.75rem;
        color: rgba(44, 140, 153, 0.6);
    }

    .customer-row .customer-phone {
        font-size: 0.9rem;
        font-weight: 500;
    }

    .customer-row .customer-address {
        font-size: 0.85rem;
        max-width: 200px;
        display: inline-block;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* ----- Badges ----- */
    .badge-status {
        padding: 0.2rem 0.9rem;
        border-radius: 40px;
        font-size: 0.7rem;
        font-weight: 600;
    }

    .badge-active {
        background: var(--primary-opacity-10);
        color: var(--primary-color);
        border: 1px solid rgba(44, 140, 153, 0.2);
    }

    /* ----- Buttons in Table ----- */
    .table .btn-group .btn {
        border-radius: 8px !important;
        margin: 0 3px;
        padding: 0.3rem 0.7rem;
        font-size: 0.8rem;
        border: 1px solid rgba(44, 140, 153, 0.15);
    }

        .table .btn-group .btn:hover {
            background: var(--primary-color);
            color: white;
            border-color: var(--primary-color);
        }

    /* ----- Mobile List View ----- */
    .mobile-customer-item {
        padding: 0.8rem 0.6rem !important;
        border-bottom: 1px solid rgba(44, 140, 153, 0.06) !important;
    }

        .mobile-customer-item .avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            flex-shrink: 0;
        }

        .mobile-customer-item .customer-name {
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--primary-color);
            margin-bottom: 0;
        }

        .mobile-customer-item .customer-phone {
            font-size: 0.8rem;
            color: rgba(44, 140, 153, 0.7);
        }

        .mobile-customer-item .customer-address {
            font-size: 0.8rem;
            color: #6c757d;
        }

        .mobile-customer-item .btn-group .btn {
            padding: 0.2rem 0.6rem;
            font-size: 0.75rem;
            border-radius: 6px !important;
            border: 1px solid rgba(44, 140, 153, 0.15);
        }

            .mobile-customer-item .btn-group .btn:hover {
                background: var(--primary-color);
                color: white;
                border-color: var(--primary-color);
            }

    /* ----- Empty State ----- */
    .empty-state i {
        font-size: 4rem;
        opacity: 0.2;
        color: var(--primary-color);
    }

    .empty-state h4 {
        font-size: 1.3rem;
        font-weight: 700;
        color: var(--primary-color);
        margin-top: 1rem;
    }

    .empty-state p {
        font-size: 0.95rem;
        color: rgba(44, 140, 153, 0.6);
    }

    /* ----- Responsive ----- */
    @@media (max-width: 992px) {
        .container-fluid {
            padding: 14px 10px !important;
        }

        .page-header h2 {
            font-size: 1.5rem;
        }

        .stat-card .stat-number {
            font-size: 1.6rem;
        }

        .stat-card .stat-icon {
            width: 40px;
            height: 40px;
            font-size: 1.2rem;
        }
    }

    @@media (max-width: 768px) {
        body {
            font-size: 16px;
        }

        .container-fluid {
            padding: 10px 8px !important;
        }

        .page-header h2 {
            font-size: 1.3rem;
        }

        .page-header p {
            font-size: 0.85rem;
        }

        .btn-primary {
            font-size: 0.85rem;
            padding: 0.4rem 1rem;
        }

        .stat-card {
            padding: 0.6rem 0.8rem !important;
            min-height: 65px;
        }

            .stat-card .stat-number {
                font-size: 1.3rem;
            }

            .stat-card .stat-label {
                font-size: 0.65rem;
            }

            .stat-card .stat-icon {
                width: 34px;
                height: 34px;
                font-size: 1rem;
            }

        .filter-section .input-group-text,
        .filter-section .form-control,
        .filter-section .form-select {
            font-size: 0.8rem;
            padding: 0.35rem 0.6rem;
        }

        .card-body {
            padding: 0.8rem 0.6rem !important;
        }

        .card-header {
            padding: 0.7rem 0.8rem !important;
        }

            .card-header h5 {
                font-size: 0.95rem !important;
            }

        .table {
            font-size: 0.8rem;
        }

            .table th {
                font-size: 0.7rem;
                padding: 0.5rem 0.6rem;
            }

            .table td {
                padding: 0.5rem 0.6rem;
            }

        .customer-row .avatar {
            width: 32px;
            height: 32px;
            font-size: 0.8rem;
        }

        .customer-row .customer-name {
            font-size: 0.85rem;
        }

        .customer-row .customer-id {
            font-size: 0.6rem;
        }

        .customer-row .customer-phone {
            font-size: 0.75rem;
        }

        .customer-row .customer-address {
            font-size: 0.7rem;
            max-width: 100px;
        }

        .table .btn-group .btn {
            padding: 0.2rem 0.5rem;
            font-size: 0.65rem;
            margin: 0 2px;
        }

        .badge-status {
            font-size: 0.6rem;
            padding: 0.1rem 0.6rem;
        }

        .mobile-customer-item {
            padding: 0.6rem 0.5rem !important;
        }

            .mobile-customer-item .avatar {
                width: 34px;
                height: 34px;
                font-size: 0.85rem;
            }

            .mobile-customer-item .customer-name {
                font-size: 0.85rem;
            }

            .mobile-customer-item .customer-phone {
                font-size: 0.7rem;
            }

            .mobile-customer-item .customer-address {
                font-size: 0.7rem;
            }

            .mobile-customer-item .btn-group .btn {
                padding: 0.15rem 0.5rem;
                font-size: 0.65rem;
            }

        .empty-state i {
            font-size: 3rem;
        }

        .empty-state h4 {
            font-size: 1.1rem;
        }

        .empty-state p {
            font-size: 0.85rem;
        }

        .row.g-3 {
            --bs-gutter-y: 0.4rem;
            --bs-gutter-x: 0.4rem;
        }
    }

    @@media (max-width: 480px) {
        .container-fluid {
            padding: 8px 4px !important;
        }

        .stat-grid .col-6 {
            padding: 0 4px;
        }

        .stat-card {
            padding: 0.4rem 0.5rem !important;
            min-height: 55px;
            border-radius: 14px !important;
        }

            .stat-card .stat-number {
                font-size: 1.1rem;
            }

            .stat-card .stat-label {
                font-size: 0.55rem;
            }

            .stat-card .stat-icon {
                width: 28px;
                height: 28px;
                font-size: 0.8rem;
                border-radius: 10px;
            }

        .page-header h2 {
            font-size: 1.1rem;
        }

        .page-header p {
            font-size: 0.75rem;
        }

        .btn-primary {
            font-size: 0.75rem;
            padding: 0.3rem 0.8rem;
        }

        .table {
            font-size: 0.7rem;
        }

            .table th {
                font-size: 0.6rem;
                padding: 0.3rem 0.4rem;
            }

            .table td {
                padding: 0.3rem 0.4rem;
            }

        .customer-row .avatar {
            width: 26px;
            height: 26px;
            font-size: 0.65rem;
        }

        .customer-row .customer-name {
            font-size: 0.75rem;
        }

        .customer-row .customer-id {
            font-size: 0.55rem;
        }

        .customer-row .customer-phone {
            font-size: 0.65rem;
        }

        .customer-row .customer-address {
            font-size: 0.6rem;
            max-width: 60px;
        }

        .table .btn-group .btn {
            padding: 0.15rem 0.4rem;
            font-size: 0.55rem;
            margin: 0 1px;
        }

        .mobile-customer-item .customer-name {
            font-size: 0.75rem;
        }

        .mobile-customer-item .customer-phone {
            font-size: 0.6rem;
        }

        .mobile-customer-item .customer-address {
            font-size: 0.6rem;
        }

        .badge-status {
            font-size: 0.5rem;
            padding: 0.05rem 0.4rem;
        }
    }

    /* ----- Dark Mode ----- */
    [data-bs-theme="dark"] .card {
        background-color: #2d2d2d !important;
        border-color: #495057 !important;
    }

    [data-bs-theme="dark"] .card-header {
        background: #2d2d2d !important;
        border-color: #495057 !important;
    }

    [data-bs-theme="dark"] .table {
        color: #e0e0e0;
    }

        [data-bs-theme="dark"] .table th {
            border-color: #495057;
            color: rgba(44, 140, 153, 0.9);
            background: rgba(44, 140, 153, 0.08);
        }

        [data-bs-theme="dark"] .table td {
            border-color: #495057;
        }

    [data-bs-theme="dark"] .customer-row:hover {
        background-color: rgba(44, 140, 153, 0.10);
    }

    [data-bs-theme="dark"] .filter-section .input-group-text {
        background: #2d2d2d;
        border-color: #495057;
        color: rgba(44, 140, 153, 0.9);
    }

    [data-bs-theme="dark"] .filter-section .form-control,
    [data-bs-theme="dark"] .filter-section .form-select {
        background-color: #2d2d2d;
        border-color: #495057;
        color: #e0e0e0;
    }

        [data-bs-theme="dark"] .filter-section .form-control:focus,
        [data-bs-theme="dark"] .filter-section .form-select:focus {
            background-color: #2d2d2d;
            border-color: var(--primary-color);
            color: #e0e0e0;
            box-shadow: 0 0 0 0.25rem rgba(44, 140, 153, 0.25);
        }

    [data-bs-theme="dark"] .mobile-customer-item {
        background: #2d2d2d !important;
        border-color: #495057 !important;
    }

    [data-bs-theme="dark"] .text-muted {
        color: #a0a0a0 !important;
    }
</style>

<div class="container-fluid px-3 px-md-4 py-3 py-md-4">
    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-3 mb-md-4 page-header">
        <div>
            <h2 class="fw-bold text-primary mb-1">
                <i class="fas fa-users me-2" style="font-size:1.4rem;"></i>Customer Management
            </h2>
            <p class="text-muted mb-0">
                <i class="fas fa-address-card me-1"></i>Manage all your air conditioning service customers
            </p>
        </div>
        <a class="btn btn-primary mt-3 mt-md-0" asp-action="Create">
            <i class="fas fa-user-plus me-2"></i>Add New Customer
        </a>
    </div>

    <!-- Stats Cards -->
    <div class="row mb-3 mb-md-4 stat-grid">
        <div class="col-6 col-md-3 mb-2 mb-md-0">
            <div class="card border-0 shadow-sm bg-gradient-primary text-white stat-card">
                <div class="card-body p-2 p-md-3 d-flex align-items-center">
                    <div class="bg-white bg-opacity-25 rounded-circle p-2 p-md-3 me-2 me-md-3 stat-icon">
                        <i class="fas fa-users"></i>
                    </div>
                    <div>
                        <h3 class="stat-number mb-0">@Model.Count()</h3>
                        <small class="stat-label">Total Customers</small>
                    </div>
                </div>
            </div>
        </div>
       @*  <div class="col-6 col-md-3 mb-2 mb-md-0">
            <div class="card border-0 shadow-sm bg-gradient-primary text-white stat-card" style="background: linear-gradient(135deg, #27ae60, #1e8449) !important;">
                <div class="card-body p-2 p-md-3 d-flex align-items-center">
                    <div class="bg-white bg-opacity-25 rounded-circle p-2 p-md-3 me-2 me-md-3 stat-icon">
                        <i class="fas fa-user-check"></i>
                    </div>
                    <div>
                        <h3 class="stat-number mb-0">@Model.Count(c => c.IsActive )</h3>
                        <small class="stat-label">Active Customers</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3 mb-2 mb-md-0">
            <div class="card border-0 shadow-sm bg-gradient-primary text-white stat-card" style="background: linear-gradient(135deg, #f39c12, #d68910) !important;">
                <div class="card-body p-2 p-md-3 d-flex align-items-center">
                    <div class="bg-white bg-opacity-25 rounded-circle p-2 p-md-3 me-2 me-md-3 stat-icon">
                        <i class="fas fa-star"></i>
                    </div>
                    <div>
                        <h3 class="stat-number mb-0">@Model.Count(c => c.IsPremium)</h3>
                        <small class="stat-label">Premium Customers</small>
                    </div>
                </div>
            </div>
        </div> *@
        <div class="col-6 col-md-3 mb-2 mb-md-0">
            <div class="card border-0 shadow-sm bg-gradient-primary text-white stat-card" style="background: linear-gradient(135deg, #2980b9, #1a5276) !important;">
                <div class="card-body p-2 p-md-3 d-flex align-items-center">
                    <div class="bg-white bg-opacity-25 rounded-circle p-2 p-md-3 me-2 me-md-3 stat-icon">
                        <i class="fas fa-calendar-plus"></i>
                    </div>
                    <div>
                        <h3 class="stat-number mb-0">@Model.Count(c => c.CreatedAt >= DateTime.Now.AddDays(-30))</h3>
                        <small class="stat-label">New (30 days)</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Search and Filter Section -->
    <div class="card border-0 shadow-sm mb-3 mb-md-4 filter-section">
        <div class="card-body p-2 p-md-3">
            <div class="row g-2 g-md-3">
                <div class="col-md-4 col-12">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="fas fa-search text-primary"></i>
                        </span>
                        <input type="text" class="form-control border-start-0" placeholder="Search customers..." id="searchInput">
                        <button class="btn btn-outline-primary" type="button" id="clearSearch">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <select class="form-select" id="stateFilter">
                        <option value="">All States</option>
                    </select>
                </div>
                <div class="col-6 col-md-3">
                    <select class="form-select" id="townshipFilter">
                        <option value="">All Townships</option>
                    </select>
                </div>
                <div class="col-12 col-md-2">
                    <button class="btn btn-primary w-100" id="applyFilters">
                        <i class="fas fa-filter me-2"></i>Filter
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Customers Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0 py-2 py-md-3">
            <h5 class="fw-bold mb-0 text-primary">
                <i class="fas fa-list me-2"></i>Customer List
                <span class="badge bg-primary-opacity-10 text-primary ms-2 fw-normal">@Model.Count()</span>
            </h5>
        </div>
        <div class="card-body p-0">
            <!-- Desktop View -->
            <div class="table-responsive d-none d-md-block">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Customer</th>
                            <th>Contact</th>
                            <th>Address</th>
                            <th>State Division</th>
                            <th>Township</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="customer-row" data-name="@item.Name.ToLower()">
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar bg-primary-opacity-10 text-primary me-3">
                                            <i class="fas fa-user"></i>
                                        </div>
                                        <div>
                                            <h6 class="customer-name mb-0">@item.Name</h6>
                                            <small class="customer-id">ID: CUS-@item.Id.ToString("D4")</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex flex-column">
                                        <span class="customer-phone">@item.Phone</span>
@*                                         <small class="text-muted" style="font-size:0.7rem;">@item.Email</small>
 *@                                    </div>
                                </td>
                                <td>
                                    <span class="customer-address" data-bs-toggle="tooltip" title="@item.Address">
                                        @item.Address
                                    </span>
                                </td>
                                <td>
                                    <small>
                                        @(item.CustomerLocations
                                            .FirstOrDefault()
                                            ?.StateDivisionPk
                                            ?.StateDivisionEn ?? "-")
                                    </small>
                                </td>
                                <td>
                                    <small>
                                        @(item.CustomerLocations
                                            .FirstOrDefault()
                                            ?.TownshipPk
                                            ?.TownshipEn ?? "-")
                                    </small>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a class="btn btn-outline-primary" asp-action="Details" asp-route-id="@item.Id"
                                           data-bs-toggle="tooltip" title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id"
                                           data-bs-toggle="tooltip" title="Edit Customer">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a class="btn btn-outline-primary" asp-action="Delete" asp-route-id="@item.Id"
                                           data-bs-toggle="tooltip" title="Delete Customer">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mobile View -->
            <div class="d-md-none">
                @foreach (var item in Model)
                {
                    <div class="mobile-customer-item d-flex flex-column" data-name="@item.Name.ToLower()">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="d-flex align-items-center">
                                <div class="avatar bg-primary-opacity-10 text-primary me-3">
                                    <i class="fas fa-user"></i>
                                </div>
                                <div>
                                    <h6 class="customer-name mb-0">@item.Name</h6>
                                    <small class="customer-phone">@item.Phone</small>
                                </div>
                            </div>
                            <span class="badge-status badge-active">
                                <i class="fas fa-circle me-1" style="font-size:0.4rem;"></i>Active
                            </span>
                        </div>

                        <div class="mb-2">
                            <small class="customer-address d-block">
                                <i class="fas fa-map-marker-alt me-1" style="color:var(--primary-color);width:14px;"></i>
                                @item.Address
                            </small>
                            <small class="text-muted d-block" style="font-size:0.65rem;">
                                <i class="fas fa-tag me-1" style="width:14px;"></i>
                                @(item.CustomerLocations.FirstOrDefault()?.StateDivisionPk?.StateDivisionEn ?? "-")
                                @if (item.CustomerLocations.FirstOrDefault()?.TownshipPk?.TownshipEn != null)
                                {
                                    <text>, @item.CustomerLocations.FirstOrDefault()?.TownshipPk?.TownshipEn</text>
                                }
                            </small>
                        </div>

                        <div class="d-flex justify-content-end align-items-center">
                            <div class="btn-group btn-group-sm" role="group">
                                <a class="btn btn-outline-primary" asp-action="Details" asp-route-id="@item.Id">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a class="btn btn-outline-primary" asp-action="Delete" asp-route-id="@item.Id">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Empty State -->
    @if (!Model.Any())
    {
        <div class="text-center py-4 py-md-5 empty-state">
            <div class="mb-3">
                <i class="fas fa-users"></i>
            </div>
            <h4 class="fw-bold text-primary mb-2">No Customers Found</h4>
            <p class="text-primary-opacity-75 mb-3">Start by adding your first customer to manage your air conditioning service business.</p>
            <a class="btn btn-primary" asp-action="Create">
                <i class="fas fa-user-plus me-2"></i>Add Your First Customer
            </a>
        </div>
    }
</div>

<!-- JavaScript -->
@section Scripts {
    <script>
        var states = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.States));

        document.addEventListener('DOMContentLoaded', function () {

            const stateFilter = document.getElementById("stateFilter");
            const townshipFilter = document.getElementById("townshipFilter");

            // =========================
            // LOAD STATES
            // =========================
            if (states && states.length > 0) {
                states.forEach(s => {
                    const opt = document.createElement("option");
                    opt.value = s.StateDivisionPkid;
                    opt.textContent = s.StateDivisionEn || s.StateDivision;
                    stateFilter.appendChild(opt);
                });
            }

            // =========================
            // STATE CHANGE → LOAD TOWNSHIP
            // =========================
            stateFilter.addEventListener('change', function () {

                const stateId = this.value;

                townshipFilter.innerHTML =
                    '<option value="">All Townships</option>';

                if (!stateId) return;

                fetch('/Customer/GetTownshipsByState?stateId=' + stateId)
                    .then(res => res.json())
                    .then(data => {

                        if (data && data.length > 0) {
                            data.forEach(t => {
                                const opt = document.createElement("option");
                                opt.value = t.townshipPkid;
                                opt.textContent = t.townshipEn;
                                townshipFilter.appendChild(opt);
                            });
                        }

                    })
                    .catch(err => console.log("Township load error:", err));
            });

            // =========================
            // APPLY FILTERS
            // =========================
            document.getElementById("applyFilters").addEventListener("click", function () {

                let search = document.getElementById("searchInput").value;
                let stateId = document.getElementById("stateFilter").value;
                let townshipId = document.getElementById("townshipFilter").value;

                let url = "/Customer/Index?";
                let params = [];

                if (search)
                    params.push("search=" + encodeURIComponent(search));

                if (stateId)
                    params.push("stateId=" + stateId);

                if (townshipId)
                    params.push("townshipId=" + townshipId);

                url += params.join("&");

                window.location.href = url;
            });

            // =========================
            // CLEAR SEARCH
            // =========================
            document.getElementById("clearSearch").addEventListener("click", function () {
                window.location.href = "/Customer/Index";
            });

            // =========================
            // SEARCH DEBOUNCE
            // =========================
            let typingTimer;

            document.getElementById("searchInput").addEventListener("keyup", function () {

                clearTimeout(typingTimer);

                typingTimer = setTimeout(() => {
                    document.getElementById("applyFilters").click();
                }, 600);
            });

            // =========================
            // TOOLTIP INIT
            // =========================
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

        });
    </script>
}