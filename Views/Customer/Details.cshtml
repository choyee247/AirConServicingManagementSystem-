@model AirConServicingManagementSystem.Models.Customer

@{
    ViewData["Title"] = "Customer Details";
    Layout = "~/Views/Shared/_TechnicianLayout.cshtml";

    var airconUnits = Model.AirConUnits?.ToList()
        ?? new List<AirConServicingManagementSystem.Models.AirConUnit>();

    var allServiceRecords = airconUnits
        .Where(a => a.ServiceRecordUnits != null)
        .SelectMany(a => a.ServiceRecordUnits)
        .Where(x => x.ServiceRecord != null)
        .Select(x => x.ServiceRecord)
        .Distinct()
        .OrderByDescending(x => x.ServiceDate)
        .ToList();

    var serviceCount = allServiceRecords.Count;

    var activeWarrantyCount = airconUnits.Count(a =>
        a.Warranty != null &&
        a.Warranty.EndDate >= DateTime.Today
    );

    var recentServices = allServiceRecords
        .Take(5)
        .ToList();
}

<div class="customer-page">

    <!-- ================= HEADER ================= -->
    <div class="page-header">

        <div class="header-left">

            <a asp-action="Index" class="back-link">
                <i class="fas fa-arrow-left"></i>
                Customers
            </a>

            <div class="customer-heading">

                <div class="customer-avatar">
                    @(string.IsNullOrWhiteSpace(Model.Name)
                                        ? "C"
                                        : Model.Name.Substring(0, 1).ToUpper())
                </div>

                <div>
                    <h1>@Model.Name</h1>

                    <div class="customer-meta">

                        @if (!string.IsNullOrWhiteSpace(Model.Phone))
                        {
                            <span>
                                <i class="fas fa-phone-alt"></i>
                                @Model.Phone
                            </span>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.Address))
                        {
                            <span>
                                <i class="fas fa-map-marker-alt"></i>
                                @Model.Address
                            </span>
                        }

                    </div>
                </div>

            </div>

        </div>

        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn-primary-custom">

            <i class="fas fa-edit"></i>
            Edit Customer

        </a>

    </div>


    <!-- ================= SUMMARY ================= -->
    <div class="summary-grid">

        <div class="summary-card">

            <div class="summary-icon">
                <i class="fas fa-snowflake"></i>
            </div>

            <div>
                <span class="summary-label">AirCon Units</span>
                <strong>@airconUnits.Count</strong>
            </div>

        </div>


        <div class="summary-card">

            <div class="summary-icon">
                <i class="fas fa-tools"></i>
            </div>

            <div>
                <span class="summary-label">Total Services</span>
                <strong>@serviceCount</strong>
            </div>

        </div>


        <div class="summary-card">

            <div class="summary-icon">
                <i class="fas fa-shield-alt"></i>
            </div>

            <div>
                <span class="summary-label">Active Warranty</span>
                <strong>@activeWarrantyCount</strong>
            </div>

        </div>

    </div>


    <!-- ================= AIRCON UNITS ================= -->
    <div class="content-card">

        <div class="section-header">

            <div>
                <h2>
                    <i class="fas fa-snowflake"></i>
                    AirCon Units
                </h2>

                <p>
                    Customer's registered air conditioning units
                </p>
            </div>

            <span class="unit-count">
                @airconUnits.Count Units
            </span>

        </div>


        @if (airconUnits.Any())
        {
            <div class="aircon-list">

                @foreach (var aircon in airconUnits)
                {
                    var unitServices = aircon.ServiceRecordUnits?
                    .Where(x => x.ServiceRecord != null)
                    .Select(x => x.ServiceRecord)
                    .Distinct()
                    .OrderByDescending(x => x.ServiceDate)
                    .ToList()
                    ?? new List<AirConServicingManagementSystem.Models.ServiceRecord>();

                    var lastService = unitServices.FirstOrDefault();

                    <div class="aircon-item">

                        <!-- AIRCON MAIN -->
                        <div class="aircon-main">

                            <div class="aircon-icon">
                                <i class="fas fa-snowflake"></i>
                            </div>

                            <div class="aircon-info">

                                <h3>
                                    @(aircon.Brand?.BrandName ?? "Unknown Brand")
                                    <span>
                                        @(aircon.Model?.ModelName ?? "")
                                    </span>
                                </h3>

                                <div class="aircon-details">

                                    <span>
                                        <i class="fas fa-tag"></i>
                                        @(aircon.AirConType ?? "N/A")
                                    </span>

                                    <span>
                                        <i class="fas fa-tachometer-alt"></i>
                                        @(aircon.CapacityHp?.ToString() ?? "N/A") HP
                                    </span>

                                    <span>
                                        <i class="fas fa-calendar"></i>
                                        Installed:
                                        @(aircon.InstallationDate?.ToString("dd MMM yyyy") ?? "N/A")
                                    </span>

                                </div>

                            </div>

                        </div>


                        <!-- AIRCON STATUS -->
                        <div class="aircon-status">

                            @if (aircon.Warranty != null)
                            {
                                if (aircon.Warranty.EndDate >= DateTime.Today)
                                {
                                    <span class="status active">
                                        <i class="fas fa-check-circle"></i>
                                        Warranty Active
                                    </span>

                                    <small>
                                        Until
                                        @aircon.Warranty.EndDate.ToString("dd MMM yyyy")
                                    </small>
                                }
                                else
                                {
                                    <span class="status expired">
                                        <i class="fas fa-times-circle"></i>
                                        Warranty Expired
                                    </span>

                                    <small>
                                        @aircon.Warranty.EndDate.ToString("dd MMM yyyy")
                                    </small>
                                }
                            }
                            else
                            {
                                <span class="status no-warranty">
                                    <i class="fas fa-minus-circle"></i>
                                    No Warranty
                                </span>
                            }

                        </div>


                        <!-- NEXT SERVICE -->
                        <div class="next-service">

                            <span class="label">
                                Next Service
                            </span>

                            @if (lastService?.NextServiceDue != null)
                            {
                                <strong>
                                    @lastService.NextServiceDue.Value.ToString("dd MMM yyyy")
                                </strong>
                            }
                            else
                            {
                                <strong class="muted">
                                    Not Scheduled
                                </strong>
                            }

                        </div>


                        <!-- SERVICE COUNT -->
                        <div class="service-count">

                            <strong>@unitServices.Count</strong>

                            <span>
                                Services
                            </span>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="empty-state">

                <i class="fas fa-snowflake"></i>

                <h4>No AirCon Units</h4>

                <p>
                    This customer has no registered AirCon units.
                </p>

            </div>
        }

    </div>


    <!-- ================= RECENT SERVICE HISTORY ================= -->
    <div class="content-card service-card">

        <div class="section-header">

            <div>
                <h2>
                    <i class="fas fa-history"></i>
                    Recent Service History
                </h2>

                <p>
                    Latest service records for this customer
                </p>
            </div>

            @if (serviceCount > 5)
            {
                <span class="record-count">
                    Showing latest 5
                </span>
            }

        </div>


        @if (recentServices.Any())
        {
            <div class="table-responsive">

                <table class="service-table">

                    <thead>

                        <tr>
                            <th>Date</th>
                            <th>AirCon</th>
                            <th>Service Type</th>
                            <th>Technician</th>
                            <th>Status</th>
                            <th>Next Service</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var service in recentServices)
                        {
                            <tr>

                                <td class="date-cell">
                                    @(service.ServiceDate?.ToString("dd MMM yyyy") ?? "N/A")
                                </td>

                                <td>

                                    @if (service.ServiceRecordUnits != null &&
                                                                service.ServiceRecordUnits.Any())
                                    {
                                        foreach (var unit in service.ServiceRecordUnits)
                                        {
                                            <div class="aircon-name">

                                                <i class="fas fa-snowflake"></i>

                                                @(unit.AirConUnit?.Brand?.BrandName ?? "")
                                                @(unit.AirConUnit?.Model?.ModelName ?? "")

                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="muted">N/A</span>
                                    }

                                </td>

                                <td>
                                    @(service.ServiceType ?? "N/A")
                                </td>

                                <td>

                                    <div class="technician-name">

                                        <i class="fas fa-user-cog"></i>

                                        @(service.Technician?.Name ?? "Not Assigned")

                                    </div>

                                </td>

                                <td>

                                    @{
                                        var status = service.Status ?? "N/A";

                                        var statusClass =
                                        status.Equals("Completed",
                                        StringComparison.OrdinalIgnoreCase)
                                        ? "completed"
                                        : status.Equals("Pending",
                                        StringComparison.OrdinalIgnoreCase)
                                        ? "pending"
                                        : "other";
                                    }

                                    <span class="service-status @statusClass">
                                        @status
                                    </span>

                                </td>

                                <td>

                                    @if (service.NextServiceDue != null)
                                    {
                                        <span>
                                            @service.NextServiceDue.Value.ToString("dd MMM yyyy")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="muted">
                                            N/A
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="empty-state">

                <i class="fas fa-tools"></i>

                <h4>No Service History</h4>

                <p>
                    No service records are available for this customer.
                </p>

            </div>
        }

    </div>


    <!-- ================= FOOTER ================= -->
    <div class="page-footer">

        <a asp-action="Index" class="btn-secondary-custom">

            <i class="fas fa-arrow-left"></i>

            Back to Customers

        </a>

    </div>

</div>


<style>

    :root {
        --primary: #2c8c99;
        --primary-dark: #23727d;
        --primary-light: #eef9fa;
        --border: #dcecef;
        --text: #263238;
        --muted: #718096;
        --background: #f7fafb;
    }


    /* ================= PAGE ================= */

    .customer-page {
        max-width: 1350px;
        margin: 0 auto;
        padding: 10px 0 40px;
        color: var(--text);
    }


    /* ================= HEADER ================= */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 25px;
        margin-bottom: 25px;
    }


    .header-left {
        flex: 1;
    }


    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: var(--muted);
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 15px;
    }


        .back-link:hover {
            color: var(--primary);
        }


    .customer-heading {
        display: flex;
        align-items: center;
        gap: 16px;
    }


    .customer-avatar {
        width: 64px;
        height: 64px;
        flex-shrink: 0;
        border-radius: 16px;
        background: var(--primary);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
        font-weight: 700;
    }


    .customer-heading h1 {
        margin: 0 0 6px;
        font-size: 27px;
        font-weight: 700;
        color: var(--text);
    }


    .customer-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
        color: var(--muted);
        font-size: 14px;
    }


        .customer-meta span {
            display: inline-flex;
            align-items: center;
            gap: 7px;
        }


        .customer-meta i {
            color: var(--primary);
        }


    /* ================= BUTTON ================= */

    .btn-primary-custom {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--primary);
        color: white;
        text-decoration: none;
        padding: 10px 17px;
        border-radius: 9px;
        font-size: 14px;
        font-weight: 600;
        transition: .2s;
    }


        .btn-primary-custom:hover {
            background: var(--primary-dark);
            color: white;
        }


    /* ================= SUMMARY ================= */

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 22px;
    }


    .summary-card {
        background: white;
        border: 1px solid var(--border);
        border-radius: 13px;
        padding: 18px;
        display: flex;
        align-items: center;
        gap: 14px;
    }


    .summary-icon {
        width: 44px;
        height: 44px;
        border-radius: 11px;
        background: var(--primary-light);
        color: var(--primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }


    .summary-label {
        display: block;
        font-size: 12px;
        color: var(--muted);
        margin-bottom: 2px;
    }


    .summary-card strong {
        display: block;
        font-size: 22px;
        color: var(--text);
    }


    /* ================= CARD ================= */

    .content-card {
        background: white;
        border: 1px solid var(--border);
        border-radius: 15px;
        padding: 23px;
        margin-bottom: 22px;
    }


    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-bottom: 20px;
    }


        .section-header h2 {
            margin: 0 0 4px;
            font-size: 18px;
            font-weight: 700;
            color: var(--text);
        }


            .section-header h2 i {
                color: var(--primary);
                margin-right: 7px;
            }


        .section-header p {
            margin: 0;
            color: var(--muted);
            font-size: 13px;
        }


    .unit-count,
    .record-count {
        background: var(--primary-light);
        color: var(--primary);
        border-radius: 20px;
        padding: 6px 11px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }


    /* ================= AIRCON ================= */

    .aircon-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }


    .aircon-item {
        display: grid;
        grid-template-columns: minmax(300px, 1.8fr) 1.1fr 1fr 80px;
        align-items: center;
        gap: 20px;
        padding: 17px;
        border: 1px solid var(--border);
        border-radius: 12px;
        transition: .2s;
    }


        .aircon-item:hover {
            border-color: var(--primary);
            box-shadow: 0 4px 14px rgba(44, 140, 153, .08);
        }


    .aircon-main {
        display: flex;
        align-items: center;
        gap: 13px;
        min-width: 0;
    }


    .aircon-icon {
        width: 43px;
        height: 43px;
        flex-shrink: 0;
        border-radius: 10px;
        background: var(--primary-light);
        color: var(--primary);
        display: flex;
        align-items: center;
        justify-content: center;
    }


    .aircon-info h3 {
        margin: 0 0 6px;
        font-size: 15px;
        font-weight: 700;
    }


        .aircon-info h3 span {
            font-weight: 500;
            color: var(--muted);
        }


    .aircon-details {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        color: var(--muted);
        font-size: 12px;
    }


        .aircon-details span {
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }


        .aircon-details i {
            color: var(--primary);
        }


    /* ================= WARRANTY ================= */

    .aircon-status {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }


    .status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 12px;
        font-weight: 600;
    }


        .status.active {
            color: #16805c;
        }


        .status.expired {
            color: #d64545;
        }


        .status.no-warranty {
            color: var(--muted);
        }


    .aircon-status small {
        color: var(--muted);
        font-size: 11px;
    }


    /* ================= NEXT SERVICE ================= */

    .next-service {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }


        .next-service .label {
            font-size: 11px;
            color: var(--muted);
        }


        .next-service strong {
            font-size: 13px;
            color: var(--primary);
        }


    .muted {
        color: var(--muted) !important;
    }


    /* ================= SERVICE COUNT ================= */

    .service-count {
        text-align: center;
        border-left: 1px solid var(--border);
        padding-left: 15px;
    }


        .service-count strong {
            display: block;
            font-size: 20px;
            color: var(--primary);
        }


        .service-count span {
            font-size: 10px;
            color: var(--muted);
        }


    /* ================= TABLE ================= */

    .table-responsive {
        overflow-x: auto;
    }


    .service-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }


        .service-table th {
            background: var(--primary-light);
            color: var(--primary);
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            padding: 11px 13px;
            border-bottom: 1px solid var(--border);
            white-space: nowrap;
        }


        .service-table td {
            padding: 13px;
            border-bottom: 1px solid #edf3f4;
            font-size: 13px;
            vertical-align: middle;
        }


        .service-table tbody tr:last-child td {
            border-bottom: none;
        }


        .service-table tbody tr:hover {
            background: #fbfefe;
        }


    .date-cell {
        font-weight: 600;
        white-space: nowrap;
    }


    .aircon-name,
    .technician-name {
        display: flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
    }


        .aircon-name i,
        .technician-name i {
            color: var(--primary);
            font-size: 11px;
        }


    /* ================= STATUS ================= */

    .service-status {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap;
    }


        .service-status.completed {
            background: #e9f7f1;
            color: #16805c;
        }


        .service-status.pending {
            background: #fff5df;
            color: #a96d00;
        }


        .service-status.other {
            background: var(--primary-light);
            color: var(--primary);
        }


    /* ================= EMPTY ================= */

    .empty-state {
        text-align: center;
        padding: 45px 20px;
        color: var(--muted);
    }


        .empty-state i {
            font-size: 35px;
            color: #b9dfe3;
            margin-bottom: 12px;
        }


        .empty-state h4 {
            margin: 0 0 5px;
            color: var(--text);
            font-size: 15px;
        }


        .empty-state p {
            margin: 0;
            font-size: 13px;
        }


    /* ================= FOOTER ================= */

    .page-footer {
        margin-top: 5px;
    }


    .btn-secondary-custom {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 15px;
        border: 1px solid var(--border);
        border-radius: 9px;
        color: var(--text);
        background: white;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
    }


        .btn-secondary-custom:hover {
            color: var(--primary);
            border-color: var(--primary);
        }


    /* ================= RESPONSIVE ================= */

    @@media (max-width: 1100px) {

        .aircon-item {
            grid-template-columns: 1fr 1fr;
        }

        .service-count {
            border-left: none;
            text-align: left;
            padding-left: 0;
        }
    }


    @@media (max-width: 768px) {

        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .btn-primary-custom {
            width: 100%;
            justify-content: center;
        }

        .summary-grid {
            grid-template-columns: 1fr;
        }

        .aircon-item {
            grid-template-columns: 1fr;
            gap: 14px;
        }

        .service-count {
            border-top: 1px solid var(--border);
            padding-top: 12px;
        }

        .customer-meta {
            flex-direction: column;
            gap: 7px;
        }

        .content-card {
            padding: 17px;
        }
    }

</style>