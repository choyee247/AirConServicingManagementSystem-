@model AirConServicingManagementSystem.Models.ServiceRequest

@{
    ViewData["Title"] = "Service Details";
    Layout = "~/Views/Shared/_TechnicianLayout.cshtml";

    var record = ViewBag.Record;
    var payment = ViewBag.Payment;

    var serviceStatus = Model.Status?.Trim() ?? "Unknown";

    decimal totalAmount = 0;
    decimal paidAmount = 0;
    decimal remainingAmount = 0;
    decimal changeAmount = 0;

    if (payment != null)
    {
        totalAmount = payment.Amount ?? 0;
        paidAmount = payment.PaidAmount ?? 0;
        changeAmount = payment.ChangeAmount ?? 0;

        remainingAmount = totalAmount - paidAmount;

        if (remainingAmount < 0)
            remainingAmount = 0;
    }


    // =========================
    // SERVICE STATUS
    // =========================

    string statusClass = "status-default";
    string statusIcon = "fa-info-circle";
    string statusText = serviceStatus;

    switch (serviceStatus.ToLower())
    {
        case "pending":
            statusClass = "status-pending";
            statusIcon = "fa-clock";
            statusText = "Pending";
            break;

        case "assigned":
            statusClass = "status-assigned";
            statusIcon = "fa-user-check";
            statusText = "Assigned";
            break;

        case "accepted":
            statusClass = "status-accepted";
            statusIcon = "fa-check";
            statusText = "Accepted";
            break;

        case "in progress":
        case "inprogress":
            statusClass = "status-progress";
            statusIcon = "fa-tools";
            statusText = "In Progress";
            break;

        case "completed":
            statusClass = "status-completed";
            statusIcon = "fa-check-circle";
            statusText = "Completed";
            break;

        case "cancelled":
        case "canceled":
            statusClass = "status-cancelled";
            statusIcon = "fa-times-circle";
            statusText = "Cancelled";
            break;

        case "rejected":
            statusClass = "status-rejected";
            statusIcon = "fa-ban";
            statusText = "Rejected";
            break;

        default:
            statusClass = "status-default";
            statusIcon = "fa-info-circle";
            statusText = serviceStatus;
            break;
    }


    // =========================
    // PAYMENT STATUS
    // =========================

    string paymentStatus = "Unpaid";

    if (payment != null)
    {
        if (paidAmount >= totalAmount && totalAmount > 0)
        {
            paymentStatus = "Paid";
        }
        else if (paidAmount > 0 && paidAmount < totalAmount)
        {
            paymentStatus = "Remaining";
        }
        else
        {
            paymentStatus = "Unpaid";
        }
    }
    else if (!string.IsNullOrEmpty(Model.PaymentStatus))
    {
        paymentStatus = Model.PaymentStatus;
    }
}


<div class="service-page">


    



    <!-- =========================
         MAIN CARD
    ========================= -->

    <div class="service-card">


        <!-- =========================
             HEADER
        ========================= -->

        <div class="service-header">

            <div class="header-left">

                <div class="service-icon">

                    <i class="fas fa-tools"></i>

                </div>

                <div>

                    <h2>
                        Service Details
                    </h2>

                    <p>
                        Complete Service Information
                    </p>

                </div>

            </div>


            <div class="status-box">

                <span class="status-label">
                    Service Status
                </span>

                <span class="service-status @statusClass">

                    <i class="fas @statusIcon"></i>

                    @statusText

                </span>

            </div>

        </div>



        <!-- =========================
             SERVICE SUMMARY
        ========================= -->

        <div class="summary-bar">

            <div class="summary-item">

                <span>
                    Appointment ID
                </span>

                <strong>
                    #@Model.AppointmentId
                </strong>

            </div>


            <div class="summary-item">

                <span>
                    Request Date
                </span>

                <strong>
                    @Model.RequestedAt.ToString("dd MMM yyyy")
                </strong>

            </div>


            <div class="summary-item">

                <span>
                    Service Type
                </span>

                <strong>
                    @Model.ServiceType
                </strong>

            </div>


            <div class="summary-item">

                <span>
                    Payment
                </span>

                @if (paymentStatus == "Paid")
                {
                    <strong class="payment-text paid">
                        <i class="fas fa-check-circle"></i>
                        Paid
                    </strong>
                }
                else if (paymentStatus == "Remaining")
                {
                    <strong class="payment-text remaining">
                        <i class="fas fa-clock"></i>
                        Remaining
                    </strong>
                }
                else
                {
                    <strong class="payment-text unpaid">
                        <i class="fas fa-exclamation-circle"></i>
                        Unpaid
                    </strong>
                }

            </div>

        </div>



        <!-- =========================
             BODY
        ========================= -->

        <div class="service-body">


            <!-- =========================
                 CUSTOMER + TECHNICIAN
            ========================= -->

            <div class="section-grid">


                <!-- CUSTOMER -->

                <div class="info-card">

                    <div class="info-header">

                        <div class="info-icon">

                            <i class="fas fa-user"></i>

                        </div>

                        <h4>
                            Customer Information
                        </h4>

                    </div>


                    <div class="info-row">

                        <span>
                            Name
                        </span>

                        <strong>
                            @Model.Customer?.Name
                        </strong>

                    </div>


                    <div class="info-row">

                        <span>
                            Phone
                        </span>

                        <strong>
                            @Model.Customer?.Phone
                        </strong>

                    </div>


                    <div class="info-row">

                        <span>
                            Location
                        </span>

                        <strong>
                            @Model.Location
                        </strong>

                    </div>


                    <div class="info-row">

                        <span>
                            Requested
                        </span>

                        <strong>
                            @Model.RequestedAt.ToString("dd MMM yyyy HH:mm")
                        </strong>

                    </div>


                    <div class="info-row">

                        <span>
                            Completed
                        </span>

                        <strong>
                            @(Model.CompletedAt?.ToString("dd MMM yyyy HH:mm") ?? "-")
                        </strong>

                    </div>

                </div>



                <!-- TECHNICIAN -->

                <div class="info-card">

                    <div class="info-header">

                        <div class="info-icon">

                            <i class="fas fa-user-cog"></i>

                        </div>

                        <h4>
                            Technician Information
                        </h4>

                    </div>


                    <div class="info-row">

                        <span>
                            Name
                        </span>

                        <strong>
                            @Model.Technician?.Name
                        </strong>

                    </div>


                    <div class="info-row">

                        <span>
                            Service Type
                        </span>

                        <strong>
                            @Model.ServiceType
                        </strong>

                    </div>


                    <div class="info-row">

                        <span>
                            Status
                        </span>

                        <strong>

                            <span class="mini-status @statusClass">

                                <i class="fas @statusIcon"></i>

                                @statusText

                            </span>

                        </strong>

                    </div>


                    <div class="info-row">

                        <span>
                            Service Date
                        </span>

                        <strong>
                            @(record?.CreatedAt?.ToString("dd MMM yyyy") ?? "-")
                        </strong>

                    </div>

                </div>

            </div>



            <!-- =========================
                 AIR CONDITIONERS
            ========================= -->

            <div class="section-title">

                <div class="section-title-icon">

                    <i class="fas fa-snowflake"></i>

                </div>

                <div>

                    <h3>
                        Air Conditioner Details
                    </h3>

                    <p>
                        Equipment information for this service
                    </p>

                </div>

            </div>


            <div class="table-wrapper">

                <table class="aircon-table">

                    <thead>

                        <tr>

                            <th>
                                #
                            </th>

                            <th>
                                Brand
                            </th>

                            <th>
                                Model
                            </th>

                            <th>
                                Capacity
                            </th>

                           

                            <th>
                                Next Service
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model.AirConUnits != null &&
                                                Model.AirConUnits.Any())
                        {
                            var no = 1;

                            foreach (var unit in Model.AirConUnits)
                            {
                                <tr>

                                    <td>
                                        <span class="number-badge">
                                            @no
                                        </span>
                                    </td>

                                    <td>
                                        <strong>
                                            @unit.Brand?.BrandName
                                        </strong>
                                    </td>

                                    <td>
                                        @unit.Model?.ModelName
                                    </td>

                                    <td>
                                        @unit.CapacityHp HP
                                    </td>

                                    <td>
                                        -
                                    </td>

                                </tr>

                                no++;
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="6"
                                    class="empty-row">

                                    No air conditioner information available.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>



            <!-- =========================
                 SERVICE REPORT
            ========================= -->

            <div class="section-title">

                <div class="section-title-icon">

                    <i class="fas fa-clipboard-list"></i>

                </div>

                <div>

                    <h3>
                        Service Report
                    </h3>

                    <p>
                        Technician service report and findings
                    </p>

                </div>

            </div>


            @if (record != null)
            {

                <div class="report-grid">


                    <div class="report-item">

                        <label>
                            <i class="fas fa-search"></i>
                            Problem Found
                        </label>

                        <div class="report-value">
                            @(record.ProblemFound ?? "-")
                        </div>

                    </div>


                    <div class="report-item">

                        <label>
                            <i class="fas fa-wrench"></i>
                            Repair Action
                        </label>

                        <div class="report-value">
                            @(record.RepairAction ?? "-")
                        </div>

                    </div>


                    <div class="report-item">

                        <label>
                            <i class="fas fa-cogs"></i>
                            Parts Replaced
                        </label>

                        <div class="report-value">
                            @(record.PartsReplaced ?? "-")
                        </div>

                    </div>


                    <div class="report-item">

                        <label>
                            <i class="fas fa-money-bill-wave"></i>
                            Service Cost
                        </label>

                        <div class="report-value amount">
                            @record.ServiceCost?.ToString("N0") MMK
                        </div>

                    </div>


                    <div class="report-item full-width">

                        <label>
                            <i class="fas fa-comment-alt"></i>
                            Technician Note
                        </label>

                        <div class="report-value note">
                            @(record.TechnicianNote ?? "-")
                        </div>

                    </div>


                    <div class="report-item">

                        <label>
                            <i class="fas fa-calendar-alt"></i>
                            Next Service Due
                        </label>

                        <div class="report-value">

                            @(record.NextServiceDue?.ToString("dd MMM yyyy") ?? "-")

                        </div>

                    </div>


                    <div class="report-item">

                        <label>
                            <i class="fas fa-tools"></i>
                            Service Type Performed
                        </label>

                        <div class="report-value">
                            @(record.ServiceType ?? "-")
                        </div>

                    </div>

                </div>

            }
            else
            {
                <div class="no-record">

                    <i class="fas fa-info-circle"></i>

                    No service report has been submitted yet.

                </div>
            }



            <!-- =========================
                 PAYMENT SUMMARY
            ========================= -->

            <div class="section-title payment-section-title">

                <div class="section-title-icon">

                    <i class="fas fa-credit-card"></i>

                </div>

                <div>

                    <h3>
                        Payment Information
                    </h3>

                    <p>
                        Payment and invoice summary
                    </p>

                </div>

            </div>


            <div class="payment-card">


                <div class="payment-status-area">

                    <span class="payment-label">
                        Payment Status
                    </span>


                    @if (paymentStatus == "Paid")
                    {
                        <span class="payment-badge payment-paid">

                            <i class="fas fa-check-circle"></i>

                            Paid

                        </span>
                    }
                    else if (paymentStatus == "Remaining")
                    {
                        <span class="payment-badge payment-remaining">

                            <i class="fas fa-clock"></i>

                            Remaining

                        </span>
                    }
                    else
                    {
                        <span class="payment-badge payment-unpaid">

                            <i class="fas fa-exclamation-circle"></i>

                            Unpaid

                        </span>
                    }

                </div>


                <div class="payment-grid">


                    <div class="payment-item">

                        <span>
                            Total Service Cost
                        </span>

                        <strong>
                            @totalAmount.ToString("N0") MMK
                        </strong>

                    </div>


                    <div class="payment-item">

                        <span>
                            Paid Amount
                        </span>

                        <strong class="paid-value">
                            @paidAmount.ToString("N0") MMK
                        </strong>

                    </div>


                    <div class="payment-item">

                        <span>
                            Remaining Amount
                        </span>

                        <strong class="remaining-value">

                            @remainingAmount.ToString("N0") MMK

                        </strong>

                    </div>


                    <div class="payment-item">

                        <span>
                            Change
                        </span>

                        <strong>
                            @changeAmount.ToString("N0") MMK
                        </strong>

                    </div>


                    @if (payment != null)
                    {

                        <div class="payment-item">

                            <span>
                                Payment Method
                            </span>

                            <strong>
                                @(payment.PaymentMethod ?? "-")
                            </strong>

                        </div>


                        <div class="payment-item">

                            <span>
                                Payment Date
                            </span>

                            <strong>
                                @(payment.PaymentDate?.ToString("dd MMM yyyy HH:mm") ?? "-")
                            </strong>

                        </div>


                        <div class="payment-item">

                            <span>
                                Invoice No
                            </span>

                            <strong>
                                @(payment.InvoiceNo ?? "-")
                            </strong>

                        </div>

                    }

                </div>


                @if (paymentStatus == "Remaining")
                {
                    <div class="remaining-alert">

                        <i class="fas fa-info-circle"></i>

                        <div>

                            <strong>
                                Payment Remaining
                            </strong>

                            <span>
                                @remainingAmount.ToString("N0") MMK is still remaining.
                            </span>

                        </div>

                    </div>
                }
                else if (paymentStatus == "Paid")
                {
                    <div class="paid-alert">

                        <i class="fas fa-check-circle"></i>

                        <div>

                            <strong>
                                Payment Completed
                            </strong>

                            <span>
                                This service has been fully paid.
                            </span>

                        </div>

                    </div>
                }
                else
                {
                    <div class="unpaid-alert">

                        <i class="fas fa-exclamation-circle"></i>

                        <div>

                            <strong>
                                Payment Pending
                            </strong>

                            <span>
                                No payment has been completed for this service.
                            </span>

                        </div>

                    </div>
                }

            </div>



            <!-- =========================
                 FOOTER ACTIONS
            ========================= -->

            <div class="bottom-actions">

                <a asp-action="Index"
                   class="back-btn">

                    <i class="fas fa-arrow-left"></i>

                    Back 

                </a>


                @if (payment != null &&
                                !string.IsNullOrEmpty(payment.InvoiceNo))
                {

                    <a asp-controller="Payment"
                       asp-action="Invoice"
                       asp-route-id="@payment.ServiceRecordId"
                       class="invoice-btn">

                        <i class="fas fa-file-invoice"></i>

                        View Invoice

                    </a>

                }

            </div>


        </div>

    </div>

</div>



<style>

    :root {
        --primary: #2c8c99;
        --primary-dark: #23727d;
        --primary-light: #e9f7f8;
        --text: #263238;
        --muted: #718096;
        --border: #e4eaed;
        --background: #f4f7f9;
    }


    body {
        background: var(--background);
    }


    .service-page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 30px 15px;
    }


    /* =========================
           ACTIONS
        ========================= */

    .top-actions,
    .bottom-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 18px;
    }


    .back-btn,
    .print-btn,
    .invoice-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 18px;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        transition: .2s ease;
    }


    .back-btn {
        background: white;
        border: 1px solid var(--border);
        color: #495057;
    }


        .back-btn:hover {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
        }


    .print-btn {
        border: none;
        background: var(--primary);
        color: white;
    }


        .print-btn:hover,
        .invoice-btn:hover {
            background: var(--primary-dark);
            color: white;
        }


    .invoice-btn {
        background: var(--primary);
        color: white;
    }


    /* =========================
           MAIN CARD
        ========================= */

    .service-card {
        background: white;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 8px 35px rgba(0,0,0,.07);
    }


    /* =========================
           HEADER
        ========================= */

    .service-header {
        padding: 30px 35px;
        background: linear-gradient( 135deg, #2c8c99, #23727d );
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
    }


    .header-left {
        display: flex;
        align-items: center;
        gap: 15px;
    }


    .service-icon {
        width: 55px;
        height: 55px;
        background: rgba(255,255,255,.15);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
    }


    .service-header h2 {
        margin: 0;
        font-size: 25px;
        font-weight: 800;
    }


    .service-header p {
        margin: 5px 0 0;
        font-size: 13px;
        opacity: .85;
    }


    .status-box {
        text-align: right;
    }


    .status-label {
        display: block;
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: .7px;
        opacity: .75;
        margin-bottom: 6px;
    }


    .service-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 15px;
        border-radius: 25px;
        font-size: 12px;
        font-weight: 800;
    }


    /* =========================
           STATUS COLORS
        ========================= */

    .status-pending {
        background: #fff3cd;
        color: #856404;
    }


    .status-assigned {
        background: #dbeafe;
        color: #1d4ed8;
    }


    .status-accepted {
        background: #e0e7ff;
        color: #4338ca;
    }


    .status-progress {
        background: #cff4fc;
        color: #087990;
    }


    .status-completed {
        background: #d1e7dd;
        color: #146c43;
    }


    .status-cancelled,
    .status-rejected {
        background: #f8d7da;
        color: #b02a37;
    }


    .status-default {
        background: #e9ecef;
        color: #495057;
    }


    /* =========================
           SUMMARY
        ========================= */

    .summary-bar {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        border-bottom: 1px solid var(--border);
    }


    .summary-item {
        padding: 17px 20px;
        border-right: 1px solid var(--border);
    }


        .summary-item:last-child {
            border-right: none;
        }


        .summary-item span {
            display: block;
            color: var(--muted);
            font-size: 10px;
            text-transform: uppercase;
            font-weight: 700;
            margin-bottom: 5px;
        }


        .summary-item strong {
            font-size: 13px;
        }


    .payment-text.paid {
        color: #198754;
    }


    .payment-text.remaining {
        color: #d97706;
    }


    .payment-text.unpaid {
        color: #dc3545;
    }


    /* =========================
           BODY
        ========================= */

    .service-body {
        padding: 35px;
    }


    .section-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 38px;
    }


    /* =========================
           INFO CARD
        ========================= */

    .info-card {
        border: 1px solid var(--border);
        border-radius: 13px;
        padding: 22px;
    }


    .info-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding-bottom: 15px;
        margin-bottom: 10px;
        border-bottom: 1px solid var(--border);
    }


    .info-icon {
        width: 35px;
        height: 35px;
        border-radius: 8px;
        background: var(--primary-light);
        color: var(--primary);
        display: flex;
        align-items: center;
        justify-content: center;
    }


    .info-header h4 {
        margin: 0;
        color: var(--primary);
        font-size: 15px;
        font-weight: 800;
    }


    .info-row {
        display: flex;
        padding: 9px 0;
        gap: 15px;
        font-size: 13px;
    }


        .info-row span {
            width: 105px;
            flex-shrink: 0;
            color: var(--muted);
            font-weight: 600;
        }


        .info-row strong {
            flex: 1;
            word-break: break-word;
        }


    .mini-status {
        padding: 4px 9px;
        border-radius: 15px;
        font-size: 10px;
    }


    /* =========================
           SECTION TITLE
        ========================= */

    .section-title {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 15px;
    }


    .section-title-icon {
        width: 38px;
        height: 38px;
        border-radius: 9px;
        background: var(--primary-light);
        color: var(--primary);
        display: flex;
        align-items: center;
        justify-content: center;
    }


    .section-title h3 {
        margin: 0;
        font-size: 17px;
        font-weight: 800;
    }


    .section-title p {
        margin: 3px 0 0;
        color: var(--muted);
        font-size: 11px;
    }


    /* =========================
           TABLE
        ========================= */

    .table-wrapper {
        overflow-x: auto;
        border: 1px solid var(--border);
        border-radius: 11px;
        margin-bottom: 38px;
    }


    .aircon-table {
        width: 100%;
        min-width: 700px;
        border-collapse: collapse;
    }


        .aircon-table th {
            background: var(--primary);
            color: white;
            padding: 13px;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: .3px;
            text-align: left;
        }


        .aircon-table td {
            padding: 14px 13px;
            border-bottom: 1px solid var(--border);
            font-size: 12px;
        }


        .aircon-table tr:last-child td {
            border-bottom: none;
        }


    .number-badge {
        width: 26px;
        height: 26px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: var(--primary-light);
        color: var(--primary);
        font-size: 11px;
        font-weight: 800;
    }


    .condition-badge {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 20px;
        background: var(--primary-light);
        color: var(--primary);
        font-size: 10px;
        font-weight: 700;
    }


    .empty-row {
        text-align: center;
        color: var(--muted);
        padding: 25px !important;
    }


    /* =========================
           REPORT
        ========================= */

    .report-grid {
        display: grid;
