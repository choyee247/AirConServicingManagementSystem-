@model List<AirConServicingManagementSystem.ViewsModels.ServiceRequestCreateVM>
@{
    ViewData["Title"] = "My Services";
    Layout = "~/Views/Shared/_TechnicianLayout.cshtml";
}

<style>

    :root {
        --primary: #2c8c99;
        --primary-dark: #1a6b77;
        --primary-soft: rgba(44,140,153,.10);
        --text-dark: #1e293b;
        --text-light: #64748b;
    }

    /* =========================
           Base
        ========================= */
    body {
        font-size: 16px;
        background: #f8fafc;
    }

    .container {
        max-width: 100% !important;
        padding: 20px 15px !important;
    }

    /* =========================
           Header
        ========================= */
    .page-header {
        background: white;
        border-radius: 18px;
        padding: 18px 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-bottom: 20px;
        border: 1px solid rgba(44,140,153,.08);
        box-shadow: 0 5px 18px rgba(0,0,0,.05);
        flex-wrap: wrap;
    }

        .page-header h2 {
            color: var(--primary);
            font-size: 28px;
            font-weight: 700;
            margin: 0;
        }

            .page-header h2 i {
                margin-right: 10px;
            }

        .page-header p {
            margin: 5px 0 0;
            color: #6c757d;
            font-size: 14px;
        }

    .badge-count {
        background: var(--primary-soft);
        color: var(--primary);
        padding: 8px 18px;
        border-radius: 30px;
        font-weight: 600;
        white-space: nowrap;
    }

    /* =========================
           Main Card
        ========================= */
    .service-card {
        border: none !important;
        border-radius: 20px !important;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0,0,0,.06) !important;
    }

        .service-card .card-header {
            background: white;
            padding: 18px 22px;
            border-bottom: 1px solid rgba(0,0,0,.05);
        }

            .service-card .card-header h5 {
                margin: 0;
                color: var(--primary);
                font-size: 18px;
                font-weight: 700;
            }

    /* =========================
           Table
        ========================= */
    .table-responsive {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .table-custom {
        width: 100%;
        border-collapse: collapse;
        background: white;
        min-width: 600px;
    }

        .table-custom thead th {
            background: rgba(44,140,153,.08);
            color: var(--primary);
            padding: 14px 15px;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: .3px;
            white-space: nowrap;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .table-custom tbody td {
            padding: 14px 15px;
            border-bottom: 1px solid #eef2f7;
            color: var(--text-dark);
            font-size: 14px;
            vertical-align: middle;
        }

        .table-custom tbody tr {
            transition: .2s;
        }

            .table-custom tbody tr:hover {
                background: rgba(44,140,153,.05);
            }

    /* Location */
    .location-text {
        max-width: 220px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* =========================
           Status
        ========================= */
    .badge-status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 14px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    .badge-pending {
        background: #fff3cd;
        color: #856404;
    }

    .badge-progress {
        background: #cfe8ff;
        color: #075985;
    }

    .badge-completed {
        background: #d1fae5;
        color: #047857;
    }

    .badge-other {
        background: #e5e7eb;
        color: #374151;
    }

    /* =========================
           Buttons
        ========================= */
    .btn-group-actions {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    .btn-sm-custom {
        border: none;
        border-radius: 8px;
        padding: 7px 12px;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: .2s;
        white-space: nowrap;
        cursor: pointer;
    }

        .btn-sm-custom:hover {
            transform: translateY(-2px);
            text-decoration: none;
        }

    .btn-start-service {
        background: var(--primary);
        color: white;
    }

        .btn-start-service:hover {
            background: var(--primary-dark);
            color: white;
        }

    .btn-fill-ac {
        background: #22c55e;
        color: white;
    }

        .btn-fill-ac:hover {
            background: #16a34a;
            color: white;
        }

    .btn-edit-ac {
        background: #3b82f6;
        color: white;
    }

        .btn-edit-ac:hover {
            background: #2563eb;
            color: white;
        }

    .btn-another-ac {
        background: #facc15;
        color: #333;
    }

        .btn-another-ac:hover {
            background: #eab308;
            color: #333;
        }

    .btn-view-service {
        background: #64748b;
        color: white;
    }

        .btn-view-service:hover {
            background: #475569;
            color: white;
        }

    /* Payment buttons */
    .btn-payment-success {
        background: #22c55e;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 7px 12px;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: .2s;
        white-space: nowrap;
        cursor: pointer;
    }

        .btn-payment-success:hover {
            background: #16a34a;
            color: white;
            transform: translateY(-2px);
            text-decoration: none;
        }

    .btn-payment {
        background: var(--primary);
        color: white;
        border: none;
        border-radius: 8px;
        padding: 7px 12px;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: .2s;
        white-space: nowrap;
        cursor: pointer;
    }

        .btn-payment:hover {
            background: var(--primary-dark);
            color: white;
            transform: translateY(-2px);
            text-decoration: none;
        }

    /* =========================
           Empty State
        ========================= */
    .empty-state {
        text-align: center;
        padding: 50px 20px;
    }

        .empty-state i {
            font-size: 55px;
            color: var(--primary);
            opacity: .25;
        }

        .empty-state h4 {
            color: var(--primary);
            font-weight: 700;
            margin-top: 15px;
        }

    /* =========================
           Mobile Card View
        ========================= */
    .mobile-view {
        display: none;
    }

    .mobile-service-card {
        background: white;
        border-radius: 12px;
        padding: 15px;
        margin-bottom: 12px;
        border: 1px solid rgba(44,140,153,.08);
        box-shadow: 0 2px 8px rgba(0,0,0,.04);
        transition: .2s;
    }

        .mobile-service-card:last-child {
            margin-bottom: 0;
        }

        .mobile-service-card:hover {
            box-shadow: 0 4px 16px rgba(0,0,0,.08);
        }

    .mobile-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 6px 0;
        border-bottom: 1px solid #f1f5f9;
    }

        .mobile-row:last-of-type {
            border-bottom: none;
        }

    .mobile-label {
        font-size: 12px;
        color: var(--text-light);
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: .3px;
    }

    .mobile-value {
        font-size: 14px;
        color: var(--text-dark);
        text-align: right;
        word-break: break-word;
        max-width: 60%;
    }

    .mobile-actions {
        display: flex;
        gap: 6px;
        margin-top: 10px;
        flex-wrap: wrap;
        padding-top: 10px;
        border-top: 1px solid #f1f5f9;
    }

    .btn-sm-mobile {
        border: none;
        border-radius: 8px;
        padding: 8px 14px;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: .2s;
        cursor: pointer;
        flex: 1;
        justify-content: center;
        min-width: 80px;
    }

        .btn-sm-mobile:hover {
            transform: translateY(-2px);
            text-decoration: none;
        }

    /* =========================
           Responsive Breakpoints
        ========================= */

    /* Tablet */
    @@media (max-width: 992px) {
        .page-header h2 {
            font-size: 22px;
        }

        .table-custom thead th {
            padding: 12px;
            font-size: 12px;
        }

        .table-custom tbody td {
            padding: 12px;
            font-size: 13px;
        }

        .btn-sm-custom {
            font-size: 11px;
            padding: 6px 10px;
        }
    }

    /* Mobile */
    @@media (max-width: 768px) {
        .container {
            padding: 10px 8px !important;
        }

        .page-header {
            flex-direction: column;
            align-items: stretch;
            padding: 15px;
            gap: 10px;
        }

            .page-header h2 {
                font-size: 20px;
            }

            .page-header p {
                font-size: 13px;
            }

        .badge-count {
            align-self: flex-start;
            font-size: 13px;
        }

        .service-card .card-header {
            padding: 15px;
        }

            .service-card .card-header h5 {
                font-size: 16px;
            }

        .desktop-table {
            display: none !important;
        }

        .mobile-view {
            display: block !important;
            padding: 12px !important;
        }

        .btn-sm-mobile {
            font-size: 11px;
            padding: 7px 10px;
            flex: 1 1 auto;
            min-width: 70px;
        }
    }

    /* Small Mobile */
    @@media (max-width: 480px) {
        .container {
            padding: 6px 4px !important;
        }

        .page-header {
            padding: 12px;
            border-radius: 14px;
        }

            .page-header h2 {
                font-size: 18px;
            }

        .badge-count {
            font-size: 12px;
            padding: 6px 14px;
        }

        .mobile-service-card {
            padding: 12px;
        }

        .mobile-row {
            padding: 5px 0;
        }

        .mobile-value {
            font-size: 13px;
            max-width: 55%;
        }

        .mobile-actions {
            gap: 4px;
        }

        .btn-sm-mobile {
            font-size: 10px;
            padding: 6px 8px;
            min-width: 60px;
        }

        .badge-status {
            font-size: 10px;
            padding: 4px 10px;
        }
    }

    /* Touch-friendly improvements */
    @@media (hover: none) {
        .btn-sm-custom:hover,
        .btn-sm-mobile:hover,
        .btn-payment:hover,
        .btn-payment-success:hover {
            transform: none;
        }

        .table-custom tbody tr:hover {
            background: transparent;
        }

        .btn-sm-custom,
        .btn-sm-mobile,
        .btn-payment,
        .btn-payment-success {
            min-height: 44px;
        }
    }
</style>

<div class="container">

    <div class="page-header">
        <div>
            <h2>
                <i class="fas fa-tools"></i>
                My Services
            </h2>
            <p>
                Manage your assigned service requests
            </p>
        </div>
        <span class="badge-count">
            <i class="fas fa-clipboard-list me-1"></i>
            @Model.Count() Services
        </span>
    </div>

    <!-- Services Table -->
    <div class="card shadow-sm border-0 service-card">

        <div class="card-header bg-white">
            <h5>
                <i class="fas fa-list-ul me-2"></i>
                Service Request List
            </h5>
        </div>

        <!-- DESKTOP TABLE VIEW -->
        <div class="card-body p-0 desktop-table">
            <div class="table-responsive">
                <table class="table-custom">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Customer</th>
                            <th>Location</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            int counter = 1;
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@counter</strong>
                                    </td>

                                    <td>
                                        <i class="fas fa-user me-1" style="color:var(--primary);"></i>
                                        @item.ServiceRequest.Customer?.Name
                                    </td>
                                    <td>
                                        <i class="fas fa-map-marker-alt me-1" style="color:var(--primary);"></i>
                                        <span class="location-text">@item.ServiceRequest.Location</span>
                                    </td>
                                    <td>
                                        @if (item.ServiceRequest.Status == "Pending")
                                        {
                                            <span class="badge-status badge-pending">
                                                <i class="fas fa-clock me-1"></i>Pending
                                            </span>
                                        }
                                        else if (item.ServiceRequest.Status == "In Progress")
                                        {
                                            <span class="badge-status badge-progress">
                                                <i class="fas fa-spinner fa-spin me-1"></i>In Progress
                                            </span>
                                        }
                                        else if (item.ServiceRequest.Status == "Completed")
                                        {
                                            <span class="badge-status badge-completed">
                                                <i class="fas fa-check-circle me-1"></i>Completed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge-status badge-other">
                                                @item.ServiceRequest.Status
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group-actions">
                                            @if (item.ServiceRequest.Status == "Pending")
                                            {
                                                <a asp-action="Edit"
                                                   asp-route-id="@item.ServiceRequest.ServiceId"
                                                   class="btn-sm-custom btn-start-service">
                                                    <i class="fas fa-play"></i>
                                                    Start Service
                                                </a>
                                            }

                                            @if (item.ServiceRequest.Status == "In Progress")
                                            {
                                                var acCount = item.ServiceRequest.AirConUnits?.Count ?? 0;

                                                if (acCount == 0)
                                                {
                                                    <a asp-controller="AirConUnit"
                                                       asp-action="Create"
                                                       asp-route-serviceId="@item.ServiceRequest.ServiceId"
                                                       class="btn-sm-custom btn-fill-ac">
                                                        <i class="fas fa-plus-circle"></i>
                                                        Fill AC Detail
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a asp-controller="AirConUnit"
                                                       asp-action="Index"
                                                       asp-route-serviceId="@item.ServiceRequest.ServiceId"
                                                       class="btn-sm-custom btn-edit-ac">
                                                        <i class="fas fa-edit"></i>
                                                        View / Edit AC
                                                    </a>

                                                    <a asp-controller="AirConUnit"
                                                       asp-action="Create"
                                                       asp-route-serviceId="@item.ServiceRequest.ServiceId"
                                                       asp-route-isAnother="true"
                                                       class="btn-sm-custom btn-another-ac">
                                                        <i class="fas fa-plus"></i>
                                                        Another AC
                                                    </a>
                                                }
                                            }

                                            @if (item.ServiceRequest.Status == "Completed")
                                            {
                                                <a asp-controller="ServiceRequest"
                                                   asp-action="Details"
                                                   asp-route-appointmentId="@item.ServiceRequest.AppointmentId"
                                                   class="btn-sm-custom btn-view-service">
                                                    <i class="fas fa-eye"></i>
                                                    View Service
                                                </a>

                                                if (item.ServiceRequest.PaymentStatus == "Paid")
                                                {
                                                    <a asp-controller="Payment"
                                                       asp-action="Invoice"
                                                       asp-route-id="@item.ServiceRequest.ServiceRecords?.FirstOrDefault()?.Payments?.FirstOrDefault()?.PaymentId"
                                                       class="btn-payment-success">
                                                        <i class="fas fa-file-invoice"></i>
                                                        Paid
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a asp-controller="Payment"
                                                       asp-action="Create"
                                                       asp-route-serviceId="@item.ServiceRequest.ServiceId"
                                                       class="btn-payment">
                                                        <i class="fas fa-money-bill-wave"></i>
                                                        Payment
                                                    </a>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                                counter++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4">
                                    <div class="empty-state py-2">
                                        <i class="fas fa-clipboard-list"></i>
                                        <h4>No Services Found</h4>
                                        <p>You don't have any assigned services yet.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- MOBILE CARD VIEW -->
        <div class="card-body p-2 mobile-view">
            @if (Model.Any())
            {
                @foreach (var item in Model)
                {
                    <div class="mobile-service-card">

                        <!-- ID & Status -->
                        <div class="mobile-row">
                            <div>
                                <span class="mobile-label">ID</span>
                                <span class="mobile-value fw-bold" style="color:var(--primary);">
                                    #@item.ServiceRequest.ServiceId
                                </span>
                            </div>
                            <div>
                                <span class="mobile-label">Status</span>
                                @if (item.ServiceRequest.Status == "Pending")
                                {
                                    <span class="badge-status badge-pending" style="font-size:0.65rem;">
                                        <i class="fas fa-clock me-1"></i>Pending
                                    </span>
                                }
                                else if (item.ServiceRequest.Status == "In Progress")
                                {
                                    <span class="badge-status badge-progress" style="font-size:0.65rem;">
                                        <i class="fas fa-spinner fa-spin me-1"></i>In Progress
                                    </span>
                                }
                                else if (item.ServiceRequest.Status == "Completed")
                                {
                                    <span class="badge-status badge-completed" style="font-size:0.65rem;">
                                        <i class="fas fa-check-circle me-1"></i>Completed
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-status badge-other" style="font-size:0.65rem;">
                                        @item.ServiceRequest.Status
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Customer -->
                        <div class="mobile-row">
                            <span class="mobile-label">Customer</span>
                            <span class="mobile-value">
                                <i class="fas fa-user me-1" style="color:var(--primary);"></i>
                                @item.ServiceRequest.Customer?.Name
                            </span>
                        </div>

                        <!-- Location -->
                        <div class="mobile-row">
                            <span class="mobile-label">Location</span>
                            <span class="mobile-value">
                                <i class="fas fa-map-marker-alt me-1" style="color:var(--primary);"></i>
                                @item.ServiceRequest.Location
                            </span>
                        </div>

                        <!-- Actions -->
                        <div class="mobile-actions">
                            @if (item.ServiceRequest.Status == "Pending")
                            {
                                <a asp-action="Edit"
                                   asp-route-id="@item.ServiceRequest.ServiceId"
                                   class="btn-sm-mobile btn-start-service">
                                    <i class="fas fa-play"></i>
                                    Start
                                </a>
                            }

                            @if (item.ServiceRequest.Status == "In Progress")
                            {
                                var acCount = item.ServiceRequest.AirConUnits?.Count ?? 0;

                                if (acCount == 0)
                                {
                                    <a asp-controller="AirConUnit"
                                       asp-action="Create"
                                       asp-route-serviceId="@item.ServiceRequest.ServiceId"
                                       class="btn-sm-mobile btn-fill-ac">
                                        <i class="fas fa-plus-circle"></i>
                                        Fill AC
                                    </a>
                                }
                                else
                                {
                                    <a asp-controller="AirConUnit"
                                       asp-action="Index"
                                       asp-route-serviceId="@item.ServiceRequest.ServiceId"
                                       class="btn-sm-mobile btn-edit-ac">
                                        <i class="fas fa-edit"></i>
                                        View / Edit AC
                                    </a>

                                    <a asp-controller="AirConUnit"
                                       asp-action="Create"
                                       asp-route-serviceId="@item.ServiceRequest.ServiceId"
                                       asp-route-isAnother="true"
                                       class="btn-sm-mobile btn-another-ac">
                                        <i class="fas fa-plus"></i>
                                        + AC
                                    </a>
                                }
                            }

                            @if (item.ServiceRequest.Status == "Completed")
                            {
                                <a asp-controller="ServiceRequest"
                                   asp-action="Details"
                                   asp-route-appointmentId="@item.ServiceRequest.AppointmentId"
                                   class="btn-sm-mobile btn-view-service">
                                    <i class="fas fa-eye"></i>
                                    View
                                </a>

                                if (item.ServiceRequest.PaymentStatus == "Paid")
                                {
                                    <a asp-controller="Payment"
                                       asp-action="Invoice"
                                       asp-route-id="@item.ServiceRequest.ServiceRecords?.FirstOrDefault()?.Payments?.FirstOrDefault()?.PaymentId"
                                       class="btn-sm-mobile btn-payment-success">
                                        <i class="fas fa-file-invoice"></i>
                                        Paid
                                    </a>
                                }
                                else
                                {
                                    <a asp-controller="Payment"
                                       asp-action="Create"
                                       asp-route-serviceId="@item.ServiceRequest.ServiceId"
                                       class="btn-sm-mobile btn-payment">
                                        <i class="fas fa-money-bill-wave"></i>
                                        Payment
                                    </a>
                                }
                            }
                        </div>

                    </div>
                }
            }
            else
            {
                <div class="empty-state py-4">
                    <i class="fas fa-clipboard-list"></i>
                    <h4>No Services Found</h4>
                    <p>You don't have any assigned services yet.</p>
                </div>
            }
        </div>

    </div>

</div>