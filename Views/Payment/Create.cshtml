@using AirConServicingManagementSystem.ViewsModels
@model PaymentViewModel

@{
    ViewData["Title"] = "Payment";
    Layout = "~/Views/Shared/_TechnicianLayout.cshtml";
}
<!-- ========================= -->
<!-- PAYMENT AMOUNT SUMMARY -->
<!-- ========================= -->
@{
    decimal currentServiceAmount =
        ViewBag.CurrentServiceAmount ?? 0m;

    decimal previousRemainingAmount =
        ViewBag.PreviousRemainingAmount ?? 0m;

    decimal totalPayable =
        ViewBag.TotalAmount ?? 0m;

    decimal currentChargeAmount =
        ViewBag.CurrentChargeAmount ?? 0m;

    decimal currentExpenseAmount =
        ViewBag.CurrentExpenseAmount ?? 0m;

    decimal currentPartsAmount =
        ViewBag.CurrentPartsAmount ?? 0m;
}

<div class="amount-summary mb-4">

    <div class="summary-header">

        <div>
            <i class="fas fa-calculator me-2"></i>
            Payment Summary
        </div>

        <small>
            Service payment breakdown
        </small>

    </div>


    <div class="summary-body">

        <!-- CURRENT SERVICE -->

        <div class="summary-row">

            <span>
                <i class="fas fa-tools me-2"></i>
                Current Service
            </span>

            <strong>
                @currentServiceAmount.ToString("N0") MMK
            </strong>

        </div>


        <!-- CHARGES -->

        <div class="summary-subrow">

            <span>
                Additional Charges
            </span>

            <span>
                @currentChargeAmount.ToString("N0") MMK
            </span>

        </div>


        <!-- EXPENSES -->

        <div class="summary-subrow">

            <span>
                Service Expenses
            </span>

            <span>
                @currentExpenseAmount.ToString("N0") MMK
            </span>

        </div>


        <!-- PARTS -->

        <div class="summary-subrow">

            <span>
                Parts Cost
            </span>

            <span>
                @currentPartsAmount.ToString("N0") MMK
            </span>

        </div>


        @if (previousRemainingAmount > 0)
        {
            <div class="summary-row previous-row">

                <span>
                    <i class="fas fa-history me-2"></i>
                    Previous Remaining
                </span>

                <strong>
                    @previousRemainingAmount.ToString("N0") MMK
                </strong>

            </div>
        }


        <div class="summary-divider"></div>


        <!-- TOTAL -->

        <div class="summary-total">

            <span>
                Total Payable
            </span>

            <strong>
                @totalPayable.ToString("N0") MMK
            </strong>

        </div>

    </div>

</div>


<!-- Hidden Amount -->

<input type="hidden"
       asp-for="Amount"
       id="amount"
       value="@totalPayable" />

<style>

    body {
        background:#f4f7fb;
    }

    .payment-card {
        background:white;
        border-radius:18px;
        padding:25px;
        box-shadow:0 6px 20px rgba(0,0,0,.08);
    }

    .title {
        color:#2c8c99;
        font-weight:800;
        margin-bottom:20px;
    }

    label {
        font-weight:600;
        margin-bottom:6px;
    }

    .form-control,
    .form-select {
        border-radius:10px;
    }

    .section-title {
        color:#2c8c99;
        font-weight:700;
        margin-top:20px;
        margin-bottom:10px;
    }

    .amount-summary {
        border: 1px solid #e1e8eb;
        border-radius: 14px;
        overflow: hidden;
        background: #fff;
    }

    .summary-header {
        padding: 14px 18px;
        background: #f1f8f9;
        border-bottom: 1px solid #e1e8eb;
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: #2c8c99;
        font-weight: 800;
    }

        .summary-header small {
            color: #6c757d;
            font-size: 11px;
            font-weight: 500;
        }

    .summary-body {
        padding: 16px 18px;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 7px 0;
        font-size: 14px;
    }

        .summary-row span {
            color: #495057;
        }

        .summary-row strong {
            color: #263238;
        }

    .summary-subrow {
        display: flex;
        justify-content: space-between;
        padding: 4px 0 4px 28px;
        font-size: 12px;
        color: #6c757d;
    }

    .summary-divider {
        border-top: 1px dashed #d9e0e3;
        margin: 10px 0;
    }

    .previous-row {
        margin-top: 8px;
        padding: 10px 12px;
        background: #fff8e8;
        border-radius: 8px;
    }

        .previous-row span {
            color: #a16207;
        }

        .previous-row strong {
            color: #a16207;
        }

    .summary-total {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 14px;
        background: #e9f7f8;
        border-radius: 10px;
        font-size: 17px;
        font-weight: 800;
    }

        .summary-total span,
        .summary-total strong {
            color: #2c8c99;
        }
</style>

<div class="container py-4">

    <div class="payment-card">

        <!-- ========================= -->
        <!-- Header -->
        <!-- ========================= -->

        <h3 class="title mb-4">
            <i class="fas fa-money-bill-wave me-2"></i>
            Payment
        </h3>


        <form asp-action="Create"
              asp-controller="Payment"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()


            <!-- ========================= -->
            <!-- Hidden -->
            <!-- ========================= -->

            <input type="hidden"
                   asp-for="ServiceRecordId" />


            <!-- ========================= -->
            <!-- Invoice -->
            <!-- ========================= -->

            <div class="mb-3">

                <label class="form-label fw-bold">
                    Invoice No
                </label>

                <input class="form-control"
                       asp-for="InvoiceNo"
                       readonly />

            </div>

            <!-- ========================= -->
            <!-- Total Amount -->
            <!-- ========================= -->

            <div class="mb-3">

                <label class="form-label fw-bold">
                    Total Amount
                </label>

                <div class="input-group">

                    <input class="form-control fw-bold"
                           asp-for="Amount"
                           id="amount"
                           readonly />

                    <span class="input-group-text">
                        MMK
                    </span>

                </div>

            </div>


            <!-- ========================= -->
            <!-- Payment Method -->
            <!-- ========================= -->

            <div class="mb-3">

                <label class="form-label fw-bold">
                    Payment Method
                </label>

                <select class="form-select"
                        asp-for="PaymentMethod"
                        id="paymentMethod">

                    <option value="Cash">
                        Cash
                    </option>

                    <option value="KBZPay">
                        KBZPay
                    </option>

                    <option value="WavePay">
                        WavePay
                    </option>

                    <option value="AYAPay">
                        AYA Pay
                    </option>

                    <option value="CBPay">
                        CB Pay
                    </option>

                    <option value="BankTransfer">
                        Bank Transfer
                    </option>

                </select>

            </div>


            <!-- ========================= -->
            <!-- CASH SECTION -->
            <!-- ========================= -->

            <div id="cashSection">

                <div class="card border-0 bg-light mb-3">

                    <div class="card-body">

                        <h6 class="fw-bold mb-3">
                            <i class="fas fa-money-bill me-2"></i>
                            Cash Payment
                        </h6>


                        <div class="mb-3">

                            <label class="form-label">
                                Customer Paid
                            </label>

                            <div class="input-group">

                                <input class="form-control"
                                       asp-for="PaidAmount"
                                       id="paidAmount"
                                       type="number"
                                       step="0.01"
                                       min="0" />

                                <span class="input-group-text">
                                    MMK
                                </span>

                            </div>

                            <span asp-validation-for="PaidAmount"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="mb-0">

                            <label class="form-label">
                                Change Amount
                            </label>

                            <div class="input-group">

                                <input class="form-control"
                                       asp-for="ChangeAmount"
                                       id="changeAmount"
                                       readonly />

                                <span class="input-group-text">
                                    MMK
                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ========================= -->
            <!-- DIGITAL PAYMENT -->
            <!-- ========================= -->

            <div id="digitalSection">

                <div class="card border-0 bg-light mb-3">

                    <div class="card-body">

                        <h6 class="fw-bold mb-3">
                            <i class="fas fa-mobile-alt me-2"></i>
                            Digital Payment
                        </h6>


                        <div class="mb-3">

                            <label class="form-label">
                                Transaction No
                            </label>

                            <input class="form-control"
                                   asp-for="TransactionNo"
                                   placeholder="Enter transaction number" />

                        </div>


                        <div class="mb-0">

                            <label class="form-label">
                                Payment Slip
                            </label>

                            <input class="form-control"
                                   asp-for="PaymentSlip"
                                   type="file"
                                   accept="image/*,.pdf" />

                            <small class="text-muted">
                                Upload payment slip if available.
                            </small>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ========================= -->
            <!-- BANK SECTION -->
            <!-- ========================= -->

            <div id="bankSection">

                <div class="card border-0 bg-light mb-3">

                    <div class="card-body">

                        <h6 class="fw-bold mb-3">
                            <i class="fas fa-university me-2"></i>
                            Bank Information
                        </h6>


                        <div class="mb-3">

                            <label class="form-label">
                                Bank Name
                            </label>

                            <input class="form-control"
                                   asp-for="BankName"
                                   placeholder="Enter bank name" />

                        </div>


                        <div class="mb-3">

                            <label class="form-label">
                                Account Name
                            </label>

                            <input class="form-control"
                                   asp-for="AccountName"
                                   placeholder="Enter account name" />

                        </div>


                        <div class="mb-0">

                            <label class="form-label">
                                Account No
                            </label>

                            <input class="form-control"
                                   asp-for="AccountNo"
                                   placeholder="Enter account number" />

                        </div>

                    </div>

                </div>

            </div>


            <!-- ========================= -->
            <!-- REMARK -->
            <!-- ========================= -->

            <div class="mb-4">

                <label class="form-label fw-bold">
                    Remark
                </label>

                <textarea class="form-control"
                          asp-for="Remark"
                          rows="3"
                          placeholder="Enter remark if necessary"></textarea>

            </div>


            <!-- ========================= -->
            <!-- Buttons -->
            <!-- ========================= -->

            <div class="d-flex gap-2">

                <button type="submit"
                        id="confirmPaymentBtn"
                        class="btn btn-success px-4">

                    <i class="fas fa-check-circle me-1"></i>

                    Confirm Payment

                </button>


                <a asp-controller="ServiceRequest"
                   asp-action="Index"
                   class="btn btn-outline-secondary">

                    <i class="fas fa-times me-1"></i>

                    Cancel

                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        const method =
            document.getElementById("paymentMethod");

        const cash =
            document.getElementById("cashSection");

        const digital =
            document.getElementById("digitalSection");

        const bank =
            document.getElementById("bankSection");

        const amountInput =
            document.getElementById("amount");

        const paidInput =
            document.getElementById("paidAmount");

        const changeInput =
            document.getElementById("changeAmount");


        // ==========================================
        // Payment Method
        // ==========================================

        function changePaymentType()
        {
            const value = method.value;


            // Hide all
            cash.style.display = "none";
            digital.style.display = "none";
            bank.style.display = "none";


            // Cash
            if (value === "Cash")
            {
                cash.style.display = "block";
            }


            // Digital
            else if (
                value === "KBZPay" ||
                value === "WavePay" ||
                value === "AYAPay" ||
                value === "CBPay"
            )
            {
                digital.style.display = "block";
            }


            // Bank Transfer
            else if (value === "BankTransfer")
            {
                digital.style.display = "block";
                bank.style.display = "block";
            }


            // Reset Cash fields when not Cash
            if (value !== "Cash")
            {
                paidInput.value = "";
                changeInput.value = "";
            }
        }


        method.addEventListener(
            "change",
            changePaymentType
        );


        changePaymentType();


        // ==========================================
        // Cash Change Calculation
        // ==========================================

               function calculateChange()
        {
            const amount =
                parseFloat(amountInput.value) || 0;

            const paid =
                parseFloat(paidInput.value) || 0;

            if (paid <= 0)
            {
                changeInput.value = "";
                return;
            }

            const change =
                paid - amount;

            changeInput.value =
                change >= 0
                    ? change.toFixed(2)
                    : "0.00";
        }

        paidInput.addEventListener(
            "input",
            calculateChange
        );


        // ==========================================
        // Prevent Cash Underpayment
        // ==========================================

        document
            .querySelector("form")
            .addEventListener(
                "submit",
                function (e)
                {
                    if (method.value === "Cash")
                    {
                        const amount =
                            parseFloat(
                                amountInput.value
                            ) || 0;

                        const paid =
                            parseFloat(
                                paidInput.value
                            ) || 0;


                        if (paid < amount)
                        {
                            e.preventDefault();

                            alert(
                                "Customer Paid Amount cannot be less than Total Amount."
                            );

                            paidInput.focus();

                            return;
                        }
                    }
                }
            );

    </script>
}