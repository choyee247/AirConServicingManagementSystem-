@model IEnumerable<User>

@{
    ViewData["Title"] = "Technician Accounts";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    :root {
        --primary: #2c8c99;
        --primary-dark: #216f79;
        --primary-light: #4ca6b3;
        --primary-soft: rgba(44, 140, 153, 0.08);
        --primary-soft-2: rgba(44, 140, 153, 0.12);
        --primary-border: rgba(44, 140, 153, 0.18);
        --text: #24323d;
        --muted: #71808d;
        --success-bg: rgba(44, 140, 153, 0.10);
        --success-text: #216f79;
        --disabled-bg: #f1f4f5;
        --disabled-text: #6c757d;
        --card-radius: 18px;
        --font-base: 17px;
    }

    /* =====================================================
           BASE
           ===================================================== */

    body {
        font-size: var(--font-base);
    }

    .container {
        max-width: 100% !important;
        padding: 18px 16px !important;
    }


    /* =====================================================
           PAGE HEADER
           ===================================================== */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1.4rem;
    }

    .header-left h3 {
        margin: 0 0 4px;
        color: var(--primary);
        font-size: 1.7rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .header-left h3 i {
            font-size: 1.45rem;
        }

    .header-left p {
        margin: 0;
        color: var(--muted);
        font-size: 0.88rem;
    }


    /* =====================================================
           HEADER RIGHT
           ===================================================== */

    .header-right {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
    }

    .header-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 14px;
        color: var(--primary);
        background: var(--primary-soft);
        border: 1px solid var(--primary-border);
        border-radius: 50px;
        font-size: 0.78rem;
        font-weight: 700;
        white-space: nowrap;
    }


    /* =====================================================
           CREATE BUTTON
           ===================================================== */

    .btn-primary-custom {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 9px 16px;
        color: #fff;
        background: var(--primary);
        border: 1px solid var(--primary);
        border-radius: 9px;
        font-size: 0.82rem;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .btn-primary-custom:hover {
            color: #fff;
            background: var(--primary-dark);
            border-color: var(--primary-dark);
            transform: translateY(-1px);
            box-shadow: 0 5px 14px rgba(44, 140, 153, 0.20);
        }

        .btn-primary-custom:active {
            transform: translateY(0);
        }


    /* =====================================================
           TABLE CARD
           ===================================================== */

    .table-card {
        overflow: hidden;
        border: 1px solid rgba(44, 140, 153, 0.10) !important;
        border-radius: var(--card-radius) !important;
        background: #fff;
        box-shadow: 0 5px 22px rgba(44, 140, 153, 0.07) !important;
    }

        .table-card .card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 10px;
            padding: 13px 18px !important;
            background: #fff !important;
            border-bottom: 1px solid rgba(44, 140, 153, 0.08) !important;
        }

            .table-card .card-header h5 {
                display: flex;
                align-items: center;
                gap: 7px;
                margin: 0;
                color: var(--primary);
                font-size: 0.95rem;
                font-weight: 700;
            }

    .status-guide {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        color: var(--muted);
        font-size: 0.72rem;
        white-space: nowrap;
    }

        .status-guide i {
            font-size: 0.42rem;
            color: var(--primary);
        }

        .status-guide .disabled-dot {
            color: #8c979c;
        }

    .action-group {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

        .action-group form {
            margin: 0;
        }

    /* =====================================================
           TABLE
           ===================================================== */

    .table-responsive {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .table-custom {
        width: 100%;
        min-width: 650px;
        margin: 0;
        border-collapse: collapse;
        font-size: 0.87rem;
    }

        .table-custom thead th {
            padding: 11px 14px;
            color: var(--primary);
            background: var(--primary-soft);
            border-bottom: 1px solid rgba(44, 140, 153, 0.12);
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.45px;
            white-space: nowrap;
        }

        .table-custom tbody td {
            padding: 12px 14px;
            color: var(--text);
            border-bottom: 1px solid rgba(44, 140, 153, 0.06);
            vertical-align: middle;
            font-size: 0.84rem;
        }

        .table-custom tbody tr {
            transition: background 0.18s ease;
        }

            .table-custom tbody tr:hover {
                background: rgba(44, 140, 153, 0.035);
            }

            .table-custom tbody tr:last-child td {
                border-bottom: none;
            }


    /* =====================================================
           USERNAME
           ===================================================== */

    .username-cell {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        color: var(--primary-dark);
        font-size: 0.86rem;
        font-weight: 700;
    }

        .username-cell i {
            color: var(--primary);
        }


    /* =====================================================
           TECHNICIAN
           ===================================================== */

    .technician-cell {
        font-weight: 500;
    }

    .technician-name {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        color: var(--text);
        font-weight: 600;
    }

        .technician-name i {
            color: var(--primary);
        }

    .not-assigned {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        color: var(--muted);
        font-size: 0.78rem;
    }


    /* =====================================================
           ROLE
           ===================================================== */

    .role-cell {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        color: var(--muted);
        font-size: 0.82rem;
        font-weight: 600;
    }

        .role-cell i {
            color: var(--primary);
        }


    /* =====================================================
           STATUS
           ===================================================== */

    .badge-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 11px;
        border-radius: 50px;
        font-size: 0.68rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .badge-active {
        color: var(--success-text);
        background: var(--success-bg);
        border: 1px solid rgba(44, 140, 153, 0.15);
    }

        .badge-active i {
            color: var(--primary);
        }

    .badge-disabled {
        color: var(--disabled-text);
        background: var(--disabled-bg);
        border: 1px solid #e2e7e9;
    }

        .badge-disabled i {
            color: #8b969c;
        }

    .password-wrapper {
        position: relative;
    }

        .password-wrapper .form-control {
            padding-right: 45px;
        }

    .password-toggle {
        position: absolute;
        top: 50%;
        right: 10px;
        transform: translateY(-50%);
        border: none;
        background: transparent;
        color: #71808d;
        cursor: pointer;
        padding: 5px 7px;
        z-index: 2;
    }

        .password-toggle:hover {
            color: var(--primary);
        }

        .password-toggle i {
            font-size: 0.9rem;
        }

    /* =====================================================
           ACTION BUTTONS
           ===================================================== */

    .btn-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        min-width: 105px;
        height: 32px;
        padding: 0 12px;
        border-radius: 7px;
        font-size: 0.70rem;
        font-weight: 600;
        line-height: 1;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .btn-action i {
            font-size: 0.72rem;
        }

        .btn-action:active {
            transform: translateY(0);
        }


    /* =====================================================
           VIEW PROFILE
           ===================================================== */

    .btn-view {
        color: var(--primary);
        background: var(--primary-soft);
        border: 1px solid var(--primary-border);
    }

        .btn-view:hover {
            color: #fff;
            background: var(--primary);
            border-color: var(--primary);
            transform: translateY(-1px);
            box-shadow: 0 4px 10px rgba(44, 140, 153, 0.18);
            text-decoration: none;
        }


    /* =====================================================
           DISABLE
           ===================================================== */

    .btn-delete {
        color: var(--primary-dark);
        background: rgba(44, 140, 153, 0.06);
        border: 1px solid rgba(44, 140, 153, 0.20);
        cursor: pointer;
    }

        .btn-delete:hover {
            color: #fff;
            background: var(--primary);
            border-color: var(--primary);
            transform: translateY(-1px);
            box-shadow: 0 4px 10px rgba(44, 140, 153, 0.18);
        }

        .btn-delete:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none !important;
        }


        /* =====================================================
           SPINNER
           ===================================================== */

        .btn-delete .spinner {
            display: none;
            width: 11px;
            height: 11px;
            border: 2px solid rgba(255,255,255,0.35);
            border-top-color: #fff;
            border-radius: 50%;
            animation: spin 0.6s linear infinite;
        }

        .btn-delete.loading .spinner {
            display: inline-block;
        }

        .btn-delete.loading .btn-text {
            opacity: 0.75;
        }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }


    /* =====================================================
           MOBILE VIEW
           ===================================================== */

    .mobile-view {
        display: none !important;
    }

    .desktop-table {
        display: block !important;
    }

    .mobile-account-card {
        padding: 13px 12px;
        margin-bottom: 9px;
        background: #fff;
        border: 1px solid rgba(44, 140, 153, 0.08);
        border-radius: 14px;
        box-shadow: 0 2px 10px rgba(44, 140, 153, 0.05);
        transition: all 0.2s ease;
    }

        .mobile-account-card:hover {
            border-color: rgba(44, 140, 153, 0.16);
            box-shadow: 0 4px 16px rgba(44, 140, 153, 0.08);
        }

    .mobile-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        padding: 4px 0;
    }

    .mobile-label {
        min-width: 75px;
        color: #81909b;
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }

    .mobile-value {
        color: var(--text);
        font-size: 0.78rem;
        font-weight: 500;
        text-align: right;
        word-break: break-word;
    }

        .mobile-value .username {
            color: var(--primary-dark);
            font-weight: 700;
        }

    .mobile-technician {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        color: var(--text);
        font-weight: 600;
    }

        .mobile-technician i {
            color: var(--primary);
        }

    .mobile-not-assigned {
        color: var(--muted);
        font-size: 0.72rem;
    }


    /* =====================================================
           MOBILE ACTIONS
           ===================================================== */

    .mobile-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        margin-top: 8px;
        padding-top: 9px;
        border-top: 1px solid rgba(44, 140, 153, 0.07);
    }

        .mobile-actions .btn-action {
            min-width: 100px;
            height: 30px;
        }


    /* =====================================================
           EMPTY STATE
           ===================================================== */

    .empty-state {
        padding: 42px 20px;
        text-align: center;
    }

        .empty-state i {
            color: var(--primary);
            opacity: 0.18;
            font-size: 3.5rem;
        }

        .empty-state h4 {
            margin-top: 12px;
            color: var(--primary);
            font-size: 1.15rem;
            font-weight: 700;
        }

        .empty-state p {
            margin-bottom: 18px;
            color: var(--muted);
            font-size: 0.82rem;
        }


    /* =====================================================
           DARK MODE
           ===================================================== */

    [data-bs-theme="dark"] .table-card {
        background: #202b31 !important;
        border-color: rgba(76,166,179,0.18) !important;
    }

        [data-bs-theme="dark"] .table-card .card-header {
            background: #202b31 !important;
            border-color: rgba(76,166,179,0.12) !important;
        }

    [data-bs-theme="dark"] .table-custom {
        color: #e5eef1;
    }

        [data-bs-theme="dark"] .table-custom thead th {
            color: #72c1cb;
            background: rgba(44, 140, 153, 0.12);
            border-color: rgba(76,166,179,0.15);
        }

        [data-bs-theme="dark"] .table-custom tbody td {
            color: #e0e8eb;
            border-color: rgba(255,255,255,0.06);
        }

        [data-bs-theme="dark"] .table-custom tbody tr:hover {
            background: rgba(44, 140, 153, 0.08);
        }

    [data-bs-theme="dark"] .mobile-account-card {
        background: #202b31 !important;
        border-color: rgba(76,166,179,0.14);
    }

    [data-bs-theme="dark"] .mobile-value {
        color: #e0e8eb;
    }

    [data-bs-theme="dark"] .mobile-label {
        color: #8fa1aa;
    }

    [data-bs-theme="dark"] .badge-disabled {
        color: #b7c0c5;
        background: #303a40;
        border-color: #424c52;
    }

    /* ==============================
       Search Section
       ============================== */

    .search-card {
        background: #ffffff;
        border: 1px solid rgba(44, 140, 153, 0.08);
        border-radius: 18px;
        padding: 1rem 1.2rem;
        margin-bottom: 1rem;
        box-shadow: 0 3px 18px rgba(44, 140, 153, 0.05);
    }

    .search-title {
        color: var(--primary-color);
        font-size: 0.9rem;
        font-weight: 700;
        margin-bottom: 0.65rem;
        display: flex;
        align-items: center;
        gap: 0.45rem;
    }

    .search-wrapper {
        display: flex;
        align-items: center;
        gap: 0.8rem;
    }

    .search-input-wrapper {
        position: relative;
        flex: 1;
    }

    .search-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--primary-color);
        font-size: 0.85rem;
        pointer-events: none;
    }

    .search-input {
        width: 100%;
        height: 42px;
        border: 1.5px solid #d7e5e8;
        border-radius: 10px;
        padding: 0 42px 0 40px;
        font-size: 0.88rem;
        color: #1e293b;
        background: #f9fcfd;
        outline: none;
        transition: all 0.2s ease;
    }

        .search-input::placeholder {
            color: #94a3b8;
        }

        .search-input:focus {
            border-color: var(--primary-color);
            background: #ffffff;
            box-shadow: 0 0 0 3px rgba(44, 140, 153, 0.10);
        }

    .clear-search {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        width: 26px;
        height: 26px;
        border: none;
        border-radius: 50%;
        background: rgba(44, 140, 153, 0.08);
        color: var(--primary-color);
        display: none;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: 0.2s;
    }

        .clear-search:hover {
            background: var(--primary-color);
            color: #ffffff;
        }

    .search-result {
        min-width: 85px;
        text-align: center;
        padding: 0.45rem 0.8rem;
        border-radius: 30px;
        background: rgba(44, 140, 153, 0.08);
        color: var(--primary-color);
        font-size: 0.75rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .btn-reset-password {
        color: var(--primary);
        background: rgba(44, 140, 153, 0.06);
        border: 1px solid rgba(44, 140, 153, 0.20);
    }

        .btn-reset-password:hover {
            color: #fff;
            background: var(--primary);
            border-color: var(--primary);
            transform: translateY(-1px);
            box-shadow: 0 4px 10px rgba(44, 140, 153, 0.18);
        }

    /* =====================================================
           TABLET
           ===================================================== */

    @@media (max-width: 992px) {

        .container {
            padding: 14px 10px !important;
        }

        .header-left h3 {
            font-size: 1.45rem;
        }

        .header-left p {
            font-size: 0.8rem;
        }

        .table-custom {
            min-width: 620px;
        }

            .table-custom thead th {
                padding: 9px 10px;
                font-size: 0.68rem;
            }

            .table-custom tbody td {
                padding: 9px 10px;
                font-size: 0.78rem;
            }
    }


    /* =====================================================
           MOBILE
           ===================================================== */

    @@media (max-width: 768px) {

        body {
            font-size: 16px;
        }

        .container {
            padding: 10px 7px !important;
        }

        .page-header {
            align-items: flex-start;
            flex-direction: column;
            gap: 10px;
        }

        .header-left h3 {
            font-size: 1.2rem;
        }

            .header-left h3 i {
                font-size: 1.1rem;
            }

        .header-left p {
            font-size: 0.72rem;
        }

        .header-right {
            width: 100%;
            justify-content: space-between;
        }

        .header-badge {
            font-size: 0.68rem;
            padding: 6px 10px;
        }

        .btn-primary-custom {
            padding: 7px 11px;
            font-size: 0.72rem;
        }

        .table-card {
            border-radius: 15px !important;
        }

            .table-card .card-header {
                padding: 10px 12px !important;
            }

                .table-card .card-header h5 {
                    font-size: 0.82rem;
                }

        .status-guide {
            font-size: 0.62rem;
        }

        .desktop-table {
            display: none !important;
        }

        .mobile-view {
            display: block !important;
        }
    }

    @@media (max-width: 576px) {

        .search-card {
            padding: 0.75rem;
            border-radius: 14px;
        }

        .search-title {
            font-size: 0.8rem;
        }

        .search-wrapper {
            flex-direction: column;
            align-items: stretch;
            gap: 0.5rem;
        }

        .search-input {
            height: 38px;
            font-size: 0.78rem;
        }

        .search-result {
            align-self: flex-start;
            font-size: 0.65rem;
            padding: 0.3rem 0.65rem;
        }

        .btn-action,
        .btn-delete {
            height: 29px;
            min-width: auto;
            font-size: 0.65rem;
            padding: 0.2rem 0.6rem;
        }
    }

    /* =====================================================
           SMALL MOBILE
           ===================================================== */

    @@media (max-width: 480px) {

        .container {
            padding: 7px 4px !important;
        }

        .header-left h3 {
            font-size: 1rem;
        }

        .header-left p {
            font-size: 0.65rem;
        }

        .header-badge {
            font-size: 0.6rem;
        }

        .btn-primary-custom {
            font-size: 0.65rem;
            padding: 6px 9px;
        }

        .table-card .card-header {
            padding: 8px 9px !important;
        }

            .table-card .card-header h5 {
                font-size: 0.72rem;
            }

        .mobile-account-card {
            padding: 10px 9px;
            border-radius: 12px;
        }

        .mobile-label {
            min-width: 65px;
            font-size: 0.56rem;
        }

        .mobile-value {
            font-size: 0.7rem;
        }

        .badge-status {
            padding: 4px 8px;
            font-size: 0.58rem;
        }

        .mobile-actions .btn-action {
            min-width: 92px;
            height: 28px;
            padding: 0 9px;
            font-size: 0.62rem;
        }

            .mobile-actions .btn-action i {
                font-size: 0.65rem;
            }

        .empty-state {
            padding: 30px 12px;
        }

            .empty-state i {
                font-size: 2.8rem;
            }

            .empty-state h4 {
                font-size: 0.95rem;
            }

            .empty-state p {
                font-size: 0.7rem;
            }
    }

    /* ==============================
       Disable Confirmation Modal
       ============================== */

    .disable-modal {
        border: none;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 15px 50px rgba(44, 140, 153, 0.20);
    }

        .disable-modal .modal-header {
            background: rgba(44, 140, 153, 0.08);
            border-bottom: 1px solid rgba(44, 140, 153, 0.08);
            color: var(--primary-color);
            padding: 0.9rem 1.1rem;
        }

        .disable-modal .modal-title {
            font-size: 1rem;
            font-weight: 700;
        }

        .disable-modal .modal-body {
            padding: 1.5rem 1.2rem;
        }

    .disable-icon {
        width: 58px;
        height: 58px;
        margin: 0 auto;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(44, 140, 153, 0.10);
        color: var(--primary-color);
        font-size: 1.5rem;
    }

    .disable-username {
        color: var(--primary-color);
        font-size: 1rem;
    }

    .btn-modal-cancel,
    .btn-modal-disable {
        border: none;
        border-radius: 8px;
        padding: 0.45rem 1rem;
        font-size: 0.78rem;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s;
    }

    .btn-modal-cancel {
        background: #eef3f4;
        color: #52636a;
    }

        .btn-modal-cancel:hover {
            background: #dfe9eb;
        }

    .btn-modal-disable {
        background: black;
        color: red;
    }

        .btn-modal-disable:hover {
            background: var(--primary-dark);
            color: white;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(44, 140, 153, 0.25);
        }

        .btn-modal-disable:disabled {
            opacity: 0.65;
            cursor: not-allowed;
            transform: none;
        }
</style>


<div class="container py-2 py-md-4">

    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div class="page-header">

        <div class="header-left">

            <h3>
                <i class="fas fa-users-cog"></i>
                Technician Accounts
            </h3>

            <p>
                <i class="fas fa-list me-1"></i>
                Manage all technician user accounts
            </p>

        </div>


        <div class="header-right">

            <span class="header-badge">
                <i class="fas fa-user-circle"></i>
                @Model.Count() Accounts
            </span>

            <a asp-action="Create"
               class="btn-primary-custom">

                <i class="fas fa-plus-circle"></i>
                Create Account

            </a>

        </div>

    </div>

    <!-- Search Section -->
    <div class="search-card">

        <div class="search-title">
            <i class="fas fa-search"></i>
            Search Accounts
        </div>

        <div class="search-wrapper">
            <div class="search-input-wrapper">
                <i class="fas fa-search search-icon"></i>

                <input type="text"
                       id="accountSearch"
                       class="search-input"
                       placeholder="Search username, technician name or role..."
                       autocomplete="off" />

                <button type="button"
                        id="clearSearch"
                        class="clear-search"
                        title="Clear search">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <span id="searchResult"
                  class="search-result">
                @Model.Count() accounts
            </span>
        </div>

    </div>

    <!-- =====================================================
         ACCOUNT LIST CARD
         ===================================================== -->

    <div class="table-card card shadow-sm">


        <!-- Card Header -->

        <div class="card-header">

            <h5>
                <i class="fas fa-list-ul"></i>
                Account List
            </h5>

            <span class="status-guide">

                <i class="fas fa-circle"></i>
                Active

                <span style="margin-left:4px;">·</span>

                <i class="fas fa-circle disabled-dot"></i>
                Disabled

            </span>

        </div>


        <!-- =================================================
             DESKTOP TABLE
             ================================================= -->

        <div class="card-body p-0 desktop-table">

            <div class="table-responsive">

                <table class="table-custom">

                    <thead>

                        <tr>
                            <th>
                                #
                            </th>
                            <th>
                                Username
                            </th>

                            <th>
                                Technician
                            </th>

                            <th>
                                Role
                            </th>

                            <th>
                                Status
                            </th>

                            <th class="text-center">
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model.Any())
                        {
                            int i = 1;

                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@i</td>
                                    <!-- Username -->

                                    <td>

                                        <span class="username-cell">

                                            <i class="fas fa-user"></i>

                                            @item.Username

                                        </span>

                                    </td>


                                    <!-- Technician -->

                                    <td>

                                        <span class="technician-cell">

                                            @if (item.Technician?.Name != null)
                                            {

                                                <span class="technician-name">

                                                    <i class="fas fa-user-tie"></i>

                                                    @item.Technician.Name

                                                </span>

                                            }
                                            else
                                            {

                                                <span class="not-assigned">

                                                    <i class="fas fa-user-slash"></i>

                                                    Not Assigned

                                                </span>

                                            }

                                        </span>

                                    </td>


                                    <!-- Role -->

                                    <td>

                                        <span class="role-cell">

                                            <i class="fas fa-user-shield"></i>

                                            @item.Role

                                        </span>

                                    </td>


                                    <!-- Status -->

                                    <td>

                                        @if (item.IsActive == true)
                                        {

                                            <span class="badge-status badge-active">

                                                <i class="fas fa-circle"
                                                   style="font-size:0.38rem;"></i>

                                                Active

                                            </span>

                                        }
                                        else
                                        {

                                            <span class="badge-status badge-disabled">

                                                <i class="fas fa-circle"
                                                   style="font-size:0.38rem;"></i>

                                                Disabled

                                            </span>

                                        }

                                    </td>


                                    <!-- Action -->

                                    <td class="text-center">
                                        @if (item.Role?.Trim() == "Admin")
                                        {
                                            <a asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn-action btn-view">
                                                <i class="fas fa-user-circle"></i>
                                                View Profile
                                            </a>
                                        }
                                        else
                                        {
                                            <div class="action-group">
                                                <button type="button"
                                                        class="btn-action btn-reset-password"
                                                        data-id="@item.Id"
                                                        data-username="@item.Username">
                                                    <i class="fas fa-key"></i>
                                                    Reset
                                                </button>

                                                <form asp-action="Delete"
                                                      method="post"
                                                      class="delete-form d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />

                                                    <button type="submit"
                                                            class="btn-action btn-delete"
                                                            data-username="@item.Username">
                                                        <i class="fas fa-ban"></i>
                                                        Disable
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                    </td>

                                </tr>
                                i++;
                            }

                        }
                        else
                        {

                            <!-- Empty -->

                            <tr>

                                <td colspan="5">

                                    <div class="empty-state">

                                        <i class="fas fa-users-slash"></i>

                                        <h4>
                                            No Accounts Found
                                        </h4>

                                        <p>
                                            Start by creating your first technician account.
                                        </p>

                                        <a asp-action="Create"
                                           class="btn-primary-custom">

                                            <i class="fas fa-plus-circle"></i>

                                            Create Account

                                        </a>

                                    </div>

                                </td>

                            </tr>

                        }

                    </tbody>

                </table>

            </div>

        </div>


        <!-- =================================================
             MOBILE CARD VIEW
             ================================================= -->

        <div class="card-body p-2 mobile-view">

            @if (Model.Any())
            {
                int i = 1;

                foreach (var item in Model)
                {
                    <div class="mobile-account-card">

                        <div>@i</div>
                        <!-- Username -->

                        <div class="mobile-row">

                            <span class="mobile-label">
                                Username
                            </span>

                            <span class="mobile-value">

                                <span class="username">

                                    <i class="fas fa-user me-1"></i>

                                    @item.Username

                                </span>

                            </span>

                        </div>


                        <!-- Technician -->

                        <div class="mobile-row">

                            <span class="mobile-label">
                                Technician
                            </span>

                            <span class="mobile-value">

                                @if (item.Technician?.Name != null)
                                {

                                    <span class="mobile-technician">

                                        <i class="fas fa-user-tie"></i>

                                        @item.Technician.Name

                                    </span>

                                }
                                else
                                {

                                    <span class="mobile-not-assigned">

                                        <i class="fas fa-user-slash me-1"></i>

                                        Not Assigned

                                    </span>

                                }

                            </span>

                        </div>


                        <!-- Role -->

                        <div class="mobile-row">

                            <span class="mobile-label">
                                Role
                            </span>

                            <span class="mobile-value">

                                <i class="fas fa-user-shield me-1"
                                   style="color:var(--primary);"></i>

                                @item.Role

                            </span>

                        </div>


                        <!-- Status -->

                        <div class="mobile-row">

                            <span class="mobile-label">
                                Status
                            </span>

                            <span class="mobile-value">

                                @if (item.IsActive == true)
                                {

                                    <span class="badge-status badge-active">

                                        <i class="fas fa-circle"
                                           style="font-size:0.3rem;"></i>

                                        Active

                                    </span>

                                }
                                else
                                {

                                    <span class="badge-status badge-disabled">

                                        <i class="fas fa-circle"
                                           style="font-size:0.3rem;"></i>

                                        Disabled

                                    </span>

                                }

                            </span>

                        </div>


                        <!-- Action -->

                        <div class="mobile-actions">

                            @if (item.Role?.Trim() == "Admin")
                            {

                                <!-- ADMIN -->

                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn-action btn-view">

                                    <i class="fas fa-user-circle"></i>

                                    <span>
                                        View Profile
                                    </span>

                                </a>

                            }
                            else
                            {
                                <button type="button"
                                        class="btn-action btn-reset-password"
                                        data-id="@item.Id"
                                        data-username="@item.Username">

                                    <i class="fas fa-key"></i>

                                    <span>
                                        Reset Password
                                    </span>

                                </button>

                                <!-- SENIOR / JUNIOR -->

                                <form asp-action="Delete"
                                      method="post"
                                      class="delete-form">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@item.Id" />

                                    <button type="submit"
                                            class="btn-action btn-delete"
                                            data-username="@item.Username">

                                        <i class="fas fa-ban"></i>

                                        <span class="btn-text">
                                            Disable
                                        </span>

                                        <span class="spinner"></span>

                                    </button>

                                </form>

                            }

                        </div>

                    </div>
                    i++;
                }

            }
            else
            {

                <!-- Mobile Empty -->

                <div class="empty-state">

                    <i class="fas fa-users-slash"></i>

                    <h4>
                        No Accounts Found
                    </h4>

                    <p>
                        Start by creating your first technician account.
                    </p>

                    <a asp-action="Create"
                       class="btn-primary-custom">

                        <i class="fas fa-plus-circle"></i>

                        Create Account

                    </a>

                </div>

            }

        </div>

    </div>

</div>
<!-- Disable Confirmation Modal -->
<div class="modal fade"
     id="disableModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content disable-modal">

            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-ban me-2"></i>
                    Disable Account
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body text-center">

                <div class="disable-icon">
                    <i class="fas fa-user-slash"></i>
                </div>

                <h5 class="mt-3 mb-2">
                    Disable this account?
                </h5>

                <p class="text-muted mb-2">
                    Are you sure you want to disable
                </p>

                <strong id="disableUsername"
                        class="disable-username">
                </strong>

                <p class="small text-muted mt-3 mb-0">
                    This account will no longer be able to log in.
                </p>

            </div>

            <div class="modal-footer justify-content-center">

                <button type="button"
                        class="btn-modal-cancel"
                        data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>
                    Cancel
                </button>

                <button type="button"
                        id="confirmDisable"
                        class="btn-modal-disable">
                    <i class="fas fa-ban me-1"></i>
                    Disable Account
                </button>

            </div>

        </div>

    </div>
</div>

<!-- ============================================
     RESET PASSWORD MODAL
============================================ -->

<div class="modal fade"
     id="resetPasswordModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content disable-modal">

            <div class="modal-header">

                <h5 class="modal-title">

                    <i class="fas fa-key me-2"></i>

                    Reset Password

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <form asp-action="ResetPassword"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-body">

                    <input type="hidden"
                           id="resetUserId"
                           name="id" />


                    <div class="text-center mb-3">

                        <div class="disable-icon">

                            <i class="fas fa-key"></i>

                        </div>

                        <h5 class="mt-3">

                            Reset Password

                        </h5>

                        <p class="text-muted mb-1">

                            Account:

                        </p>

                        <strong id="resetUsername"
                                class="disable-username">
                        </strong>

                    </div>


                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            New Password
                        </label>

                        <div class="password-wrapper">

                            <input type="password"
                                   name="newPassword"
                                   id="newPassword"
                                   class="form-control"
                                   minlength="6"
                                   required
                                   placeholder="Enter new password" />

                            <button type="button"
                                    class="password-toggle"
                                    data-target="newPassword">

                                <i class="fas fa-eye"></i>

                            </button>

                        </div>

                    </div>


                    <div class="mb-2">

                        <label class="form-label fw-semibold">
                            Confirm Password
                        </label>

                        <div class="password-wrapper">

                            <input type="password"
                                   id="confirmPassword"
                                   class="form-control"
                                   minlength="6"
                                   required
                                   placeholder="Confirm new password" />

                            <button type="button"
                                    class="password-toggle"
                                    data-target="confirmPassword">

                                <i class="fas fa-eye"></i>

                            </button>

                        </div>

                    </div>

                    <div id="passwordError"
                         class="text-danger small"
                         style="display:none;">
                    </div>

                </div>


                <div class="modal-footer justify-content-center">

                    <button type="button"
                            class="btn-modal-cancel"
                            data-bs-dismiss="modal">

                        <i class="fas fa-times me-1"></i>

                        Cancel

                    </button>


                    <button type="submit"
                            id="resetPasswordBtn"
                            class="btn-modal-disable"
                            style="color:white;">

                        <i class="fas fa-key me-1"></i>

                        Reset Password

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<script>

    document.addEventListener("DOMContentLoaded", function () {

        // =====================================================
        // DISABLE ACCOUNT
        // =====================================================

        let selectedForm = null;

        const disableModalElement =
            document.getElementById("disableModal");

        const disableUsername =
            document.getElementById("disableUsername");

        const confirmDisable =
            document.getElementById("confirmDisable");

        let disableModal = null;

        if (disableModalElement) {
            disableModal =
                new bootstrap.Modal(disableModalElement);
        }


        // Disable Button

        document.querySelectorAll(".delete-form")
            .forEach(form => {

                form.addEventListener("submit", function (e) {

                    e.preventDefault();

                    selectedForm = this;

                    const button =
                        this.querySelector(".btn-delete");

                    const username =
                        button.getAttribute("data-username");

                    if (disableUsername) {

                        disableUsername.textContent =
                            '"' + username + '"';

                    }

                    if (confirmDisable) {

                        confirmDisable.disabled = false;

                        confirmDisable.innerHTML =
                            '<i class="fas fa-ban me-1"></i> Disable Account';

                    }

                    if (disableModal) {
                        disableModal.show();
                    }

                });

            });


        // Confirm Disable

        if (confirmDisable) {

            confirmDisable.addEventListener("click", function () {

                if (!selectedForm) {
                    return;
                }

                this.disabled = true;

                this.innerHTML =
                    '<i class="fas fa-spinner fa-spin me-1"></i> Disabling...';

                selectedForm.submit();

            });

        }



        // =====================================================
        // RESET PASSWORD
        // =====================================================

        const resetPasswordModalElement =
            document.getElementById("resetPasswordModal");

        const resetUserId =
            document.getElementById("resetUserId");

        const resetUsername =
            document.getElementById("resetUsername");

        const newPassword =
            document.getElementById("newPassword");

        const confirmPassword =
            document.getElementById("confirmPassword");

        const passwordError =
            document.getElementById("passwordError");


        let resetPasswordModal = null;


        // Check Modal

        if (resetPasswordModalElement) {

            resetPasswordModal =
                new bootstrap.Modal(
                    resetPasswordModalElement
                );

        }


        // =====================================================
        // RESET BUTTON
        // =====================================================

        document.querySelectorAll(".btn-reset-password")
            .forEach(button => {

                button.addEventListener("click", function () {

                    const id =
                        this.getAttribute("data-id");

                    const username =
                        this.getAttribute("data-username");


                    console.log(
                        "Reset Password clicked:",
                        id,
                        username
                    );


                    if (resetUserId) {

                        resetUserId.value = id;

                    }


                    if (resetUsername) {

                        resetUsername.textContent =
                            '"' + username + '"';

                    }


                    if (newPassword) {

                        newPassword.value = "";

                    }


                    if (confirmPassword) {

                        confirmPassword.value = "";

                    }


                    if (passwordError) {

                        passwordError.style.display =
                            "none";

                    }


                    // SHOW MODAL

                    if (resetPasswordModal) {

                        resetPasswordModal.show();

                    }
                    else {

                        console.error(
                            "Reset Password Modal not found!"
                        );

                    }

                });

            });

    document.querySelectorAll(".password-toggle")
        .forEach(button => {

            button.addEventListener("click", function () {

                const targetId =
                    this.getAttribute("data-target");

                const input =
                    document.getElementById(targetId);

                const icon =
                    this.querySelector("i");

                if (input.type === "password") {

                    input.type = "text";

                    icon.classList.remove("fa-eye");
                    icon.classList.add("fa-eye-slash");

                }
                else {

                    input.type = "password";

                    icon.classList.remove("fa-eye-slash");
                    icon.classList.add("fa-eye");

                }

            });

        });


        // =====================================================
        // PASSWORD VALIDATION
        // =====================================================

        const resetForm =
            document.querySelector(
                "#resetPasswordModal form"
            );


        if (resetForm) {

            resetForm.addEventListener(
                "submit",
                function (e) {

                    // Password length

                    if (newPassword.value.length < 6) {

                        e.preventDefault();

                        passwordError.textContent =
                            "Password must be at least 6 characters.";

                        passwordError.style.display =
                            "block";

                        newPassword.focus();

                        return;
                    }


                    // Password match

                    if (
                        newPassword.value !==
                        confirmPassword.value
                    ) {

                        e.preventDefault();

                        passwordError.textContent =
                            "Passwords do not match.";

                        passwordError.style.display =
                            "block";

                        confirmPassword.focus();

                        return;
                    }

                }
            );

        }



        // =====================================================
        // SEARCH
        // =====================================================

        const totalAccounts =
            @Model.Count();

        const searchInput =
            document.getElementById("accountSearch");

        const clearSearch =
            document.getElementById("clearSearch");

        const searchResult =
            document.getElementById("searchResult");


        if (searchInput) {

            searchInput.addEventListener(
                "input",
                function () {

                    const keyword =
                        this.value
                            .trim()
                            .toLowerCase();


                    let visibleCount = 0;


                    // Desktop

                    document
                        .querySelectorAll(
                            ".desktop-table tbody tr"
                        )
                        .forEach(row => {

                            if (
                                row.querySelector(
                                    ".empty-state"
                                )
                            ) {
                                return;
                            }


                            const text =
                                row.textContent
                                    .toLowerCase();


                            if (
                                text.includes(keyword)
                            ) {

                                row.style.display =
                                    "";

                                visibleCount++;

                            }
                            else {

                                row.style.display =
                                    "none";

                            }

                        });


                    // Mobile

                    document
                        .querySelectorAll(
                            ".mobile-account-card"
                        )
                        .forEach(card => {

                            const text =
                                card.textContent
                                    .toLowerCase();


                            if (
                                text.includes(keyword)
                            ) {

                                card.style.display =
                                    "";

                            }
                            else {

                                card.style.display =
                                    "none";

                            }

                        });


                    // Clear button

                    if (keyword.length > 0) {

                        if (clearSearch) {

                            clearSearch.style.display =
                                "flex";

                        }

                        searchResult.textContent =
                            visibleCount + " found";

                    }
                    else {

                        if (clearSearch) {

                            clearSearch.style.display =
                                "none";

                        }

                        searchResult.textContent =
                            totalAccounts + " accounts";

                    }

                }
            );

        }



        // =====================================================
        // CLEAR SEARCH
        // =====================================================

        if (clearSearch) {

            clearSearch.addEventListener(
                "click",
                function () {

                    searchInput.value = "";

                    searchInput.dispatchEvent(
                        new Event("input")
                    );

                    searchInput.focus();

                }
            );

        }

    });

</script>