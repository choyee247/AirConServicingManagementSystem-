@model AirConServicingManagementSystem.ViewModels.AddAirConUnitViewModel

@{
    ViewData["Title"] = "Add AirCon Units";
    Layout = "~/Views/Shared/_TechnicianLayout.cshtml";
}


<div class="container-fluid">

    <div class="form-container">


        <div class="form-header">

            <i class="fas fa-snowflake"></i>

            <h3>
                Add Air Conditioning Units
            </h3>

        </div>



        <form asp-controller="AirConUnit"
              asp-action="Create"
              method="post"
              id="airconForm">



            <input type="hidden"
                   asp-for="ServiceId" />



            <!-- Customer -->

            <div class="form-section">


                <div class="section-title">

                    <i class="fas fa-user"></i>

                    Customer Information

                </div>



                <div class="customer-box">


                    <div class="avatar">

                        @(ViewBag.CustomerName?.Substring(0, 1).ToUpper())

                    </div>


                    <div>

                        <h5>
                            @ViewBag.CustomerName
                        </h5>


                        <p>
                            <i class="fas fa-phone"></i>
                            @ViewBag.CustomerPhone
                        </p>


                    </div>


                </div>


            </div>

            <div class="alert alert-info">

                New :
                <span id="newCount">0</span>

                |

                Existing :
                <span id="existingCount">0</span>

                |

                Total :
                <span id="totalCount">0</span>

            </div>



            <!-- Aircon Container -->

            <div id="airconContainer">

                <div class="aircon-item">
                    <button class="btn btn-danger removeAircon"
                            style="display:none;">

                        <i class="fas fa-trash"></i>

                        Remove

                    </button>

                    <div class="row">



                        <div class="col-md-6">

                            <label>
                                Brand
                            </label>


                            <div class="input-group">


                                <select class="form-select brandSelect"
                                        name="Items[0].BrandId">


                                    <option value="">
                                        -- Select Brand --
                                    </option>


                                    @foreach (var brand in ViewBag.Brands)
                                    {

                                        <option value="@brand.Id">

                                            @brand.BrandName

                                        </option>

                                    }


                                </select>



                                <a asp-controller="AirConBrand"
                                   asp-action="CreateBrand"
                                   class="btn btn-success"
                                   title="Add New Brand">


                                    <i class="fas fa-plus"></i>


                                </a>


                            </div>


                        </div>





                        <div class="col-md-6">


                            <label>
                                Model
                            </label>

                            <div class="input-group">

                                <select class="form-select modelSelect"
                                        name="Items[0].ModelId">


                                    <option>

                                        -- Select Model --

                                    </option>


                                </select>
                                <a asp-controller="AirConModel"
                                   asp-action="CreateModel"
                                   class="btn btn-success"
                                   title="Add New Model">


                                    <i class="fas fa-plus"></i>


                                </a>

                            </div>
                        </div>

                    </div>






                    <div class="row mt-3">


                        <div class="col-md-4">


                            <label>
                                Quantity
                            </label>


                            <div class="input-group">


                                <button type="button"
                                        class="btn btn-outline-secondary minus">

                                    -

                                </button>


                                <input type="number"
                                       class="form-control quantity"
                                       name="Items[0].Quantity"
                                       value="1"
                                       min="1">


                                <button type="button"
                                        class="btn btn-outline-secondary plus">

                                    +

                                </button>



                            </div>


                        </div>





                        <div class="col-md-4">


                            <label>
                                Serial Number
                            </label>


                            <input class="form-control"
                                   name="Items[0].SerialNumber"
                                   placeholder="Serial Number">


                        </div>





                        <div class="col-md-4">


                            <label>
                                Capacity HP
                            </label>


                            <select class="form-select"
                                    name="Items[0].CapacityHp">


                                <option>
                                    0.5
                                </option>

                                <option>
                                    1
                                </option>

                                <option>
                                    1.5
                                </option>

                                <option>
                                    2
                                </option>

                                <option>
                                    2.5
                                </option>

                                <option>
                                    3
                                </option>


                            </select>


                        </div>



                    </div>





                    <div class="row mt-3">


                        <div class="col-md-6">


                            <label>
                                AirCon Type
                            </label>


                            <select class="form-select"
                                    name="Items[0].AirConType">


                                <option value="">
                                    -- Select --
                                </option>

                                <option>
                                    Window
                                </option>

                                <option>
                                    Wall Split
                                </option>

                                <option>
                                    Cassette
                                </option>

                                <option>
                                    Ceiling Duct
                                </option>

                                <option>
                                    Floor Standing
                                </option>


                            </select>


                        </div>





                        <div class="col-md-6">


                            <label>
                                Installation Type
                            </label>


                            <select class="form-select installType"
                                    name="Items[0].InstallationType">

                                <option>
                                    -- Select --
                                </option>
                                <option value="Existing">

                                    Existing Repair

                                </option>


                                <option value="New">

                                    New Installation

                                </option>


                            </select>


                        </div>



                    </div>






                    <div class="warranty-area mt-3"
                         style="display:none;">



                        <div class="row">


                            <div class="col-md-4">


                                <label>
                                    Installation Date
                                </label>


                                <input type="date"
                                       class="form-control"
                                       name="Items[0].InstallationDate">


                            </div>





                            <div class="col-md-4">


                                <label>
                                    Contract Start Date
                                </label>


                                <input type="date"
                                       class="form-control"
                                       name="Items[0].ContractStartDate">


                            </div>





                            <div class="col-md-4">


                                <label>
                                    Contract End Date
                                </label>


                                <input type="date"
                                       class="form-control"
                                       name="Items[0].ContractEndDate">


                            </div>


                        </div>


                    </div>





                </div>



            </div>






            <button type="button"
                    id="addAircon"
                    class="btn btn-primary mt-3">


                <i class="fas fa-plus"></i>

                Add Another AirCon


            </button>




            <hr>



            <button type="submit"
                    class="btn btn-success">


                <i class="fas fa-save"></i>

                Save All AirCon

            </button>



        </form>


    </div>

</div>
@section Styles{
    <style>
        .aircon-card {
            background: #ffffff;
            border: 1px solid #d9eeee;
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 25px;
            box-shadow: 0 5px 15px rgba(44,140,153,.12);
        }



        .card-header-custom {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #e0f7fa;
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 20px;
        }



            .card-header-custom h5 {
                margin: 0;
                color: #1a5f6b;
                font-weight: 600;
            }



        .form-section {
            background: #f8fafa;
            padding: 25px;
            border-radius: 15px;
            margin-bottom: 25px;
        }



        .customer-box {
            display: flex;
            align-items: center;
            gap: 15px;
            background: #f8f9fa;
            padding: 15px;
            border-radius: 12px;
        }



        .avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: #2c8c99;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 20px;
        }



        .warranty-area {
            background: #fff3cd;
            border-radius: 10px;
            padding: 20px;
            border: 1px solid #ffe69c;
        }



        .btn-custom {
            background: #2c8c99;
            color: white;
        }



            .btn-custom:hover {
                background: #1a5f6b;
                color: white;
            }



        label {
            font-weight: 600;
            margin-bottom: 6px;
        }



        @@media(max - width:768px)
        {
            .aircon-card

        {
            padding: 15px;
        }


        .card-header-custom {
            flex-direction: column;
            gap: 10px;
        }

        }
    </style>
}
@section Scripts {

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>


    <script>


        $(document).ready(function(){

        let index = 0;

        $("#addAircon").click(function () {

            index++;

            let html = $(".aircon-item:first").clone();

            html.attr("data-index", index);

            html.find("h5").html(`
                <i class="fas fa-snowflake"></i>
                AirCon #${index+1}
            `);

            html.find("input").val("");
            html.find("select").val("");

            html.find("[name]").each(function () {

                let name = $(this).attr("name");

                name = name.replace(/\Items\[\d+\]/g, `Items[${index}]`);

                $(this).attr("name", name);

            });

            html.find(".removeAircon").show();

            $("#airconContainer").append(html);

            refreshCount();

        });
       





        // ===============================
        // Remove AirCon
        // ===============================

                $(document).on("click",".removeAircon",function(){

            $(this).closest(".aircon-item").remove();

            refreshNumber();

            refreshCount();

        });




        // ===============================
        // Re Index Items[]
        // ===============================
        function refreshNumber(){

            $(".aircon-item").each(function(i){

                $(this).find("h5").html(
                `<i class="fas fa-snowflake"></i>
                AirCon #${i+1}`);

            });

        }


        //Count//

                function refreshCount(){

            let newCount=0;

            let oldCount=0;

            $(".aircon-item").each(function(){

                let qty=parseInt(
                $(this).find(".quantity").val())||0;

                let type=$(this)
                .find(".installType")
                .val();

                if(type=="New")

                    newCount+=qty;

                else

                    oldCount+=qty;

            });

            $("#newCount").text(newCount);

            $("#existingCount").text(oldCount);

            $("#totalCount").text(newCount+oldCount);

        }



        // ===============================
        // Quantity +
        // ===============================


        $(document).on(
        "click",
        ".plus",
        function(){


        let input=$(this)
        .closest(".input-group")
        .find(".quantity");


        input.val(
        parseInt(input.val())+1
        );


        });





        // ===============================
        // Quantity -
        // ===============================


        $(document).on(
        "click",
        ".minus",
        function(){


        let input=$(this)
        .closest(".input-group")
        .find(".quantity");


        let value=parseInt(input.val());


        if(value>1)
        {

        input.val(value-1);

        }


        });







        // ===============================
        // Installation Type
        // ===============================


        $(document).on(
        "change",
        ".installType",
        function(){



        let card=$(this)
        .closest(".aircon-item");



        if($(this).val()=="New")
        {


        card.find(".warranty-area")
        .slideDown();


        }

        else
        {


        card.find(".warranty-area")
        .slideUp();


        card.find(".warranty-area input")
        .val("");

        }


        });






        // ===============================
        // Brand Model AJAX
        // ===============================


        $(document).on(
        "change",
        ".brandSelect",
        function(){



        let brandId=$(this).val();


        let model=$(this)
        .closest(".aircon-item")
        .find(".modelSelect");



        model.html(
        "<option>Loading...</option>"
        );





        $.ajax({


        url:
        '@Url.Action("GetModelsByBrand", "AirConUnit")',


        type:"GET",


        data:{
        brandId:brandId
        },


        success:function(data){


        model.empty();


        model.append(
        '<option value="">-- Select Model --</option>'
        );



        $.each(
        data,
        function(i,item){


        model.append(

        `<option value="${item.id}">
        ${item.modelName}
        </option>`

        );


        });


        }


        });



        });





        });



    </script>

}